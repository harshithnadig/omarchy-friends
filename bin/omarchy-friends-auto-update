#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ID="community.omarchy-friends"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

json() {
  python3 - "$@" <<'PY'
import json,sys
print(json.dumps({"ok": sys.argv[1] == "1", "message": sys.argv[2], "updated": sys.argv[3] == "1"}))
PY
}

# Auto-update is intentionally conservative. It only touches a clean, stable
# checkout on main. Dev/RC branches and locally modified installs are left alone.
if [[ ! -d "$ROOT/.git" ]]; then
  json 1 "Not a git-managed install; skipped auto-update" 0
  exit 0
fi

origin="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
case "$origin" in
  *github.com/harshithnadig/omarchy-friends.git|*github.com/harshithnadig/omarchy-friends) ;;
  *) json 1 "Unknown plugin origin; skipped auto-update" 0; exit 0 ;;
esac

branch="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
if [[ "$branch" != "main" ]]; then
  json 1 "Development/RC branch detected; skipped stable auto-update" 0
  exit 0
fi

if [[ -n "$(git -C "$ROOT" status --porcelain)" ]]; then
  json 1 "Local changes detected; skipped auto-update" 0
  exit 0
fi

# Keep the fetch bounded so a bad network cannot hang the shell worker forever.
if ! timeout 20s git -C "$ROOT" fetch --quiet origin main; then
  json 1 "Update check could not reach GitHub; will retry later" 0
  exit 0
fi

head="$(git -C "$ROOT" rev-parse HEAD)"
remote="$(git -C "$ROOT" rev-parse origin/main)"
if [[ "$head" == "$remote" ]]; then
  json 1 "Friends is already current" 0
  exit 0
fi

# Only fast-forward. Never rewrite a user's checkout.
if ! git -C "$ROOT" merge-base --is-ancestor "$head" "$remote"; then
  json 1 "Local history diverged; skipped auto-update" 0
  exit 0
fi

if ! timeout 25s git -C "$ROOT" pull --ff-only --quiet origin main; then
  json 0 "Friends auto-update failed" 0
  exit 1
fi

if command -v omarchy-shell >/dev/null 2>&1; then
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
fi

json 1 "Friends updated to the latest stable version" 1
