#!/usr/bin/env python3
"""
Omarchy Friends — a small, local-first human layer for Omarchy.

The daemon only discovers peers that explicitly broadcast an opt-in presence
on the local network.  It never invents users, replies, locations, or feed
activity, and it has no hosted service dependency.
"""

import hashlib
import json
import os
import re
import select
import socket
import subprocess
import sys
import time
import uuid
from pathlib import Path


BROADCAST_PORT = 42424
PROTOCOL_VERSION = "omarchy-friends/v2"
PEER_TTL_SECONDS = 90
MAX_PACKET_BYTES = 4096
MAX_EVENTS = 48
MAX_PULSE_ITEMS = 24
MAX_INVITES = 8
MAX_SEEN_EVENT_IDS = 128
MAX_ROOM_LENGTH = 24
MAX_INCOMING_SIGNALS_PER_MINUTE = 12
MAX_SIGNAL_RECEIPTS = 96
STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    / "omarchy-friends"
)

FRIEND_CODE_RE = re.compile(r"^OMAR-[A-Z0-9]{4}-[A-Z0-9]{3}$")
ROOM_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._-]{0,23}$")

