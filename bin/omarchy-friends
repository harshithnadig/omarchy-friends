#!/usr/bin/env python3
"""
Omarchy Friends — Engine & Daemon
Manages developer presence, active tool/window detection, music detection,
LAN peer discovery over UDP broadcast, friend codes, and tactile interactions.
Zero external dependencies (pure Python 3 standard library).
"""

import os
import sys
import json
import time
import uuid
import socket
import select
import random
import hashlib
import subprocess
from pathlib import Path

BROADCAST_PORT = 42424
PROTOCOL_VERSION = "omarchy-friends/v1"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "omarchy-friends"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy-friends"

AVAILABLE_STATUSES = {
    "coding": {"id": "coding", "name": "In The Zone", "emoji": "🚀", "desc": "Writing code in deep focus"},
    "vibe": {"id": "vibe", "name": "Vibe Coding", "emoji": "🎧", "desc": "Headphones on, flow state"},
    "coffee": {"id": "coffee", "name": "Coffee Break", "emoji": "☕", "desc": "Stepped away for a warm brew"},
    "debug": {"id": "debug", "name": "Debugging Hell", "emoji": "🐛", "desc": "Tracking down an elusive bug"},
    "night": {"id": "night", "name": "Late Night Hack", "emoji": "🌙", "desc": "Burning the midnight oil"},
    "rice": {"id": "rice", "name": "Ricing Dotfiles", "emoji": "🛠️", "desc": "Polishing desktop aesthetics"},
    "idle": {"id": "idle", "name": "Away", "emoji": "💤", "desc": "AFK from desk"}
}

AVAILABLE_AVATARS = ["👾", "🦊", "🤖", "🐱", "🚀", "🧙", "🦉", "🐙", "⚡", "☕", "🎮", "🐧"]

DEFAULT_AMBIENT_PEERS = [
    {
