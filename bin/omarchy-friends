def generate_friend_code():
    h = hashlib.sha256(str(uuid.getnode()).encode() + os.urandom(8)).hexdigest().upper()
    return f"OMAR-{h[:4]}-{h[4:7]}"


def get_active_window():
    """Detect current active application and context via Hyprland IPC."""
    try:
        res = subprocess.run(
            ["hyprctl", "activewindow", "-j"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1
        )
        if res.returncode == 0 and res.stdout.strip():
            data = json.loads(res.stdout)
            wclass = data.get("class", "").lower()
            initial_class = data.get("initialClass", "").lower()
            title = data.get("title", "")

            # Common development editors and tools
            if any(k in wclass or k in initial_class for k in ["nvim", "neovim"]):
                return f"Neovim ({title})" if title and len(title) < 25 else "Neovim"
            if "zed" in wclass or "zed" in initial_class:
                return f"Zed ({title})" if title and len(title) < 25 else "Zed Editor"
            if any(k in wclass for k in ["code", "vscodium"]):
                return "VS Code"
            if "emacs" in wclass:
                return "Emacs"
            if any(k in wclass for k in ["foot", "kitty", "alacritty", "ghostty", "wezterm", "terminal"]):
                if "cargo" in title or "build" in title:
                    return "Terminal (Compiling)"
                if "test" in title:
                    return "Terminal (Running Tests)"
                return "Terminal"
            if "blender" in wclass:
                return "Blender 3D"
            if "obsidian" in wclass:
                return "Obsidian Notes"
            if any(k in wclass for k in ["firefox", "chromium", "chrome", "zen", "brave"]):
                return "Web Browser"
            if any(k in wclass for k in ["spotify", "cider"]):
                return "Music Player"

            if wclass:
                # Clean up reverse domain classes like org.omarchy.agent
                clean_name = wclass.split(".")[-1].capitalize()
                return clean_name
    except Exception:
        pass
    return "Desktop"


def get_active_music():
    """Detect playing track via busctl / MPRIS DBus."""
    try:
        res = subprocess.run(
            ["busctl", "--user", "list"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=1
        )
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if "org.mpris.MediaPlayer2." in line:
                    service = line.split()[0]
                    # Query PlaybackStatus
                    status_res = subprocess.run(
                        ["busctl", "--user", "get-property", service, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "PlaybackStatus"],
                        stdout=subprocess.PIPE,
                        stderr=subprocess.DEVNULL,
                        text=True,
                        timeout=1
                    )
                    if status_res.returncode == 0 and "Playing" in status_res.stdout:
                        # Query Metadata
                        meta_res = subprocess.run(
                            ["busctl", "--user", "get-property", service, "/org/mpris/MediaPlayer2", "org.mpris.MediaPlayer2.Player", "Metadata"],
                            stdout=subprocess.PIPE,
                            stderr=subprocess.DEVNULL,
                            text=True,
                            timeout=1
                        )
                        if meta_res.returncode == 0:
                            meta_out = meta_res.stdout
                            artist = ""
                            title = ""
                            for mline in meta_out.splitlines():
                                if "xesam:title" in mline and "s \"" in mline:
                                    title = mline.split("s \"", 1)[1].rstrip('"')
                                if "xesam:artist" in mline and "s \"" in mline:
                                    artist = mline.split("s \"", 1)[1].rstrip('"')
                            if title:
                                return f"{artist} - {title}" if artist else title
    except Exception:
        pass
    return ""


class FriendsEngine:
    def __init__(self, state_dir=None):
        self.state_dir = Path(state_dir) if state_dir else STATE_DIR
        self.state_dir.mkdir(parents=True, exist_ok=True)
        self.state_file = self.state_dir / "friends_state.json"
        self.state = self.load_state()

    def load_state(self):
        if self.state_file.exists():
            try:
                with open(self.state_file, "r") as f:
                    return json.load(f)
            except Exception:
                pass

        # Generate default fresh state
        code = generate_friend_code()
        initial_state = {
            "profile": {
                "handle": "OmarchyHacker",
                "avatar": "👾",
                "code": code,
                "status": "coding",
                "focus_started_at": int(time.time()),
                "privacy": {
                    "share_window": True,
                    "share_music": True,
                    "share_lan": True,
                    "ambient_peers": True
                }
            },
            "friends": DEFAULT_AMBIENT_PEERS.copy(),
            "lan_peers": {},
            "events": [],
            "stats": {
                "high_fives_sent": 0,
                "high_fives_received": 0,
                "coffee_breaks_shared": 0
            }
        }
        self.save_state(initial_state)
        return initial_state

    def save_state(self, state=None):
        if state is not None:
            self.state = state
        tmp_file = self.state_file.with_suffix(".tmp")
        with open(tmp_file, "w") as f:
            json.dump(self.state, f, indent=2)
        os.replace(tmp_file, self.state_file)

    def get_focus_minutes(self):
        started = self.state["profile"].get("focus_started_at", int(time.time()))
        elapsed = max(0, int(time.time()) - started)
        return elapsed // 60

    def get_public_payload(self):
        p = self.state["profile"]
        status_info = AVAILABLE_STATUSES.get(p.get("status", "coding"), AVAILABLE_STATUSES["coding"])
        
        act = get_active_window() if p.get("privacy", {}).get("share_window", True) else ""
        mus = get_active_music() if p.get("privacy", {}).get("share_music", True) else ""

        return {
            "protocol": PROTOCOL_VERSION,
            "type": "presence",
            "code": p["code"],
            "handle": p["handle"],
            "avatar": p["avatar"],
            "status": p.get("status", "coding"),
            "status_text": status_info["name"],
            "status_emoji": status_info["emoji"],
            "activity": act,
            "music": mus,
            "focus_mins": self.get_focus_minutes(),
            "timestamp": int(time.time())
        }

    def set_status(self, status_id):
        if status_id in AVAILABLE_STATUSES:
            self.state["profile"]["status"] = status_id
            self.state["profile"]["focus_started_at"] = int(time.time())
            self.save_state()
            return True
        return False

    def set_handle(self, handle):
        clean = handle.strip()[:24]
        if clean:
            self.state["profile"]["handle"] = clean
            self.save_state()
            return True
        return False

    def set_avatar(self, avatar):
        if avatar in AVAILABLE_AVATARS:
            self.state["profile"]["avatar"] = avatar
            self.save_state()
            return True
        return False

    def toggle_privacy(self, key):
        priv = self.state["profile"].setdefault("privacy", {})
        if key in priv:
            priv[key] = not priv[key]
            self.save_state()
            return priv[key]
        return None

    def add_friend(self, code, handle=None, avatar="👾"):
        code = code.strip().upper()
        if not code.startswith("OMAR-") or len(code) < 9:
            return False, "Invalid Friend Code format (expected OMAR-XXXX-XXX)"
        if code == self.state["profile"]["code"]:
            return False, "Cannot add your own Friend Code"

        for f in self.state.get("friends", []):
            if f.get("code") == code:
                return False, f"{f.get('handle', 'Friend')} is already in your friends list"

        name = handle.strip() if handle else f"Hacker_{code[-3:]}"
        new_friend = {
            "code": code,
            "handle": name,
            "avatar": avatar,
            "status": "coding",
            "status_text": "In The Zone",
            "status_emoji": "🚀",
            "activity": "Hacking",
            "music": "",
            "focus_mins": 5,
            "last_seen": int(time.time()),
            "is_ambient": False
        }
        self.state.setdefault("friends", []).append(new_friend)
        self.save_state()
        return True, f"Added {name} to friends!"

    def remove_friend(self, code):
        code = code.strip().upper()
        initial_len = len(self.state.get("friends", []))
        self.state["friends"] = [f for f in self.state.get("friends", []) if f.get("code") != code]
        if len(self.state["friends"]) < initial_len:
            self.save_state()
            return True, f"Removed {code}"
        return False, "Friend code not found"

    def interact(self, target_code, action="high-five"):
        """Perform an interaction: high-five, coffee, or kudos."""
        target_code = target_code.strip().upper()
        target_friend = None
        for f in self.state.get("friends", []):
            if f.get("code") == target_code:
                target_friend = f
                break

        # Check LAN peers as well
        if not target_friend and target_code in self.state.get("lan_peers", {}):
            target_friend = self.state["lan_peers"][target_code]

        if not target_friend:
            return False, "Target friend not found"

        friend_name = target_friend.get("handle", "Friend")
        avatar = target_friend.get("avatar", "👾")

        # Update stats
        if action == "high-five":
            self.state["stats"]["high_fives_sent"] += 1
            icon = "✋"
            action_desc = f"Sent a high-five to {friend_name}!"
            reply_desc = f"{friend_name} {avatar} bumped your fist back! 'Let's crush this build! 👊'"
        elif action == "coffee":
            self.state["stats"]["coffee_breaks_shared"] += 1
            icon = "☕"
            action_desc = f"Invited {friend_name} to a 5-min coffee break!"
            reply_desc = f"{friend_name} {avatar} accepted! 'Grabbed an espresso. Cheers! ☕'"
        elif action == "kudos":
            icon = "⚡"
            action_desc = f"Sent a spark of kudos to {friend_name}!"
            reply_desc = f"{friend_name} {avatar} caught the spark! 'Appreciate the energy! ⚡'"
        else:
            return False, f"Unknown action: {action}"

        # If ambient, add automatic delightful reply event
        if target_friend.get("is_ambient", False):
            event = {
                "id": str(uuid.uuid4())[:8],
                "action": action,
                "icon": icon,
                "from_name": friend_name,
                "from_avatar": avatar,
                "message": reply_desc,
                "timestamp": int(time.time())
            }
            self.state.setdefault("events", []).append(event)

        # Broadcast interaction over UDP if LAN sharing is enabled
        if self.state["profile"].get("privacy", {}).get("share_lan", True):
            packet = {
                "protocol": PROTOCOL_VERSION,
                "type": "interaction",
                "action": action,
                "from_code": self.state["profile"]["code"],
                "from_handle": self.state["profile"]["handle"],
                "from_avatar": self.state["profile"]["avatar"],
                "to_code": target_code,
                "timestamp": int(time.time())
            }
            self._send_udp_packet(packet)

        self.save_state()
        return True, action_desc

    def _send_udp_packet(self, packet):
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
            sock.settimeout(0.5)
            data = json.dumps(packet).encode("utf-8")
            sock.sendto(data, ("255.255.255.255", BROADCAST_PORT))
            sock.close()
        except Exception:
            pass

    def pop_events(self):
        events = self.state.get("events", [])
        self.state["events"] = []
        self.save_state()
        return events

    def cleanup_lan_peers(self):
        now = int(time.time())
        cleaned = {}
        for code, peer in self.state.get("lan_peers", {}).items():
            if now - peer.get("last_seen", 0) < 90:
                cleaned[code] = peer
        self.state["lan_peers"] = cleaned
        self.save_state()

    def get_full_status(self):
        """Assemble complete UI status model for BarWidget and Panel."""
        self.cleanup_lan_peers()
        p = self.state["profile"]
        cur_status = AVAILABLE_STATUSES.get(p.get("status", "coding"), AVAILABLE_STATUSES["coding"])

        # Live detection
        active_app = get_active_window()
        active_music = get_active_music()
        focus_mins = self.get_focus_minutes()

        # Ambient peers simulation
        ambient_enabled = p.get("privacy", {}).get("ambient_peers", True)
        all_friends = []
        for f in self.state.get("friends", []):
            if f.get("is_ambient") and not ambient_enabled:
                continue
            item = f.copy()
            item["online"] = True
            all_friends.append(item)

        lan_peers = list(self.state.get("lan_peers", {}).values())
        online_count = len(all_friends) + len(lan_peers)

        return {
            "profile": {
                "handle": p["handle"],
                "avatar": p["avatar"],
                "code": p["code"],
                "status": p.get("status", "coding"),
                "status_name": cur_status["name"],
                "status_emoji": cur_status["emoji"],
                "status_desc": cur_status["desc"],
                "activity": active_app if p.get("privacy", {}).get("share_window", True) else "Hidden",
                "music": active_music if p.get("privacy", {}).get("share_music", True) else "",
                "focus_mins": focus_mins,
                "privacy": p.get("privacy", {})
            },
            "friends": all_friends,
            "lan_peers": lan_peers,
            "online_count": online_count,
            "stats": self.state.get("stats", {}),
            "available_statuses": list(AVAILABLE_STATUSES.values()),
            "available_avatars": AVAILABLE_AVATARS
        }

    def run_daemon(self):
        """Run background LAN discovery listener and periodic broadcaster."""
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except AttributeError:
            pass
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)

        try:
            sock.bind(("", BROADCAST_PORT))
        except Exception as e:
            sys.stderr.write(f"Omarchy Friends: Could not bind UDP port {BROADCAST_PORT}: {e}\n")
            return

        sock.setblocking(False)
        last_broadcast = 0

        while True:
            now = time.time()
            # Broadcast our presence every 15 seconds if enabled
            if now - last_broadcast >= 15:
                if self.state["profile"].get("privacy", {}).get("share_lan", True):
                    payload = self.get_public_payload()
                    try:
                        data = json.dumps(payload).encode("utf-8")
                        sock.sendto(data, ("255.255.255.255", BROADCAST_PORT))
                    except Exception:
                        pass
                last_broadcast = now

            # Poll for incoming LAN packets with 1s select timeout
            r, _, _ = select.select([sock], [], [], 1.0)
            if r:
                try:
                    raw, addr = sock.recvfrom(4096)
                    packet = json.loads(raw.decode("utf-8"))
                    if packet.get("protocol") != PROTOCOL_VERSION:
                        continue

                    # Ignore self packets
                    my_code = self.state["profile"]["code"]
                    sender_code = packet.get("code") or packet.get("from_code")
                    if sender_code == my_code:
                        continue

                    ptype = packet.get("type")
                    if ptype == "presence":
                        # Record LAN peer
                        self.state.setdefault("lan_peers", {})[sender_code] = {
                            "code": sender_code,
                            "handle": packet.get("handle", "LAN Peer"),
                            "avatar": packet.get("avatar", "👾"),
                            "status": packet.get("status", "coding"),
                            "status_text": packet.get("status_text", "In The Zone"),
                            "status_emoji": packet.get("status_emoji", "🚀"),
                            "activity": packet.get("activity", ""),
                            "music": packet.get("music", ""),
                            "focus_mins": packet.get("focus_mins", 0),
                            "ip": addr[0],
                            "last_seen": int(time.time()),
                            "is_ambient": False
                        }
                        self.save_state()

                    elif ptype == "interaction":
                        # Incoming interaction addressed to us
                        if packet.get("to_code") == my_code:
                            act = packet.get("action", "high-five")
                            from_h = packet.get("from_handle", "A friend")
                            from_av = packet.get("from_avatar", "✋")
                            if act == "high-five":
                                icon = "✋"
                                msg = f"{from_h} gave you a High Five! ✋"
                                self.state["stats"]["high_fives_received"] += 1
                            elif act == "coffee":
                                icon = "☕"
                                msg = f"{from_h} invited you to a coffee break! ☕"
                                self.state["stats"]["coffee_breaks_shared"] += 1
                            else:
                                icon = "⚡"
                                msg = f"{from_h} sent you kudos! ⚡"

                            event = {
                                "id": str(uuid.uuid4())[:8],
                                "action": act,
                                "icon": icon,
                                "from_name": from_h,
                                "from_avatar": from_av,
                                "message": msg,
                                "timestamp": int(time.time())
                            }
                            self.state.setdefault("events", []).append(event)
                            self.save_state()

                            # Trigger desktop notification
                            try:
                                subprocess.run(
                                    ["omarchy-notification-send", "--app-name", "Omarchy Friends", "-i", "dialog-information", msg, "Keep up the great momentum!"],
                                    stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL
                                )
                            except Exception:
                                pass
                except Exception:
                    pass


def main():
    engine = FriendsEngine()

    if len(sys.argv) < 2 or sys.argv[1] == "status":
        print(json.dumps(engine.get_full_status()))
        return

    cmd = sys.argv[1]

    if cmd == "set-status" and len(sys.argv) >= 3:
        ok = engine.set_status(sys.argv[2])
        print(json.dumps({"ok": ok, "status": sys.argv[2]}))
    elif cmd == "set-handle" and len(sys.argv) >= 3:
        ok = engine.set_handle(" ".join(sys.argv[2:]))
        print(json.dumps({"ok": ok}))
    elif cmd == "set-avatar" and len(sys.argv) >= 3:
        ok = engine.set_avatar(sys.argv[2])
        print(json.dumps({"ok": ok}))
    elif cmd == "toggle-privacy" and len(sys.argv) >= 3:
        val = engine.toggle_privacy(sys.argv[2])
        print(json.dumps({"ok": val is not None, "value": val}))
    elif cmd == "add-friend" and len(sys.argv) >= 3:
        code = sys.argv[2]
        handle = sys.argv[3] if len(sys.argv) >= 4 else None
        ok, msg = engine.add_friend(code, handle)
        print(json.dumps({"ok": ok, "message": msg}))
    elif cmd == "remove-friend" and len(sys.argv) >= 3:
        ok, msg = engine.remove_friend(sys.argv[2])
        print(json.dumps({"ok": ok, "message": msg}))
    elif cmd == "interact" and len(sys.argv) >= 3:
        target = sys.argv[2]
        action = sys.argv[3] if len(sys.argv) >= 4 else "high-five"
        ok, msg = engine.interact(target, action)
        print(json.dumps({"ok": ok, "message": msg}))
    elif cmd == "poll-events":
        events = engine.pop_events()
        print(json.dumps({"events": events}))
    elif cmd == "daemon":
        engine.run_daemon()
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
