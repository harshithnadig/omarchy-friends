        "emoji": "☕",
        "desc": "Stepped away for a warm brew",
    },
    "debug": {
        "id": "debug",
        "name": "Debugging Hell",
        "emoji": "🐛",
        "desc": "Tracking down an elusive bug",
    },
    "night": {
        "id": "night",
        "name": "Late Night Hack",
        "emoji": "🌙",
        "desc": "Burning the midnight oil",
    },
    "rice": {
        "id": "rice",
