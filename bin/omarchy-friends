def save_state(state):
    ensure_state_dir()
    state_file = STATE_DIR / "state.json"
    temp_file = STATE_DIR / "state.json.tmp"
    with open(temp_file, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
    temp_file.replace(state_file)

def get_cooldown_remaining(state):
    last = state.get("last_launch_time", 0)
    elapsed = time.time() - last
    return max(0, int(COOLDOWN_SECONDS - elapsed))

def get_cooldown_progress(state):
    last = state.get("last_launch_time", 0)
    elapsed = time.time() - last
    if elapsed >= COOLDOWN_SECONDS:
        return 1.0
    return max(0.0, min(1.0, elapsed / COOLDOWN_SECONDS))

def format_time_ago(ts):
    now = time.time()
    diff = int(now - ts)
    if diff < 60:
        return "Just now"
    elif diff < 3600:
        return f"{diff // 60}m ago"
    elif diff < 86400:
        return f"{diff // 3600}h ago"
    else:
        return f"{diff // 86400}d ago"

def get_atmospheric_jetstream():
    """Simulate realistic troposphere jetstream data based on current hour and day of year."""
    hour = time.localtime().tm_hour
    day = time.localtime().tm_yday
    speed = int(170 + 45 * math.sin((day / 365.0) * 2 * math.pi) + 15 * math.cos((hour / 24.0) * 2 * math.pi))
    altitude = int(28000 + 4000 * math.sin((hour / 24.0) * 2 * math.pi))
    directions = ["Westerly", "North-Westerly", "South-Westerly", "Polar Express", "Subtropical Stream"]
    direction = directions[hour % len(directions)]
    return {
        "speed_kmh": speed,
        "altitude_ft": altitude,
        "direction": direction,
        "pressure_hpa": 250
    }

def estimate_planes_aloft():
    hour = time.localtime().tm_hour
    base = 32 + int(18 * math.sin((hour / 24.0) * math.pi))
    jitter = (time.localtime().tm_min % 5) - 2
    return max(24, base + jitter)

def action_status():
    state = load_state()
    hangar_id = get_or_create_hangar_id()
    cooldown = get_cooldown_remaining(state)
    cooldown_prog = get_cooldown_progress(state)
    active_fold = state.get("active_fold", "dart")
    active_seal = state.get("active_seal", "focus")
    
    fold_meta = FOLDS.get(active_fold, FOLDS["dart"])
    seal_meta = SEALS.get(active_seal, SEALS["focus"])
    jetstream = get_atmospheric_jetstream()
    
    formatted_logs = []
    for f in state.get("flight_log", []):
        formatted_logs.append({
            "flight_id": f.get("flight_id", "FL-0000"),
            "origin": f.get("origin_city", "Unknown"),
            "country": f.get("origin_country", "Skyway"),
            "flag": f.get("flag", "✨"),
            "destination": f.get("destination_city", "Local"),
            "distance_km": f.get("distance_km", 5000),
            "altitude_ft": f.get("altitude_ft", 30000),
            "speed_kmh": f.get("jetstream_speed", 200),
            "seal": f.get("seal", "focus"),
            "seal_icon": f.get("seal_icon", "🌿"),
            "status": f.get("status", "In flight"),
            "time_ago": format_time_ago(f.get("timestamp", time.time()))
        })

    out = {
        "hangar_id": hangar_id,
        "active_fold": active_fold,
        "fold_name": fold_meta["name"],
        "fold_icon": fold_meta["icon"],
        "active_seal": active_seal,
        "seal_label": seal_meta["label"],
        "seal_icon": seal_meta["icon"],
        "seal_desc": seal_meta["desc"],
        "can_launch": cooldown == 0,
        "cooldown_seconds": cooldown,
        "cooldown_progress": cooldown_prog,
        "planes_aloft": estimate_planes_aloft(),
        "jetstream": jetstream,
        "total_launched": state.get("total_planes_launched", 0),
        "total_caught": state.get("total_planes_caught", 0),
        "total_km": state.get("total_km_drifted", 0),
        "passport_stamps": list(set(state.get("passport_stamps", [])))[:12],
        "flight_log": formatted_logs[:8],
        "available_folds": [
            {"id": k, "name": v["name"], "icon": v["icon"]}
            for k, v in FOLDS.items()
        ],
        "available_seals": [
            {"id": k, "icon": v["icon"], "label": v["label"], "desc": v["desc"]}
            for k, v in SEALS.items()
        ]
    }
    print(json.dumps(out))

def action_set_fold(fold_id):
    if fold_id not in FOLDS:
        fold_id = "dart"
    state = load_state()
    state["active_fold"] = fold_id
    save_state(state)
    action_status()

def action_set_seal(seal_id):
    if seal_id not in SEALS:
        seal_id = "focus"
    state = load_state()
    state["active_seal"] = seal_id
    save_state(state)
    action_status()

def action_launch(fold_id=None, seal_id=None):
    state = load_state()
    cooldown = get_cooldown_remaining(state)
    if cooldown > 0:
        print(json.dumps({"error": "cooldown_active", "remaining_seconds": cooldown}))
        sys.exit(1)

    if fold_id and fold_id in FOLDS:
        state["active_fold"] = fold_id
    if seal_id and seal_id in SEALS:
        state["active_seal"] = seal_id

    current_fold = state.get("active_fold", "dart")
    current_seal = state.get("active_seal", "focus")
    seal_meta = SEALS.get(current_seal, SEALS["focus"])
    jetstream = get_atmospheric_jetstream()

    now = int(time.time())
    state["last_launch_time"] = now
    state["total_planes_launched"] = state.get("total_planes_launched", 0) + 1

    # Simulate reciprocal flight caught from another developer across the world
    origin_hub = secrets.choice(HUBS)
    dest_hub = secrets.choice([h for h in HUBS if h != origin_hub])
    distance = haversine_km(origin_hub["lat"], origin_hub["lon"], dest_hub["lat"], dest_hub["lon"])

    peer_seal_key = secrets.choice(list(SEALS.keys()))
    peer_seal = SEALS[peer_seal_key]
    peer_fold_key = secrets.choice(list(FOLDS.keys()))

    new_flight = {
        "flight_id": f"FL-{secrets.randbelow(9000) + 1000}",
        "origin_city": origin_hub["city"],
        "origin_country": origin_hub["country"],
        "flag": origin_hub["flag"],
        "destination_city": dest_hub["city"],
        "distance_km": distance,
        "altitude_ft": jetstream["altitude_ft"],
        "jetstream_speed": int(jetstream["speed_kmh"] * FOLDS[peer_fold_key]["speed_boost"]),
        "fold": peer_fold_key,
        "seal": peer_seal_key,
        "seal_icon": peer_seal["icon"],
        "timestamp": now,
        "status": f"Caught in {jetstream['direction']}, glided smoothly into your airspace"
    }

    logs = state.get("flight_log", [])
    logs.insert(0, new_flight)
    state["flight_log"] = logs[:50]
    state["total_planes_caught"] = state.get("total_planes_caught", 0) + 1
    state["total_km_drifted"] = state.get("total_km_drifted", 0) + distance

    stamps = state.get("passport_stamps", [])
    if origin_hub["flag"] not in stamps:
        stamps.append(origin_hub["flag"])
    state["passport_stamps"] = stamps

    save_state(state)

    # Optional desktop notification
    notif_msg = f"{new_flight['flag']} Plane from {new_flight['origin_city']} ({new_flight['distance_km']:,} km) landed softly! {new_flight['seal_icon']}"
    try:
        subprocess.run(
            ["omarchy-notification-send", "-g", "✈️", "Paper Plane Skyway", notif_msg],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2
        )
    except Exception:
        pass

    action_status()

def action_invite():
    text = (
        "Fold a paper plane and launch it into the global jetstream! ✈️\n"
        "Anonymous peer presence and kinetic skyway connections across Omarchy.\n\n"
        "Install via:\n"
        "  omarchy plugin add https://github.com/harshithnadig/omarchy-friends.git --enable\n"
        "  omarchy bar put community.omarchy-friends --section right"
    )
    try:
        proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
        proc.communicate(input=text.encode("utf-8"))
        print("Copied Paper Plane Skyway invite to clipboard!")
    except Exception:
        print(text)

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "status":
        action_status()
    elif cmd in ("fold", "set-fold"):
        fold_id = sys.argv[2] if len(sys.argv) > 2 else "dart"
        action_set_fold(fold_id)
    elif cmd in ("seal", "vibe", "set-seal"):
        seal_id = sys.argv[2] if len(sys.argv) > 2 else "focus"
        action_set_seal(seal_id)
    elif cmd in ("launch", "spark", "fly"):
        fold_id = sys.argv[2] if len(sys.argv) > 2 else None
        seal_id = sys.argv[3] if len(sys.argv) > 3 else None
        action_launch(fold_id, seal_id)
    elif cmd == "invite":
        action_invite()
    else:
        print("Usage: omarchy-friends {status|fold <id>|seal <id>|launch [fold] [seal]|invite}")
        sys.exit(1)

if __name__ == "__main__":
    main()
