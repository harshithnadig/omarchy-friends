def now_seconds():
    return int(time.time())


def trim_text(value, limit):
    return str(value or "").strip()[:limit]


def safe_int(value, default=0, minimum=None, maximum=None):
    try:
        parsed = int(value)
    except (TypeError, ValueError, OverflowError):
        parsed = default
    if minimum is not None:
        parsed = max(minimum, parsed)
    if maximum is not None:
        parsed = min(maximum, parsed)
    return parsed


def parse_plugin_version(value):
    """Parse a dotted version like 4.6.0 into a comparable tuple. Returns None when invalid."""
    parts = trim_text(value, 16).split(".")
    if len(parts) not in (2, 3):
        return None
    numbers = []
    for part in parts:
        if not part.isdigit():
            return None
        numbers.append(int(part))
    while len(numbers) < 3:
        numbers.append(0)
    if any(number > 999 for number in numbers):
        return None
    return tuple(numbers)


def normalize_code(value):
    return trim_text(value, 16).upper()


def is_valid_friend_code(value):
    return bool(FRIEND_CODE_RE.fullmatch(normalize_code(value)))


def safe_url(value):
    value = trim_text(value, 160)
    if value and not value.startswith(("https://", "http://")):
        return ""
    return value


def safe_media_url(value):
    """Keep shared attachments to links; never fetch or upload user files."""
    value = trim_text(value, MAX_MEDIA_URL_LENGTH)
    if not value or not value.startswith(("https://", "http://")):
        return ""
    if any(ord(character) < 32 for character in value):
        return ""
    return value


def media_kind(url):
    path = url.split("?", 1)[0].split("#", 1)[0].lower()
    if path.endswith((".png", ".jpg", ".jpeg", ".gif", ".webp", ".avif", ".svg")):
        return "image"
    if path.endswith((".mp4", ".webm", ".mov", ".mkv")):
        return "video"
    if path.endswith((".mp3", ".wav", ".ogg", ".m4a", ".flac")):
        return "audio"
    return "link"


def normalize_media_items(value):
    """Normalize a small list of shareable URLs for encrypted message payloads."""
    if isinstance(value, str):
        value = [{"url": value}]
    elif isinstance(value, dict):
        value = [value]
    if not isinstance(value, (list, tuple)):
        return []
    result = []
    seen = set()
    for item in value:
        if isinstance(item, str):
            url = safe_media_url(item)
            requested_kind = ""
        elif isinstance(item, dict):
            url = safe_media_url(item.get("url"))
            requested_kind = trim_text(item.get("kind"), 12).lower()
        else:
            continue
        if not url or url in seen:
            continue
        seen.add(url)
        kind = requested_kind if requested_kind in ("image", "video", "audio", "link") else media_kind(url)
        result.append({"url": url, "kind": kind})
        if len(result) >= MAX_MEDIA_ITEMS:
            break
    return result


def safe_attachment_name(value):
    name = trim_text(value, 140).replace("\\", "/").split("/")[-1]
    name = "".join(character for character in name if ord(character) >= 32 and character not in "<>:\"|?*")
    return name.strip(" .") or "attachment"


def read_regular_attachment_file(path, max_bytes):
    """Read a regular attachment without following a symlink at open time."""
    with open_regular_attachment_file(path) as file_obj:
        info = os.fstat(file_obj.fileno())
        if info.st_size > max_bytes:
            raise ValueError("Files must be 16 KiB or smaller for private relay delivery")
        content = file_obj.read(max_bytes + 1)
        if len(content) > max_bytes:
            raise ValueError("Files must be 16 KiB or smaller for private relay delivery")
        return content


def open_regular_attachment_file(path):
    """Open an attachment without following a symlink or blocking on a special file."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NONBLOCK", 0)
    descriptor = os.open(path, flags)
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise ValueError("Only regular files can be attached")
        return os.fdopen(descriptor, "rb")
    except BaseException:
        os.close(descriptor)
        raise


class PinnedPublicHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS connection pinned to a previously validated public IP address."""

    def __init__(self, host, port, address, **kwargs):
        self._pinned_address = str(ipaddress.ip_address(address))
        super().__init__(host, port, **kwargs)

    def connect(self):
        raw_socket = socket.create_connection((self._pinned_address, self.port), self.timeout, self.source_address)
        if self._tunnel_host:
            self.sock = raw_socket
            self._tunnel()
        self.sock = self._context.wrap_socket(raw_socket, server_hostname=self.host)


def _public_unicast_address(value):
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        return False
    # Reject transition/translation ranges (6to4, Teredo, NAT64 and
    # IPv4-mapped forms) rather than attempting to interpret embedded targets.
    if isinstance(address, ipaddress.IPv6Address) and (
        address.ipv4_mapped is not None
        or address.sixtofour is not None
        or address.teredo is not None
        or address in ipaddress.ip_network("64:ff9b::/96")
        or address in ipaddress.ip_network("64:ff9b:1::/48")
    ):
        return False
    return address.is_global and not address.is_multicast and not address.is_unspecified and not address.is_loopback


def _append_private_folder_to_zip(source, archive, max_source_bytes, max_archive_bytes):
    """Archive a folder through pinned directory descriptors without following links."""
    directory_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | getattr(os, "O_NOFOLLOW", 0)
    directory_flags |= getattr(os, "O_CLOEXEC", 0)
    file_flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0)
    file_flags |= getattr(os, "O_CLOEXEC", 0)
    try:
        root_fd = os.open(source, directory_flags)
    except OSError as error:
        raise ValueError("Choose a folder that still exists and is not a symbolic link") from error

    total_source_bytes = 0
    file_count = 0

    def same_snapshot(before, after):
        return (
            before.st_dev == after.st_dev
            and before.st_ino == after.st_ino
            and before.st_size == after.st_size
            and before.st_mtime_ns == after.st_mtime_ns
            and before.st_ctime_ns == after.st_ctime_ns
        )

    def visit(directory_fd, prefix=()):
        nonlocal total_source_bytes, file_count
        directory_before = os.fstat(directory_fd)
        for name in sorted(os.listdir(directory_fd)):
            try:
                before = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            except FileNotFoundError as error:
                raise ValueError("Folder contents changed while being prepared") from error
            if stat.S_ISLNK(before.st_mode):
                continue
            relative_name = "/".join((*prefix, name))
            if stat.S_ISDIR(before.st_mode):
                try:
                    child_fd = os.open(name, directory_flags, dir_fd=directory_fd)
                except OSError as error:
                    raise ValueError("Folder contents changed while being prepared") from error
                try:
                    if not same_snapshot(before, os.fstat(child_fd)):
                        raise ValueError("Folder contents changed while being prepared")
                    visit(child_fd, (*prefix, name))
                    if not same_snapshot(before, os.stat(name, dir_fd=directory_fd, follow_symlinks=False)):
                        raise ValueError("Folder contents changed while being prepared")
                finally:
                    os.close(child_fd)
                continue
            if not stat.S_ISREG(before.st_mode):
                continue

            file_count += 1
            if file_count > MAX_PRIVATE_FOLDER_FILES:
                raise ValueError(f"Folders can contain at most {MAX_PRIVATE_FOLDER_FILES} files")
            if total_source_bytes + before.st_size > max_source_bytes:
                raise ValueError("Folder contents exceed the 100 MiB safety limit")
            try:
                file_fd = os.open(name, file_flags, dir_fd=directory_fd)
            except OSError as error:
                raise ValueError("Could not read every file in that folder") from error
            try:
                opened = os.fstat(file_fd)
                if not stat.S_ISREG(opened.st_mode) or not same_snapshot(before, opened):
                    raise ValueError("Folder contents changed while being prepared")
                with os.fdopen(file_fd, "rb", closefd=False) as file_obj, archive.open(relative_name, "w") as output:
                    while chunk := file_obj.read(1024 * 1024):
                        total_source_bytes += len(chunk)
                        if total_source_bytes > max_source_bytes:
                            raise ValueError("Folder contents exceed the 100 MiB safety limit")
                        output.write(chunk)
                        if archive.fp.tell() > max_archive_bytes:
                            raise ValueError("Compressed folder exceeds its transfer size limit")
                if not same_snapshot(opened, os.fstat(file_fd)):
                    raise ValueError("Folder contents changed while being prepared")
            finally:
                os.close(file_fd)
        if not same_snapshot(directory_before, os.fstat(directory_fd)):
            raise ValueError("Folder contents changed while being prepared")

    try:
        root_info = os.fstat(root_fd)
        if not stat.S_ISDIR(root_info.st_mode):
            raise ValueError("Choose a folder that still exists")
        visit(root_fd)
    finally:
        os.close(root_fd)


def read_private_attachment(path, is_folder=False):
    """Read one small file or zipped folder for inclusion in an encrypted DM."""
    if not path:
        return None
    source = Path(os.path.abspath(os.path.expanduser(str(path))))
    if source.is_symlink():
        raise ValueError("Symbolic links cannot be attached")
    if is_folder:
        if not source.is_dir():
            raise ValueError("Choose a folder that still exists")
        buffer = io.BytesIO()
        try:
            with zipfile.ZipFile(buffer, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
                _append_private_folder_to_zip(
                    source, archive, MAX_PRIVATE_FOLDER_SOURCE_BYTES, MAX_PRIVATE_ATTACHMENT_BYTES
                )
        except OSError as error:
            raise ValueError("Could not read every file in that folder") from error
        content = buffer.getvalue()
        if len(content) > MAX_PRIVATE_ATTACHMENT_BYTES:
            raise ValueError("Compressed folder exceeds the 16 KiB encrypted attachment limit")
        name = safe_attachment_name(source.name) + ".zip"
        content_type = "application/zip"
        is_archive = True
    else:
        if not source.is_file():
            raise ValueError("Choose a file that still exists")
        try:
            content = read_regular_attachment_file(source, MAX_PRIVATE_ATTACHMENT_BYTES)
        except OSError as error:
            raise ValueError("Could not read that file") from error
        if len(content) > MAX_PRIVATE_ATTACHMENT_BYTES:
            raise ValueError("Files must be 16 KiB or smaller for private relay delivery")
        name = safe_attachment_name(source.name)
        content_type = mimetypes.guess_type(name)[0] or "application/octet-stream"
        is_archive = False
    return {
        "name": name,
        "content_type": content_type,
        "size": len(content),
        "sha256": hashlib.sha256(content).hexdigest(),
        "data": base64.b64encode(content).decode("ascii"),
        "is_archive": is_archive,
    }


def normalize_private_attachments(value):
    if not isinstance(value, list):
        return []
    result = []
    for item in value[:1]:
        if not isinstance(item, dict):
            continue
        if item.get("transport") == "blossom":
            try:
                cipher_size = int(item.get("cipher_size"))
                size = int(item.get("size"))
            except (TypeError, ValueError, OverflowError):
                continue
            url = trim_text(item.get("url"), 2048)
            parsed = urllib.parse.urlsplit(url)
            checksum = trim_text(item.get("sha256"), 64).lower()
            plain_checksum = trim_text(item.get("plain_sha256"), 64).lower()
            standard_nip17 = item.get("standard_nip17") is True
            try:
                key = base64.urlsafe_b64decode(item.get("key", "") + "===")
                nonce = base64.urlsafe_b64decode(item.get("nonce", "") + "===")
            except (TypeError, ValueError):
                continue
            if (
                parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password
                or parsed.fragment or not re.fullmatch(r"[0-9a-f]{64}", checksum)
                or (not standard_nip17 and not re.fullmatch(r"[0-9a-f]{64}", plain_checksum))
                or (standard_nip17 and plain_checksum and not re.fullmatch(r"[0-9a-f]{64}", plain_checksum))
                or len(key) != 32 or len(nonce) != 12 or cipher_size < 16
                or cipher_size > MAX_REMOTE_ATTACHMENT_BYTES + 16 or size > MAX_REMOTE_ATTACHMENT_BYTES
            ):
                continue
            result.append({
                "transport": "blossom",
                "name": safe_attachment_name(item.get("name")),
                "content_type": trim_text(item.get("content_type"), 100) or "application/octet-stream",
                "size": size,
                "cipher_size": cipher_size,
                "sha256": checksum,
                "plain_sha256": plain_checksum,
                "standard_nip17": standard_nip17,
                "url": url,
                "key": base64.urlsafe_b64encode(key).decode("ascii").rstrip("="),
                "nonce": base64.urlsafe_b64encode(nonce).decode("ascii").rstrip("="),
                "is_archive": item.get("is_archive") is True,
            })
            continue
        try:
            content = base64.b64decode(item.get("data", ""), validate=True)
        except (TypeError, ValueError):
            continue
        if len(content) > MAX_PRIVATE_ATTACHMENT_BYTES:
            continue
        checksum = trim_text(item.get("sha256"), 64).lower()
        if not re.fullmatch(r"[0-9a-f]{64}", checksum) or hashlib.sha256(content).hexdigest() != checksum:
            continue
        result.append({
            "name": safe_attachment_name(item.get("name")),
            "content_type": trim_text(item.get("content_type"), 100) or "application/octet-stream",
            "size": len(content),
            "sha256": checksum,
            "data": base64.b64encode(content).decode("ascii"),
            "is_archive": item.get("is_archive") is True,
        })
    return result


def normalize_interests(value):
    if isinstance(value, str):
        value = value.split(",")
    if not isinstance(value, (list, tuple)):
        return []
    result = []
    for item in value:
        interest_id = trim_text(item, 24).lower()
        if interest_id in INTEREST_BY_ID and interest_id not in result:
            result.append(interest_id)
    return result[:4]


def normalize_room(value):
    """Return a short, human-entered gathering name or an empty value."""
    room = " ".join(trim_text(value, MAX_ROOM_LENGTH).split())
    if room and not ROOM_NAME_RE.fullmatch(room):
        return ""
    return room


def format_age(timestamp):
    age = max(0, now_seconds() - safe_int(timestamp))
    if age < 60:
        return "now"
    if age < 3600:
        return f"{age // 60}m ago"
    if age < 86400:
        return f"{age // 3600}h ago"
    return f"{age // 86400}d ago"


def generate_friend_code():
    # The code is an identifier, not an authentication token.  It is stable
    # because it is stored locally, but a fresh install gets a new code.
    seed = f"{uuid.getnode()}:{uuid.uuid4().hex}".encode("utf-8")
    digest = hashlib.sha256(seed).hexdigest().upper()
    return f"OMAR-{digest[:4]}-{digest[4:7]}"


def generate_global_handle(public_key):
    """Make a memorable, non-identifying handle from the local public key."""
    digest = hashlib.sha256(str(public_key).encode("ascii", "ignore")).digest()
    adjective = GLOBAL_HANDLE_ADJECTIVES[digest[0] % len(GLOBAL_HANDLE_ADJECTIVES)]
    noun = GLOBAL_HANDLE_NOUNS[digest[1] % len(GLOBAL_HANDLE_NOUNS)]
    suffix = int.from_bytes(digest[2:4], "big") % 10000
    return f"{adjective}{noun}-{suffix:04d}"


def generate_global_avatar(public_key):
    digest = hashlib.sha256(str(public_key).encode("ascii", "ignore")).digest()
    return AVAILABLE_AVATARS[digest[4] % len(AVAILABLE_AVATARS)]


def is_valid_public_key(value):
    value = trim_text(value, 64).lower()
    if len(value) != 64:
        return False
    try:
        int(value, 16)
    except (TypeError, ValueError):
        return False
    return True


def derive_private_safety_code(first_public_key, second_public_key):
    """Derive a stable, order-independent fingerprint for an identity pair."""
    keys = [str(first_public_key or "").strip().lower(), str(second_public_key or "").strip().lower()]
    if any(len(key) != 64 or re.fullmatch(r"[0-9a-f]{64}", key) is None for key in keys):
        raise ValueError("A valid 64-character public key is required")
    material = b"omarchy-friends-safety-code-v1\0" + b"".join(bytes.fromhex(key) for key in sorted(keys))
    digest = hashlib.sha256(material).hexdigest()
    return " ".join(digest[index:index + 8] for index in range(0, len(digest), 8))


def run_text_command(command, timeout=1):
    try:
        result = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
        )
        if result.returncode == 0:
            return result.stdout.strip()
    except (OSError, subprocess.SubprocessError, ValueError):
        pass
    return ""


def get_current_theme():
    return run_text_command(["omarchy-theme-current"]) or ""


def get_current_wallpaper():
    return run_text_command(["omarchy-theme-bg-current"]) or ""


def get_active_window():
    """Return a coarse application label without sharing a window title."""
    raw = run_text_command(["hyprctl", "activewindow", "-j"])
    if not raw:
        return "Desktop"
    try:
        data = json.loads(raw)
    except (TypeError, ValueError):
        return "Desktop"

    wclass = trim_text(data.get("class"), 80).lower()
    initial_class = trim_text(data.get("initialClass"), 80).lower()
    title = trim_text(data.get("title"), 80).lower()
    classes = f"{wclass} {initial_class}"

    if "nvim" in classes or "neovim" in classes:
        return "Neovim"
    if "zed" in classes:
        return "Zed"
    if "vscodium" in classes or "code" in wclass:
        return "VS Code"
    if "helix" in classes:
        return "Helix"
    if "emacs" in classes:
        return "Emacs"
    if any(term in classes for term in ("foot", "kitty", "alacritty", "ghostty", "wezterm", "terminal")):
        if "cargo" in title or "build" in title:
            return "Terminal · build"
        if "test" in title:
            return "Terminal · tests"
        return "Terminal"
    if "blender" in classes:
        return "Blender"
    if "obsidian" in classes:
        return "Obsidian"
    if any(term in classes for term in ("firefox", "chromium", "chrome", "zen", "brave")):
        return "Web browser"
    if any(term in classes for term in ("spotify", "cider")):
        return "Music player"
    return trim_text(wclass.split(".")[-1].capitalize(), 32) or "Desktop"


def get_active_music():
    """Return a playing MPRIS track, if one is available."""
    services = run_text_command(["busctl", "--user", "list"])
    if not services:
        return ""
    for line in services.splitlines():
        if "org.mpris.MediaPlayer2." not in line:
            continue
        parts = line.split()
        if not parts:
            continue
        service = parts[0]
        status = run_text_command(
            [
                "busctl",
                "--user",
                "get-property",
                service,
                "/org/mpris/MediaPlayer2",
                "org.mpris.MediaPlayer2.Player",
                "PlaybackStatus",
            ]
        )
        if "Playing" not in status:
            continue
        metadata = run_text_command(
            [
                "busctl",
                "--user",
                "get-property",
                service,
                "/org/mpris/MediaPlayer2",
                "org.mpris.MediaPlayer2.Player",
                "Metadata",
            ]
        )
        artist = ""
        title = ""
        for metadata_line in metadata.splitlines():
            if "xesam:title" in metadata_line and 's "' in metadata_line:
                title = metadata_line.split('s "', 1)[1].rstrip('"')
            elif "xesam:artist" in metadata_line and 's "' in metadata_line:
                artist = metadata_line.split('s "', 1)[1].rstrip('"')
        if title:
            return trim_text(f"{artist} - {title}" if artist else title, 100)
    return ""


class FriendsEngine:
    def __init__(self, state_dir=None, load_message_journal=True):
        self.state_dir = Path(state_dir) if state_dir else STATE_DIR
        self.state_dir.mkdir(parents=True, exist_ok=True)
        os.chmod(self.state_dir, 0o700)
        self.key_store = "secret-service" if self.state_dir.resolve() == STATE_DIR.resolve() else "file"
        self._secret_service_migration_attempted = False
        self.state_file = self.state_dir / "friends_state.json"
        self.state_key_file = self.state_dir / "friends_state.key"
        self.message_journal_file = self.state_dir / "friends_messages.db"
        self.load_message_journal = bool(load_message_journal)
        self._journal_versions = {}
        self._journal_cache = None
        self._journal_signature = None
        self._persisted_state = None
        self._status_cache = None
        self._status_cache_signature = None
        self.last_sent_message_id = ""
        self.state = self.load_state()

    @staticmethod
    def _empty_global_focus():
        return {
            "status": "idle",
            "session_id": "",
            "buddy_public_key": "",
            "buddy_name": "",
            "buddy_avatar": "",
            "started_at": 0,
            "ends_at": 0,
            "total_seconds": 0,
        }

    @staticmethod
    def _quickshell_process_identity(pid, proc_root=Path("/proc")):
        """Return a Quickshell process start identity, or None for other parents."""
        try:
            process_dir = Path(proc_root) / str(int(pid))
            command = process_dir.joinpath("cmdline").read_bytes().replace(b"\0", b" ").lower()
            stat_line = process_dir.joinpath("stat").read_text(encoding="ascii")
            close = stat_line.rfind(")")
            fields = stat_line[close + 1 :].split() if close >= 0 else []
            # /proc/<pid>/stat starts after comm at field 3 (state). Field 22
            # is the process start time, at index 19 in this suffix.
            if b"quickshell" not in command or len(fields) <= 19:
                return None
            return fields[19]
        except (OSError, UnicodeError, ValueError, IndexError):
            return None

    @classmethod
    def _quickshell_parent_snapshot(cls, proc_root=Path("/proc")):
        pid = os.getppid()
        start_time = cls._quickshell_process_identity(pid, proc_root)
        return (pid, start_time) if start_time is not None else None

    @classmethod
    def _quickshell_parent_alive(cls, snapshot, proc_root=Path("/proc")):
        if snapshot is None:
            return True
        pid, start_time = snapshot
        if os.getppid() != pid:
            return False
        return cls._quickshell_process_identity(pid, proc_root) == start_time

    def _default_state(self, global_identity=None):
        global_identity = global_identity or generate_keypair()
        return {
            "profile": {
                "handle": generate_global_handle(global_identity["public_key"]),
                "avatar": generate_global_avatar(global_identity["public_key"]),
                "code": generate_friend_code(),
                "status": "coding",
                "focus_started_at": now_seconds(),
                "project_name": "",
                "project_desc": "",
                "project_url": "",
                "interests": [],
                "room": "",
                "privacy": dict(PRIVACY_DEFAULTS),
            },
            "matched_peer": None,
            "friends": [],
            "lan_peers": {},
            "global_identity": global_identity,
            "global": {
                "peers": {},
                "pings": [],
                "blocked_pubkeys": [],
                "incoming_receipts": [],
                "friendships": {},
                "messages": [],
                "read_cursors": {},
                "private_history_cursors": {},
                "pinned_conversations": [],
                "muted_conversations": [],
                "blossom_server": "",
                "groups": {},
                "community": [],
                "sent_pings": [],
                "processed_event_ids": [],
                "handled_friend_requests": [],
                "nip17_seen_rumors": {},
                "memory": {},
                "last_sync": 0,
                "last_publish": 0,
                "dm_relay_list_last_publish": 0,
                "last_error": "",
                "relays": {},
            },
            "world_pulse": [],
            "cowork": {
                "active": False,
                "mode": "",
                "invite_id": "",
                "buddy_code": "",
                "buddy_name": "",
                "buddy_avatar": "",
                "started_at": 0,
                "ends_at": 0,
                "total_seconds": 0,
            },
            "cowork_invites": [],
            "global_focus": self._empty_global_focus(),
            "invite_nudge": False,
            "invite_nudge_dismissed": False,
            "events": [],
            "seen_event_ids": [],
            "signal_receipts": [],
            "stats": {
                "hackers_met": 0,
                "friends_made": 0,
                "cowork_completed": 0,
                "high_fives_sent": 0,
                "high_fives_received": 0,
                "rices_shared": 0,
                "signals_received": 0,
            },
        }

    def load_state(self):
        lock_file = self.state_dir / ".friends_state.lock"
        with lock_file.open("a", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            try:
                existed = self.state_file.exists()
                data = None
                corrupt = False
                needs_encryption = False
                if existed:
                    try:
                        with self.state_file.open("rb") as state_file:
                            needs_encryption = not state_file.read(len(STATE_FILE_MAGIC)).startswith(STATE_FILE_MAGIC)
                        data = self._read_state_file()
                    except RuntimeError:
                        # An encrypted state/key authentication error is a hard
                        # stop. Never replace the only copy of private history.
                        raise
                    except (json.JSONDecodeError, UnicodeDecodeError, TypeError):
                        corrupt = True
                    except OSError as error:
                        raise RuntimeError(f"Cannot read Friends state; refusing to replace it: {error}") from error

                    if not corrupt and (not isinstance(data, dict) or not data):
                        corrupt = True
                    if not corrupt:
                        expected = {"profile", "friends", "global", "global_identity"}
                        if not expected.intersection(data):
                            corrupt = True
                        elif "profile" in data and not isinstance(data["profile"], dict):
                            corrupt = True
                        elif "friends" in data and not isinstance(data["friends"], list):
                            corrupt = True
                        elif "global" in data and not isinstance(data["global"], dict):
                            corrupt = True
                        elif "global_identity" in data:
                            identity = data["global_identity"]
                            try:
                                generated = generate_keypair(identity.get("secret_key"))
                                corrupt = (
                                    not isinstance(identity, dict)
                                    or generated["public_key"] != trim_text(identity.get("public_key"), 64).lower()
                                )
                            except (AttributeError, TypeError, ValueError, OverflowError):
                                corrupt = True
                        global_data = data.get("global") if isinstance(data.get("global"), dict) else {}
                        for name in ("peers", "friendships", "groups", "memory", "relays", "nip17_seen_rumors"):
                            if name in global_data and not isinstance(global_data[name], dict):
                                corrupt = True
                        for name in (
                            "pings", "blocked_pubkeys", "incoming_receipts", "messages", "pinned_conversations", "muted_conversations",
                            "community", "sent_pings", "processed_event_ids",
                        ):
                            if name in global_data and not isinstance(global_data[name], list):
                                corrupt = True
                    if not corrupt:
                        try:
                            state = self._migrate_state(data)
                        except (AttributeError, KeyError, TypeError, ValueError):
                            corrupt = True

                    if corrupt:
                        quarantine = self.state_dir / (
                            f"friends_state.corrupt-{int(time.time())}-{uuid.uuid4().hex[:8]}.json"
                        )
                        try:
                            os.replace(self.state_file, quarantine)
                            os.chmod(quarantine, 0o600)
                        except OSError as error:
                            raise RuntimeError(
                                f"Friends state is invalid and could not be preserved; refusing to replace it: {error}"
                            ) from error
                        data = None

                if data is None:
                    state = self._default_state()
                    if self.load_message_journal and self.message_journal_file.exists():
                        state = self._hydrate_message_journal(state)
                if self.load_message_journal and (not existed or corrupt or needs_encryption or state != data):
                    self._write_state_locked(state)
                self.state = state
                self._persisted_state = copy.deepcopy(state)
                return state
            finally:
                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)

    def _secret_service_key_id(self):
        return hashlib.sha256(str(self.state_dir.resolve()).encode("utf-8")).hexdigest()

    def _secret_service_lookup_key(self):
        try:
            result = subprocess.run(
                ["secret-tool", "lookup", "application", "community.omarchy-friends", "key-id", self._secret_service_key_id()],
                capture_output=True,
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return None
        if result.returncode != 0:
            return None
        try:
            encoded = result.stdout.decode("ascii").strip()
            key = bytes.fromhex(encoded)
        except (UnicodeDecodeError, ValueError):
            return None
        return key if len(key) == STATE_KEY_BYTES else None

    def _secret_service_store_key(self, key):
        try:
            result = subprocess.run(
                [
                    "secret-tool", "store", "--label=Omarchy Friends state encryption key",
                    "application", "community.omarchy-friends", "key-id", self._secret_service_key_id(),
                ],
                input=key.hex().encode("ascii") + b"\n",
                capture_output=True,
                timeout=10,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False
        return result.returncode == 0

    def _mark_secret_service_key(self):
        tmp_file = self.state_dir / f".friends_state.key.{os.getpid()}.{uuid.uuid4().hex}.tmp"
        fd = os.open(tmp_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        try:
            with os.fdopen(fd, "wb") as output:
                output.write(STATE_KEY_SECRET_SERVICE_MARKER)
                output.flush()
                os.fsync(output.fileno())
            os.replace(tmp_file, self.state_key_file)
            directory_fd = os.open(self.state_dir, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        except Exception:
            try:
                tmp_file.unlink()
            except OSError:
                pass
            raise

    def _try_secret_service_migration(self, key):
        if self._secret_service_migration_attempted:
            return False
        self._secret_service_migration_attempted = True
        if not self._secret_service_store_key(key) or self._secret_service_lookup_key() != key:
            return False
        try:
            self._mark_secret_service_key()
        except OSError:
            return False
        return True

    def _get_state_key(self, create=False):
        try:
            key = self.state_key_file.read_bytes()
        except FileNotFoundError:
            if not create:
                raise RuntimeError("Encrypted Friends history key is missing; state was preserved")
            key = secrets.token_bytes(STATE_KEY_BYTES)
            if self.key_store == "secret-service" and self._try_secret_service_migration(key):
                return key
            flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
            fd = os.open(self.state_key_file, flags, 0o600)
            try:
                with os.fdopen(fd, "wb") as output:
                    output.write(key)
                    output.flush()
                    os.fsync(output.fileno())
            except Exception:
                try:
                    self.state_key_file.unlink()
                except OSError:
                    pass
                raise
        if key == STATE_KEY_SECRET_SERVICE_MARKER:
            secret_key = self._secret_service_lookup_key()
            if secret_key is None:
                raise RuntimeError("Friends history key is unavailable from Secret Service; encrypted state was preserved")
            return secret_key
        if len(key) != STATE_KEY_BYTES:
            raise RuntimeError("Encrypted Friends history key is invalid; state was preserved")
        os.chmod(self.state_key_file, 0o600)
        if self.key_store == "secret-service":
            self._try_secret_service_migration(key)
        return key

    def _read_state_file(self):
        raw = self.state_file.read_bytes()
        if not raw.startswith(STATE_FILE_MAGIC):
            data = json.loads(raw.decode("utf-8"))
            return self._hydrate_message_journal(data) if self.load_message_journal else data
        try:
            from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        except ImportError as error:
            raise RuntimeError("Install python-cryptography to unlock encrypted Friends history") from error
        nonce_start = len(STATE_FILE_MAGIC)
        nonce = raw[nonce_start:nonce_start + 12]
        ciphertext = raw[nonce_start + 12:]
        if len(nonce) != 12 or len(ciphertext) < 16:
            raise RuntimeError("Encrypted Friends history is incomplete; state was preserved")
        try:
            plaintext = AESGCM(self._get_state_key()).decrypt(nonce, ciphertext, STATE_FILE_MAGIC)
            data = json.loads(plaintext.decode("utf-8"))
            return self._hydrate_message_journal(data) if self.load_message_journal else data
        except Exception as error:
            raise RuntimeError("Could not authenticate encrypted Friends history; state was preserved") from error

    def _hydrate_message_journal(self, data):
        if not isinstance(data, dict) or not self.message_journal_file.exists():
            return data
        hidden_ids = set(
            (data.get("global") or {}).get("locally_hidden_message_ids", [])
            if isinstance(data.get("global"), dict) else []
        )
        stat = self.message_journal_file.stat()
        signature = (stat.st_ino, stat.st_size, stat.st_mtime_ns)
        if self._journal_cache is not None and signature == self._journal_signature:
            data.setdefault("global", {})["messages"] = copy.deepcopy([
                message for message in self._journal_cache if message.get("id") not in hidden_ids
            ])
            return data
        try:
            from cryptography.hazmat.primitives.ciphers.aead import AESGCM
            key = self._get_state_key()
            messages = [
                message for message in (data.get("global") or {}).get("messages", [])
                if isinstance(message, dict) and message.get("id") not in hidden_ids
            ]
            with closing(sqlite3.connect(self.message_journal_file)) as db:
                for digest, payload in db.execute("SELECT message_key, payload FROM messages ORDER BY rowid"):
                    encrypted = bytes(payload)
                    nonce, ciphertext = encrypted[:12], encrypted[12:]
                    aad = STATE_FILE_MAGIC + b"message:" + digest.encode("ascii")
                    message = json.loads(AESGCM(key).decrypt(nonce, ciphertext, aad).decode("utf-8"))
                    if not isinstance(message, dict):
                        raise ValueError("invalid journal message")
                    if message.get("id") not in hidden_ids:
                        messages.append(message)
                    self._journal_versions[digest] = hashlib.sha256(
                        json.dumps(message, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
                    ).hexdigest()
            self._journal_cache = self._unique_messages(messages)
            self._journal_cache.sort(key=lambda item: safe_int(item.get("timestamp")))
            stat = self.message_journal_file.stat()
            self._journal_signature = (stat.st_ino, stat.st_size, stat.st_mtime_ns)
            data.setdefault("global", {})["messages"] = copy.deepcopy(self._journal_cache)
            return data
        except Exception as error:
            raise RuntimeError("Could not authenticate the encrypted message journal; data was preserved") from error

    def _write_message_journal_locked(self, messages, own_public_key=None, delete_message_ids=None):
        if not messages and not self.message_journal_file.exists():
            return
        try:
            from cryptography.hazmat.primitives.ciphers.aead import AESGCM
            key = self._get_state_key(create=True)
            fd = os.open(self.message_journal_file, os.O_RDWR | os.O_CREAT, 0o600)
            os.close(fd)
            os.chmod(self.message_journal_file, 0o600)
            staged_versions = {}
            with closing(sqlite3.connect(self.message_journal_file)) as db:
                db.execute("PRAGMA synchronous=FULL")
                self._ensure_message_journal_schema(db)
                active_digests = set()
                explicit_delete_digests = {
                    hashlib.sha256(str(message_id).encode("utf-8")).hexdigest()
                    for message_id in (delete_message_ids or [])
                    if re.fullmatch(r"[0-9a-f]{64}", str(message_id))
                }
                summaries = {}
                own_key = own_public_key
                if not is_valid_public_key(own_key):
                    own_key = self._global_identity()["public_key"]
                for message in messages:
                    if not isinstance(message, dict) or not message.get("id"):
                        continue
                    message_json = json.dumps(message, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
                    digest = hashlib.sha256(str(message["id"]).encode("utf-8")).hexdigest()
                    active_digests.add(digest)
                    descriptor = self._message_conversation_descriptor(message, own_key)
                    token = self._conversation_index_token(descriptor, key) if descriptor else None
                    version = hashlib.sha256(message_json).hexdigest()
                    if self._journal_versions.get(digest) == version:
                        db.execute("UPDATE messages SET conversation_token=? WHERE message_key=?", (token, digest))
                    else:
                        nonce = secrets.token_bytes(12)
                        aad = STATE_FILE_MAGIC + b"message:" + digest.encode("ascii")
                        encrypted = nonce + AESGCM(key).encrypt(nonce, message_json, aad)
                        db.execute(
                            "INSERT INTO messages(message_key,payload,conversation_token) VALUES(?,?,?) "
                            "ON CONFLICT(message_key) DO UPDATE SET payload=excluded.payload,conversation_token=excluded.conversation_token",
                            (digest, encrypted, token),
                        )
                        staged_versions[digest] = version
                    if token:
                        rank = (
                            safe_int(message.get("timestamp")),
                            safe_int(message.get("received_at_ms")),
                            trim_text(message.get("id"), 64),
                        )
                        entry = summaries.setdefault(token, {"count": 0, "latest_message_key": "", "latest_rank": None})
                        entry["count"] += 1
                        if entry["latest_rank"] is None or rank >= tuple(entry["latest_rank"]):
                            entry["latest_message_key"] = digest
                            entry["latest_rank"] = list(rank)
                # A partial/stale snapshot is not permission to erase chat
                # history. Only explicit local-hide IDs may remove journal
                # rows; preserve and re-index every other stored message.
                for stored_digest, encrypted in db.execute("SELECT message_key,payload FROM messages").fetchall():
                    if stored_digest in explicit_delete_digests:
                        db.execute("DELETE FROM messages WHERE message_key=?", (stored_digest,))
                        self._journal_versions.pop(stored_digest, None)
                        continue
                    if stored_digest in active_digests:
                        continue
                    message = self._decrypt_message_payload(stored_digest, encrypted, key)
                    if hashlib.sha256(str(message.get("id", "")).encode("utf-8")).hexdigest() != stored_digest:
                        raise ValueError("journal message key does not match authenticated message")
                    descriptor = self._message_conversation_descriptor(message, own_key)
                    token = self._conversation_index_token(descriptor, key) if descriptor else None
                    db.execute("UPDATE messages SET conversation_token=? WHERE message_key=?", (token, stored_digest))
                    if token:
                        rank = (
                            safe_int(message.get("timestamp")),
                            safe_int(message.get("received_at_ms")),
                            trim_text(message.get("id"), 64),
                        )
                        entry = summaries.setdefault(token, {"count": 0, "latest_message_key": "", "latest_rank": None})
                        entry["count"] += 1
                        if entry["latest_rank"] is None or rank >= tuple(entry["latest_rank"]):
                            entry["latest_message_key"] = stored_digest
                            entry["latest_rank"] = list(rank)
                db.execute("DELETE FROM conversation_index")
                for token, entry in summaries.items():
                    encrypted_index = self._encrypt_conversation_index(token, entry, key)
                    db.execute(
                        "INSERT INTO conversation_index(conversation_token,payload) VALUES(?,?)",
                        (token, encrypted_index),
                    )
                db.execute(
                    "INSERT INTO journal_meta(meta_key,meta_value) VALUES('conversation-index-version','2') "
                    "ON CONFLICT(meta_key) DO UPDATE SET meta_value=excluded.meta_value"
                )
                db.commit()
            self._journal_versions.update(staged_versions)
            stat = self.message_journal_file.stat()
            self._journal_signature = (stat.st_ino, stat.st_size, stat.st_mtime_ns)
            self._journal_cache = None
            self._journal_signature = None
        except Exception as error:
            # A failed commit must not make a retry believe the row is durable.
            self._journal_cache = None
            self._journal_signature = None
            for message in messages:
                if isinstance(message, dict) and message.get("id"):
                    digest = hashlib.sha256(str(message["id"]).encode("utf-8")).hexdigest()
                    self._journal_versions.pop(digest, None)
            raise RuntimeError("Could not durably save the encrypted message journal") from error

    @staticmethod
    def _state_list_key(value):
        if isinstance(value, dict):
            for name in ("id", "code", "public_key"):
                if value.get(name) not in (None, ""):
                    suffix = f":{value.get('timestamp')}" if name == "public_key" and value.get("timestamp") else ""
                    return f"{name}:{value[name]}{suffix}"
        return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))

    @classmethod
    def _merge_concurrent_value(cls, base, current, desired, path=""):
        if desired == base:
            return copy.deepcopy(current)
        if current == base:
            return copy.deepcopy(desired)
        if isinstance(base, dict) and isinstance(current, dict) and isinstance(desired, dict):
            merged = {}
            missing = object()
            for key in set(base) | set(current) | set(desired):
                old = base.get(key, missing)
                latest = current.get(key, missing)
                local = desired.get(key, missing)
                if local is missing:
                    if old is missing and latest is not missing:
                        merged[key] = copy.deepcopy(latest)
                    continue
                if latest is missing:
                    if old is missing:
                        merged[key] = copy.deepcopy(local)
                    elif local != old:
                        merged[key] = copy.deepcopy(local)
                    continue
                if old is missing:
                    merged[key] = copy.deepcopy(local)
                else:
                    child_path = f"{path}.{key}" if path else str(key)
                merged[key] = cls._merge_concurrent_value(old, latest, local, child_path)
            return merged
        if (
            path.startswith("global.read_cursors.")
            and isinstance(base, int) and not isinstance(base, bool)
            and isinstance(current, int) and not isinstance(current, bool)
            and isinstance(desired, int) and not isinstance(desired, bool)
        ):
            return max(current, desired)
        if isinstance(base, list) and isinstance(current, list) and isinstance(desired, list):
            base_keys = [cls._state_list_key(item) for item in base]
            current_keys = [cls._state_list_key(item) for item in current]
            desired_keys = [cls._state_list_key(item) for item in desired]
            if len(set(base_keys)) != len(base_keys) or len(set(current_keys)) != len(current_keys) or len(set(desired_keys)) != len(desired_keys):
                return copy.deepcopy(desired)
            base_map = dict(zip(base_keys, base))
            current_map = dict(zip(current_keys, current))
            desired_map = dict(zip(desired_keys, desired))
            is_message_history = path.rsplit(".", 1)[-1] == "messages"
            removed = set() if is_message_history else (
                (set(base_keys) - set(current_keys)) | (set(base_keys) - set(desired_keys))
            )
            order = [*desired_keys, *(key for key in current_keys if key not in desired_map)]
            merged = []
            for key in order:
                if key in removed:
                    continue
                if key in base_map and key in current_map and key in desired_map:
                    item = cls._merge_concurrent_value(base_map[key], current_map[key], desired_map[key], path)
                elif key in desired_map:
                    item = copy.deepcopy(desired_map[key])
                else:
                    item = copy.deepcopy(current_map[key])
                merged.append(item)
            if (
                path.rsplit(".", 1)[-1] == "messages"
                and all(isinstance(item, dict) and "timestamp" in item for item in merged)
            ):
                merged.sort(key=lambda item: safe_int(item.get("timestamp")))
            limits = {
                "friends": GLOBAL_MAX_PEERS,
                "pings": GLOBAL_MAX_PINGS,
                "messages": None,
                "community": MAX_COMMUNITY_MESSAGES,
                "sent_pings": GLOBAL_MAX_SENT_PINGS,
                "processed_event_ids": MAX_SEEN_EVENT_IDS,
                "nip17_seen_rumors": None,
                "world_pulse": MAX_PULSE_ITEMS,
                "events": MAX_EVENTS,
                "seen_event_ids": MAX_EVENTS * 2,
                "signal_receipts": MAX_SIGNAL_RECEIPTS,
                "incoming_receipts": MAX_SIGNAL_RECEIPTS,
                "cowork_invites": MAX_INVITES,
            }
            limit = limits.get(path.rsplit(".", 1)[-1])
            return merged[-limit:] if limit else merged
        return copy.deepcopy(desired)

    def _migrate_state(self, data):
        old_identity = data.get("global_identity") if isinstance(data, dict) else None
        preserved_identity = None
        if isinstance(old_identity, dict):
            try:
                candidate = generate_keypair(old_identity.get("secret_key"))
                if candidate["public_key"] == trim_text(old_identity.get("public_key"), 64).lower():
                    preserved_identity = candidate
            except (TypeError, ValueError, OverflowError):
                pass

        state = self._default_state(global_identity=preserved_identity)
        if not isinstance(data, dict):
            return state

        old_profile = data.get("profile")
        if isinstance(old_profile, dict):
            profile = state["profile"]
            profile["handle"] = trim_text(old_profile.get("handle"), 24) or profile["handle"]
            profile["avatar"] = (
                old_profile.get("avatar")
                if old_profile.get("avatar") in AVAILABLE_AVATARS
                else profile["avatar"]
            )
            profile["code"] = normalize_code(old_profile.get("code"))
            if not is_valid_friend_code(profile["code"]):
                profile["code"] = generate_friend_code()
            profile["status"] = (
                old_profile.get("status")
                if old_profile.get("status") in AVAILABLE_STATUSES
                else profile["status"]
            )
            profile["focus_started_at"] = safe_int(
                old_profile.get("focus_started_at"), profile["focus_started_at"]
            )
            for key, limit in (
                ("project_name", 32),
                ("project_desc", 80),
            ):
                profile[key] = trim_text(old_profile.get(key), limit)
            profile["project_url"] = safe_url(old_profile.get("project_url"))
            profile["interests"] = normalize_interests(old_profile.get("interests"))
            profile["room"] = normalize_room(old_profile.get("room"))
            old_privacy = old_profile.get("privacy")
            if isinstance(old_privacy, dict):
                for key in PRIVACY_DEFAULTS:
                    if key in old_privacy:
                        value = old_privacy[key]
                        if isinstance(value, bool):
                            profile["privacy"][key] = value
                        elif isinstance(value, str):
                            normalized = value.strip().lower()
                            if normalized in {"true", "1", "yes", "on"}:
                                profile["privacy"][key] = True
                            elif normalized in {"false", "0", "no", "off", ""}:
                                profile["privacy"][key] = False
                # The old demo's global matching switch was never a real
                # transport feature.  Do not carry it forward.

        valid_friends = []
        for friend in data.get("friends", []):
            normalized = self._normalize_peer(friend)
            if normalized and normalized["code"] not in LEGACY_DEMO_CODES:
                valid_friends.append(normalized)
        state["friends"] = self._unique_peers(valid_friends)

        old_global = data.get("global")
        if isinstance(old_global, dict):
            global_state = state["global"]
            global_state["locally_hidden_message_ids"] = list(dict.fromkeys(
                trim_text(value, 64).lower()
                for value in old_global.get("locally_hidden_message_ids", [])
                if re.fullmatch(r"[0-9a-f]{64}", trim_text(value, 64).lower())
            ))
            try:
                global_state["blossom_server"] = self._validate_blossom_server(old_global.get("blossom_server", ""))
            except ValueError:
                global_state["blossom_server"] = ""
            global_state["last_sync"] = safe_int(old_global.get("last_sync"))
            global_state["last_publish"] = safe_int(old_global.get("last_publish"))
            global_state["dm_relay_list_last_publish"] = safe_int(old_global.get("dm_relay_list_last_publish"))
            global_state["last_error"] = trim_text(old_global.get("last_error"), 180)
            global_state["update_available"] = bool(old_global.get("update_available", False))
            global_state["latest_version"] = trim_text(old_global.get("latest_version"), 16)
            global_state["last_notified_update"] = trim_text(old_global.get("last_notified_update"), 16)
            global_state["official_latest_version"] = trim_text(old_global.get("official_latest_version"), 16)
            global_state["last_release_check"] = safe_int(old_global.get("last_release_check"))
            global_state["last_release_check_success"] = safe_int(old_global.get("last_release_check_success"))
            global_state["relays"] = {
                trim_text(relay_url, 180): {
                    "online": bool(info.get("online")),
                    "accepted": bool(info.get("accepted")),
                    "acknowledged": bool(info.get("acknowledged")),
                    "error": trim_text(info.get("error"), 120),
                }
                for relay_url, info in (old_global.get("relays") or {}).items()
                if isinstance(info, dict) and trim_text(relay_url, 180)
            }
            global_state["blocked_pubkeys"] = [
                key
                for key in old_global.get("blocked_pubkeys", [])
                if is_valid_public_key(key)
            ][:GLOBAL_MAX_PEERS]
            global_state["incoming_receipts"] = [
                {
                    "public_key": trim_text(item.get("public_key"), 64).lower(),
                    "timestamp": safe_int(item.get("timestamp")),
                    "category": "private" if item.get("category") == "private" else "signal",
                }
                for item in (old_global.get("incoming_receipts") or [])
                if isinstance(item, dict) and is_valid_public_key(item.get("public_key"))
            ][-MAX_SIGNAL_RECEIPTS:]
            for public_key, peer in (old_global.get("peers") or {}).items():
                normalized = self._normalize_global_peer(peer)
                if normalized and normalized["public_key"] == trim_text(public_key, 64).lower():
                    global_state["peers"][normalized["public_key"]] = normalized
            global_state["pings"] = [
                normalized
                for item in old_global.get("pings", [])
                if (normalized := self._normalize_global_ping(item))
            ][-GLOBAL_MAX_PINGS:]
            friendships = {}
            for public_key, friendship in (old_global.get("friendships") or {}).items():
                public_key = trim_text(public_key, 64).lower()
                if not is_valid_public_key(public_key) or not isinstance(friendship, dict):
                    continue
                status = trim_text(friendship.get("status"), 12)
                if status not in ("pending", "friends"):
                    continue
                item = {
                    "status": status,
                    "request_id": trim_text(friendship.get("request_id"), 40),
                    "handle": trim_text(friendship.get("handle"), 24) or "A builder",
                    "avatar": friendship.get("avatar") if friendship.get("avatar") in AVAILABLE_AVATARS else "👾",
                }
                if friendship.get("private_protocol") == "nip17-v1":
                    item["private_protocol"] = "nip17-v1"
                    item["private_protocol_seen_at"] = safe_int(friendship.get("private_protocol_seen_at"))
                relay_urls = [
                    relay_url
                    for relay_url in friendship.get("nip17_dm_relays", [])
                    if isinstance(relay_url, str) and relay_url in GLOBAL_RELAYS
                ][:NIP17_MAX_DM_RELAYS]
                if relay_urls:
                    item["nip17_dm_relays"] = relay_urls
                    item["nip17_dm_relays_seen_at"] = safe_int(friendship.get("nip17_dm_relays_seen_at"))
                    item["nip17_dm_relays_event_at"] = safe_int(friendship.get("nip17_dm_relays_event_at"))
                friendships[public_key] = item
            global_state["friendships"] = friendships
            message_sender_key = state.get("global_identity", {}).get("public_key", "")
            global_state["messages"] = [
                normalized
                for item in old_global.get("messages", [])
                if (normalized := self._normalize_global_message(item, message_sender_key))
            ]
            hidden_message_ids = set(global_state.get("locally_hidden_message_ids", []))
            global_state["messages"] = [
                item for item in global_state["messages"] if item.get("id") not in hidden_message_ids
            ]
            pending_edits = {}
            old_edits = old_global.get("pending_private_edits")
            if isinstance(old_edits, dict):
                for target_id, edit in list(old_edits.items())[-512:]:
                    target_id = trim_text(target_id, 64).lower()
                    if not isinstance(edit, dict) or not re.fullmatch(r"[0-9a-f]{64}", target_id):
                        continue
                    actor = trim_text(edit.get("actor"), 64).lower()
                    text = trim_text(edit.get("text"), 2000)
                    edited_at = safe_int(edit.get("edited_at"))
                    if is_valid_public_key(actor) and text and edited_at:
                        pending_edits[target_id] = {
                            "actor": actor,
                            "group_id": trim_text(edit.get("group_id"), 40).lower(),
                            "text": text,
                            "edited_at": edited_at,
                            "queued_at": safe_int(edit.get("queued_at")),
                        }
            global_state["pending_private_edits"] = pending_edits
            global_state["groups"] = {}
            for group_id, group in (old_global.get("groups") or {}).items():
                normalized_group = self._normalize_group(group_id, group)
                if normalized_group:
                    global_state["groups"][normalized_group["id"]] = normalized_group
            global_state["groups"] = dict(list(global_state["groups"].items())[-MAX_GROUPS:])
            read_cursors = {}
            old_cursors = old_global.get("read_cursors")
            if isinstance(old_cursors, dict):
                for conversation, cursor in old_cursors.items():
                    conversation = trim_text(conversation, 80)
                    value = safe_int(cursor, maximum=now_seconds() * 1000 + 300000)
                    if re.fullmatch(r"friend:[0-9a-f]{64}", conversation):
                        key = conversation[7:]
                        if key in friendships and value:
                            read_cursors[conversation] = value
                    elif re.fullmatch(r"group:[a-z0-9_-]{1,40}", conversation):
                        group_id = conversation[6:]
                        if group_id in global_state["groups"] and value:
                            read_cursors[conversation] = value
            else:
                # Treat pre-feature history as already seen when upgrading.
                for message in global_state["messages"]:
                    if not message.get("incoming"):
                        continue
                    conversation = (
                        "group:" + message["group_id"] if message.get("group_id")
                        else "friend:" + message["public_key"]
                    )
                    received_at = safe_int(message.get("received_at_ms")) or safe_int(message.get("timestamp")) * 1000
                    read_cursors[conversation] = max(read_cursors.get(conversation, 0), received_at)
            global_state["read_cursors"] = dict(list(read_cursors.items())[-MAX_READ_CURSORS:])
            history_cursors = {}
            old_history_cursors = old_global.get("private_history_cursors")
            if isinstance(old_history_cursors, dict):
                for relay_url, entry in old_history_cursors.items():
                    if relay_url not in GLOBAL_RELAYS or not isinstance(entry, dict):
                        continue
                    until = safe_int(entry.get("until"), maximum=now_seconds() + 300000)
                    done = entry.get("done") is True
                    if until > 0 or done:
                        history_cursors[relay_url] = {"until": until, "done": done}
            global_state["private_history_cursors"] = history_cursors
            pinned_conversations = []
            for value in old_global.get("pinned_conversations", []):
                key = trim_text(value, 80)
                if key.startswith("friend:") and is_valid_public_key(key[7:]) and key[7:] in friendships:
                    if key not in pinned_conversations:
                        pinned_conversations.append(key)
                elif key.startswith("group:") and re.fullmatch(r"group:[a-z0-9_-]{1,40}", key):
                    if key[6:] in global_state["groups"] and key not in pinned_conversations:
                        pinned_conversations.append(key)
                if len(pinned_conversations) >= MAX_PINNED_CONVERSATIONS:
                    break
            global_state["pinned_conversations"] = pinned_conversations
            muted_conversations = []
            for value in old_global.get("muted_conversations", []):
                key = trim_text(value, 80)
                if key.startswith("friend:") and is_valid_public_key(key[7:]) and key[7:] in friendships:
                    if key not in muted_conversations:
                        muted_conversations.append(key)
                elif key.startswith("group:") and re.fullmatch(r"group:[a-z0-9_-]{1,40}", key):
                    if key[6:] in global_state["groups"] and key not in muted_conversations:
                        muted_conversations.append(key)
                if len(muted_conversations) >= MAX_MUTED_CONVERSATIONS:
                    break
            global_state["muted_conversations"] = muted_conversations
            global_state["community"] = self._unique_messages([
                normalized
                for item in old_global.get("community", [])
                if (normalized := self._normalize_community_message(item))
            ])[-MAX_COMMUNITY_MESSAGES:]
            global_state["sent_pings"] = [
                {
                    "public_key": trim_text(item.get("public_key"), 64).lower(),
                    "timestamp": safe_int(item.get("timestamp")),
                }
                for item in old_global.get("sent_pings", [])
                if isinstance(item, dict) and is_valid_public_key(item.get("public_key"))
            ][-GLOBAL_MAX_SENT_PINGS:]
            global_state["processed_event_ids"] = list(dict.fromkeys(
                trim_text(event_id, 64).lower()
                for event_id in old_global.get("processed_event_ids", [])
                if trim_text(event_id, 64)
            ))[-MAX_SEEN_EVENT_IDS:]
            global_state["handled_friend_requests"] = list(dict.fromkeys(
                trim_text(item, 160)
                for item in old_global.get("handled_friend_requests", [])
                if trim_text(item, 160)
            ))[-MAX_SEEN_EVENT_IDS:]
            cutoff = now_seconds() - NIP17_RUMOR_DEDUPE_SECONDS
            seen_rumors = {
                trim_text(rumor_id, 64).lower(): safe_int(seen_at)
                for rumor_id, seen_at in (old_global.get("nip17_seen_rumors") or {}).items()
                if re.fullmatch(r"[0-9a-fA-F]{64}", str(rumor_id)) and safe_int(seen_at) >= cutoff
            }
            for message in global_state["messages"]:
                rumor_id = trim_text(message.get("id"), 64).lower()
                if re.fullmatch(r"[0-9a-f]{64}", rumor_id):
                    seen_rumors.setdefault(rumor_id, now_seconds())
            global_state["nip17_seen_rumors"] = dict(
                sorted(seen_rumors.items(), key=lambda item: item[1])[-MAX_SEEN_NIP17_RUMORS:]
            )
            memory = {}
            for public_key, entry in (old_global.get("memory") or {}).items():
                public_key = trim_text(public_key, 64).lower()
                if not is_valid_public_key(public_key) or not isinstance(entry, dict):
                    continue
                memory[public_key] = self._normalize_memory_entry(public_key, entry)
            if memory:
                ordered = sorted(memory.items(), key=lambda kv: safe_int(kv[1].get("last_seen")))
                global_state["memory"] = dict(ordered[-MAX_MEMORY_PEERS:])

        old_global_focus = data.get("global_focus")
        if isinstance(old_global_focus, dict):
            focus = state["global_focus"]
            status = trim_text(old_global_focus.get("status"), 12)
            focus["status"] = status if status in ("idle", "pending", "active") else "idle"
            focus["session_id"] = trim_text(old_global_focus.get("session_id"), 40)
            focus["buddy_public_key"] = trim_text(old_global_focus.get("buddy_public_key"), 64).lower()
            if not is_valid_public_key(focus["buddy_public_key"]):
                focus["buddy_public_key"] = ""
            focus["buddy_name"] = trim_text(old_global_focus.get("buddy_name"), 24)
            focus["buddy_avatar"] = (
                old_global_focus.get("buddy_avatar")
                if old_global_focus.get("buddy_avatar") in AVAILABLE_AVATARS
                else "👾"
            )
            focus["started_at"] = safe_int(old_global_focus.get("started_at"))
            focus["ends_at"] = safe_int(old_global_focus.get("ends_at"))
            focus["total_seconds"] = safe_int(old_global_focus.get("total_seconds"), maximum=7200)

        for code, peer in (data.get("lan_peers") or {}).items():
            normalized = self._normalize_peer(peer)
            if normalized and normalized["code"] not in LEGACY_DEMO_CODES:
                state["lan_peers"][normalized["code"]] = normalized

        pulse = []
        for item in data.get("world_pulse", []):
            if not isinstance(item, dict) or item.get("id") in LEGACY_DEMO_PULSE_IDS:
                continue
            normalized = self._normalize_pulse(item)
            if normalized:
                pulse.append(normalized)
        state["world_pulse"] = pulse[-MAX_PULSE_ITEMS:]

        cowork = data.get("cowork")
        if isinstance(cowork, dict):
            state["cowork"].update(
                {
                    "active": bool(cowork.get("active")),
                    "mode": trim_text(cowork.get("mode"), 12),
                    "invite_id": trim_text(cowork.get("invite_id"), 40),
                    "buddy_code": normalize_code(cowork.get("buddy_code")),
                    "buddy_name": trim_text(cowork.get("buddy_name"), 24),
                    "buddy_avatar": trim_text(cowork.get("buddy_avatar"), 4),
                    "started_at": safe_int(cowork.get("started_at")),
                    "ends_at": safe_int(cowork.get("ends_at")),
                    "total_seconds": safe_int(cowork.get("total_seconds"), maximum=7200),
                }
            )
        state["cowork_invites"] = self._normalize_invites(data.get("cowork_invites"))

        events = []
        for event in data.get("events", []):
            normalized = self._normalize_event(event)
            if normalized:
                events.append(normalized)
        state["events"] = events[-MAX_EVENTS:]
        state["seen_event_ids"] = [
            trim_text(event_id, 40)
            for event_id in data.get("seen_event_ids", [])
            if trim_text(event_id, 40)
        ][-MAX_SEEN_EVENT_IDS:]
        signal_receipts = []
        for receipt in data.get("signal_receipts", []):
            if not isinstance(receipt, dict):
                continue
            receipt_code = normalize_code(receipt.get("code"))
            receipt_timestamp = safe_int(receipt.get("timestamp"))
            if is_valid_friend_code(receipt_code) and receipt_timestamp:
                signal_receipts.append(
                    {"code": receipt_code, "timestamp": receipt_timestamp}
                )
        state["signal_receipts"] = signal_receipts[-MAX_SIGNAL_RECEIPTS:]
        state["invite_nudge"] = bool(data.get("invite_nudge", False))
        state["invite_nudge_dismissed"] = bool(data.get("invite_nudge_dismissed", False))

        old_stats = data.get("stats")
        if isinstance(old_stats, dict):
            for key in state["stats"]:
                try:
                    state["stats"][key] = max(0, int(old_stats.get(key, 0)))
                except (TypeError, ValueError):
                    pass
        state["stats"]["friends_made"] = max(
            state["stats"]["friends_made"], len(state["friends"])
        )
        matched = self._normalize_peer(data.get("matched_peer"))
        if matched and matched["code"] not in LEGACY_DEMO_CODES:
            state["matched_peer"] = matched
        return state

    def _normalize_peer(self, peer):
        if not isinstance(peer, dict):
            return None
        code = normalize_code(peer.get("code"))
        if not is_valid_friend_code(code):
            return None
        status = peer.get("status")
        if status not in AVAILABLE_STATUSES:
            status = "coding"
        status_info = AVAILABLE_STATUSES[status]
        return {
            "code": code,
            "handle": trim_text(peer.get("handle"), 24) or "Omarchy Peer",
            "avatar": peer.get("avatar") if peer.get("avatar") in AVAILABLE_AVATARS else "👾",
            "status": status,
            "status_text": status_info["name"],
            "status_emoji": status_info["emoji"],
            "activity": trim_text(peer.get("activity"), 32),
            "music": trim_text(peer.get("music"), 100),
            "focus_mins": safe_int(peer.get("focus_mins"), maximum=1440),
            "project_name": trim_text(peer.get("project_name"), 32),
            "project_desc": trim_text(peer.get("project_desc"), 80),
            "project_url": safe_url(peer.get("project_url")),
            "theme": trim_text(peer.get("theme"), 48),
            "wallpaper": trim_text(peer.get("wallpaper"), 100),
            "interests": normalize_interests(peer.get("interests")),
            "room": normalize_room(peer.get("room")),
            "common_ground": [],
            "icebreaker": "",
            "last_seen": safe_int(peer.get("last_seen")),
            "source": trim_text(peer.get("source"), 12) or "lan",
            "online": bool(peer.get("online", False)),
        }

    def _normalize_global_peer(self, peer):
        if not isinstance(peer, dict):
            return None
        public_key = trim_text(peer.get("public_key") or peer.get("pubkey"), 64).lower()
        if not is_valid_public_key(public_key):
            return None
        status = peer.get("status")
        if not isinstance(status, str) or status not in AVAILABLE_STATUSES:
            status = "coding"
        status_info = AVAILABLE_STATUSES[status]
        raw_capabilities = peer.get("capabilities")
        capabilities = []
        if isinstance(raw_capabilities, list):
            capabilities = [
                trim_text(item, 32)
                for item in raw_capabilities
                if isinstance(item, str) and trim_text(item, 32)
            ][:12]
        dm_relays = [
            relay_url
            for relay_url in peer.get("dm_relays", [])
            if isinstance(relay_url, str) and relay_url in GLOBAL_RELAYS
        ][:NIP17_MAX_DM_RELAYS]
        return {
            "public_key": public_key,
            "handle": trim_text(peer.get("handle"), 24) or generate_global_handle(public_key),
            "avatar": peer.get("avatar") if peer.get("avatar") in AVAILABLE_AVATARS else generate_global_avatar(public_key),
            "status": status,
            "status_text": status_info["name"],
            "status_emoji": status_info["emoji"],
            "activity": trim_text(peer.get("activity"), 32),
            "music": trim_text(peer.get("music"), 100),
            "focus_mins": safe_int(peer.get("focus_mins"), maximum=1440),
            "project_name": trim_text(peer.get("project_name"), 32),
            "project_desc": trim_text(peer.get("project_desc"), 80),
            "project_url": safe_url(peer.get("project_url")),
            "theme": trim_text(peer.get("theme"), 48),
            "wallpaper": trim_text(peer.get("wallpaper"), 100),
            "interests": normalize_interests(peer.get("interests")),
            "room": normalize_room(peer.get("room")),
            "last_seen": safe_int(peer.get("last_seen") or peer.get("timestamp")),
            "source": "global",
            "online": bool(peer.get("online", False)),
            "relay_count": safe_int(peer.get("relay_count"), maximum=len(GLOBAL_RELAYS)),
            "plugin_version": trim_text(peer.get("plugin_version"), 16),
            "capabilities": capabilities,
            "dm_relays": dm_relays,
            "can_chat": "friend-requests-v1" in capabilities and (
                "nip17-dm-v1" in capabilities or "encrypted-dm-v1" in capabilities
            ),
            "nip17_chat": "nip17-dm-v1" in capabilities and "nip44-v2" in capabilities,
            "common_ground": [],
            "icebreaker": "",
        }

    def _normalize_global_ping(self, item):
        if not isinstance(item, dict):
            return None
        event_id = trim_text(item.get("id") or item.get("event_id"), 64).lower()
        public_key = trim_text(item.get("public_key") or item.get("pubkey"), 64).lower()
        action = trim_text(item.get("action"), 16)
        timestamp = safe_int(item.get("timestamp") or item.get("created_at"))
        session_id = trim_text(item.get("session_id"), 40)
        if (
            not event_id
            or not is_valid_public_key(public_key)
            or action not in GLOBAL_ACTION_META
            or not timestamp
            or (action in GLOBAL_FOCUS_ACTIONS and not session_id)
        ):
            return None
        avatar = item.get("avatar") or item.get("from_avatar")
        if avatar not in AVAILABLE_AVATARS:
            avatar = "👾"
        return {
            "id": event_id,
            "public_key": public_key,
            "handle": trim_text(item.get("handle") or item.get("from_name"), 24) or generate_global_handle(public_key),
            "avatar": avatar,
            "action": action,
            "icon": GLOBAL_ACTION_META[action][0],
            "prompt": trim_text(item.get("prompt"), 120),
            "session_id": session_id,
            "minutes": safe_int(item.get("minutes"), GLOBAL_FOCUS_DEFAULT_MINUTES, 5, 120),
            "message": trim_text(item.get("message"), 120),
            "timestamp": timestamp,
            "time_ago": format_age(timestamp),
            "read": bool(item.get("read", False)),
        }

    def _normalize_global_message(self, item, own_public_key=None):
        if not isinstance(item, dict):
            return None
        message_id = trim_text(item.get("id"), 64).lower()
        public_key = trim_text(item.get("public_key"), 64).lower()
        text = trim_text(item.get("text"), 2000)
        media = normalize_media_items(item.get("media"))
        attachments = normalize_private_attachments(item.get("attachments"))
        reply_to = item.get("reply_to") if isinstance(item.get("reply_to"), dict) else None
        if reply_to:
            reply_id = trim_text(reply_to.get("id"), 64).lower()
            reply_to = {
                "id": reply_id,
                "handle": trim_text(reply_to.get("handle"), 24) or "Message",
                "text": trim_text(reply_to.get("text"), 240),
            } if re.fullmatch(r"[0-9a-f]{64}", reply_id) else None
        reactions = []
        seen_reactions = set()
        for reaction in item.get("reactions", [])[:MAX_MESSAGE_REACTIONS] if isinstance(item.get("reactions"), list) else []:
            if not isinstance(reaction, dict):
                continue
            emoji = reaction.get("emoji")
            actor = trim_text(reaction.get("public_key"), 64).lower()
            if emoji not in ALLOWED_MESSAGE_REACTIONS or not is_valid_public_key(actor) or actor in seen_reactions:
                continue
            seen_reactions.add(actor)
            reactions.append({"emoji": emoji, "public_key": actor, "handle": trim_text(reaction.get("handle"), 24) or "Friend"})
        pending_actions = []
        raw_pending_actions = item.get("pending_actions", [])
        if isinstance(raw_pending_actions, list):
            for action in raw_pending_actions[:MAX_PENDING_MESSAGE_ACTIONS]:
                if not isinstance(action, dict) or action.get("kind") not in {"edit", "delete", "reaction"}:
                    continue
                payload = action.get("payload")
                recipients = action.get("recipients")
                transports = action.get("transports")
                if not isinstance(payload, dict) or not isinstance(recipients, list) or not isinstance(transports, dict):
                    continue
                valid_recipients = [
                    key for key in dict.fromkeys(recipients[:MAX_GROUP_MEMBERS])
                    if is_valid_public_key(key) and isinstance(transports.get(key), dict)
                ]
                if valid_recipients:
                    allowed_fields = {
                        "edit": {"v", "type", "target_id", "group_id", "text"},
                        "delete": {"v", "type", "target_id", "group_id"},
                        "reaction": {"v", "type", "target_id", "group_id", "emoji"},
                    }[action["kind"]]
                    target_message_id = trim_text(item.get("id"), 64).lower()
                    normalized_group_id = trim_text(item.get("group_id"), 40).lower()
                    expected = {"v": 3, "type": action["kind"], "target_id": target_message_id, "group_id": normalized_group_id}
                    if action["kind"] == "edit":
                        expected["text"] = trim_text(payload.get("text"), 2000)
                    elif action["kind"] == "reaction":
                        expected["emoji"] = payload.get("emoji")
                    if set(payload) != allowed_fields or payload != expected:
                        continue
                    if action["kind"] == "reaction" and payload.get("emoji") not in ALLOWED_MESSAGE_REACTIONS:
                        continue
                    safe_transports = {}
                    for key in valid_recipients:
                        transport = transports[key]
                        kind = transport.get("kind")
                        saved = transport.get("rumor") if kind == "nip17_rumor" else transport.get("event") if kind == "legacy_event" else None
                        valid_transport = (
                            self._saved_nip17_rumor_valid(saved, target_message_id, key, normalized_group_id, action["kind"], payload)
                            if kind == "nip17_rumor"
                            else self._saved_legacy_action_event_valid(
                                saved, own_public_key or self._global_identity()["public_key"], key, target_message_id, normalized_group_id,
                            )
                        )
                        if valid_transport:
                            safe_transports[key] = copy.deepcopy(transport)
                    valid_recipients = [key for key in valid_recipients if key in safe_transports]
                    if not valid_recipients:
                        continue
                    pending_actions.append({
                        "kind": action["kind"],
                        "payload": copy.deepcopy(payload),
                        "recipients": valid_recipients,
                        "transports": safe_transports,
                    })
        if not message_id or not is_valid_public_key(public_key) or (not text and not media and not attachments and not item.get("deleted")):
            return None
        retry_actions = []
        raw_retry_actions = item.get("retry_actions")
        message_group_id = trim_text(item.get("group_id"), 40).lower()
        if not item.get("incoming") and isinstance(raw_retry_actions, list):
            conversation_key = trim_text(item.get("conversation_key"), 64).lower()
            for action in raw_retry_actions[:MAX_GROUP_MEMBERS]:
                recipient = trim_text(action.get("recipient"), 64).lower() if isinstance(action, dict) else ""
                if not isinstance(action, dict) or not is_valid_public_key(recipient):
                    continue
                if (message_group_id and recipient == public_key) or (not message_group_id and recipient != conversation_key):
                    continue
                kind = action.get("kind")
                event = action.get("rumor") if kind == "nip17_rumor" else action.get("event") if kind == "legacy_event" else None
                valid = (
                    self._saved_nip17_rumor_valid(event, message_id, recipient, message_group_id)
                    if kind == "nip17_rumor"
                    else isinstance(event, dict)
                    and (message_group_id or event.get("id") == message_id)
                    and verify_event(event)
                    and any(isinstance(tag, list) and len(tag) >= 2 and tag[0] == "p" and tag[1] == recipient for tag in event.get("tags", []))
                    and (not message_group_id or any(isinstance(tag, list) and len(tag) >= 2 and tag[0] == "g" and tag[1] == message_group_id for tag in event.get("tags", [])))
                )
                if not valid:
                    continue
                retry_actions.append({"kind": kind, "recipient": recipient, "rumor" if kind == "nip17_rumor" else "event": event})
        retry_attempts = safe_int(item.get("retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES)
        retry_at = safe_int(item.get("retry_at"), maximum=now_seconds() + 86400 * 365)
        read_receipt_retry_attempts = safe_int(
            item.get("read_receipt_retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES
        )
        read_receipt_retry_at = safe_int(
            item.get("read_receipt_retry_at"), maximum=now_seconds() + 86400 * 365
        )
        read_receipt_eligible = bool(item.get("read_receipt_eligible", False))
        if read_receipt_eligible and read_receipt_retry_attempts < MAX_PRIVATE_AUTO_RETRIES and read_receipt_retry_at <= 0:
            read_receipt_retry_at = now_seconds() + PRIVATE_AUTO_RETRY_DELAYS[0]
        saved_send_state = trim_text(item.get("sendState"), 32)
        if (retry_actions and retry_attempts < MAX_PRIVATE_AUTO_RETRIES and retry_at <= 0
                and saved_send_state.startswith(("Failed", "Unconfirmed", "Partial"))):
            # Upgrade failures saved before automatic retry metadata existed.
            retry_at = now_seconds() + PRIVATE_AUTO_RETRY_DELAYS[0]
        return {
            "id": message_id,
            "public_key": public_key,
            "conversation_key": trim_text(item.get("conversation_key"), 64).lower(),
            "handle": trim_text(item.get("handle"), 24) or "A friend",
            "group_id": trim_text(item.get("group_id"), 40),
            "group_name": trim_text(item.get("group_name"), MAX_GROUP_NAME_LENGTH),
            "message_type": trim_text(item.get("message_type"), 24) or "direct",
            "text": text,
            "media": media,
            "attachments": attachments,
            "reply_to": reply_to,
            "reactions": reactions,
            "read_by": [
                key for key in dict.fromkeys(
                    trim_text(value, 64).lower() for value in item.get("read_by", [])
                    if is_valid_public_key(trim_text(value, 64).lower())
                )
            ][:MAX_GROUP_MEMBERS],
            "read_receipt_sent_to": [
                key for key in dict.fromkeys(
                    trim_text(value, 64).lower() for value in item.get("read_receipt_sent_to", [])
                    if is_valid_public_key(trim_text(value, 64).lower())
                )
            ][:MAX_GROUP_MEMBERS],
            "deleted": bool(item.get("deleted", False)),
            "edited": bool(item.get("edited", False)),
            "edited_at": safe_int(item.get("edited_at")),
            "pending_actions": pending_actions,
            "read_receipt_eligible": read_receipt_eligible,
            "read_receipt_retry_attempts": read_receipt_retry_attempts,
            "read_receipt_retry_at": read_receipt_retry_at,
            "timestamp": safe_int(item.get("timestamp"), now_seconds()),
            "received_at_ms": safe_int(item.get("received_at_ms"), maximum=now_seconds() * 1000 + 300000),
            "incoming": bool(item.get("incoming", False)),
            "sendState": saved_send_state,
            "retry_attempts": retry_attempts,
            "retry_at": retry_at,
            "retry_actions": retry_actions,
            "retryable_actions": bool(pending_actions),
            # Keep the encrypted transport payload out of the QML/status JSON;
            # the UI only needs to know whether an explicit retry is possible.
            "retryable": bool(item.get("retry_actions")),
        }

    def conversation_history_page(self, conversation_type, identifier, offset=0, limit=80):
        """Return one bounded chronological page from a single local conversation."""
        conversation_type = trim_text(conversation_type, 16).lower()
        identifier = trim_text(identifier, 64).lower()
        offset = safe_int(offset, 0, 0, MAX_CONVERSATION_HISTORY_OFFSET)
        limit = safe_int(limit, 80, 1, MAX_CONVERSATION_HISTORY_PAGE_SIZE)
        if conversation_type == "friend":
            if not is_valid_public_key(identifier):
                return {"ok": False, "message": "Invalid friend conversation", "messages": [], "total": 0, "has_earlier": False}
        elif conversation_type == "group":
            if not identifier or len(identifier) > 40:
                return {"ok": False, "message": "Invalid group conversation", "messages": [], "total": 0, "has_earlier": False}
        elif conversation_type == "unlinked":
            if identifier != "local":
                return {"ok": False, "message": "Invalid recovered-message archive", "messages": [], "total": 0, "has_earlier": False}
        else:
            return {"ok": False, "message": "Unsupported conversation type", "messages": [], "total": 0, "has_earlier": False}

        own_public_key = self._global_identity()["public_key"]
        descriptor = ("unlinked", "local") if conversation_type == "unlinked" else (conversation_type, identifier)
        matching = self._journal_conversation_messages(descriptor)
        seen_message_ids = {str(item.get("id")) for item in matching if item.get("id")}
        for item in self.state.get("global", {}).get("messages", []):
            if not isinstance(item, dict):
                continue
            if self._message_conversation_descriptor(item, own_public_key) != descriptor:
                continue
            if str(item.get("id") or "") in seen_message_ids:
                continue
            normalized = self._normalize_global_message(item, own_public_key)
            if normalized:
                if descriptor[0] == "unlinked":
                    normalized["legacy_unlinked"] = True
                matching.append(
                    {key: value for key, value in normalized.items() if key not in {"retry_actions", "pending_actions"}}
                    | {"retryable": normalized["retryable"], "retryable_actions": normalized["retryable_actions"]}
                )
                if normalized.get("id"):
                    seen_message_ids.add(str(normalized["id"]))

        matching.sort(key=lambda item: (
            safe_int(item.get("timestamp")),
            safe_int(item.get("received_at_ms")),
            trim_text(item.get("id"), 64),
        ))
        total = len(matching)
        end = max(0, total - offset)
        start = max(0, end - limit)
        return {
            "ok": True,
            "messages": matching[start:end],
            "total": total,
            "offset": offset,
            "has_earlier": start > 0,
        }

    @staticmethod
    def _saved_nip17_rumor_valid(rumor, message_id, recipient, group_id="", action_kind="message", expected_payload=None):
        if not isinstance(rumor, dict):
            return False
        try:
            pubkey = trim_text(rumor.get("pubkey"), 64).lower()
            created_at = int(rumor.get("created_at"))
            kind = int(rumor.get("kind"))
            tags = rumor.get("tags")
            content = rumor.get("content")
            allowed_kinds = {
                "message": (NIP17_MESSAGE_KIND, NIP17_FILE_KIND),
                "edit": (NIP17_MESSAGE_KIND,),
                "delete": (NIP17_DELETE_KIND,),
                "reaction": (NIP17_REACTION_KIND,),
            }.get(action_kind, ())
            if (not re.fullmatch(r"[0-9a-f]{64}", pubkey) or kind not in allowed_kinds
                    or not isinstance(tags, list) or not isinstance(content, str)):
                return False
            recipient_tags = [
                tag[1] for tag in tags
                if isinstance(tag, list) and len(tag) >= 2 and tag[0] == "p"
            ]
            has_recipient = recipient in recipient_tags
            canonical = json.dumps(
                [0, pubkey, created_at, kind, tags, content],
                ensure_ascii=False,
                separators=(",", ":"),
            ).encode("utf-8")
            if action_kind != "message":
                envelope_tag = next((tag for tag in tags if isinstance(tag, list) and len(tag) >= 2 and tag[0] == "omarchy-envelope"), None)
                try:
                    envelope = json.loads(envelope_tag[1]) if envelope_tag else {}
                except (TypeError, ValueError):
                    envelope = {}
                if (envelope.get("type") != action_kind or envelope.get("target_id") != message_id
                        or envelope.get("group_id", "") != group_id
                        or (expected_payload is not None and envelope != expected_payload)
                        or hashlib.sha256(canonical).hexdigest() != rumor.get("id")):
                    return False
            elif group_id:
                envelope_tag = next((tag for tag in tags if isinstance(tag, list) and len(tag) >= 2 and tag[0] == "omarchy-envelope"), None)
                try:
                    envelope = json.loads(envelope_tag[1]) if envelope_tag else {}
                except (TypeError, ValueError):
                    envelope = {}
                if envelope.get("type") != "group_message" or envelope.get("group_id") != group_id:
                    return False
            expected_id = rumor.get("id") if action_kind != "message" else message_id
            return has_recipient and hashlib.sha256(canonical).hexdigest() == expected_id == rumor.get("id")
        except (TypeError, ValueError, OverflowError):
            return False

    def _store_pending_message_action(self, target, kind, payload, pending_by_recipient):
        if not isinstance(target, dict):
            return
        # A newer same-kind action supersedes the old saved intent. Deletion
        # is terminal, so it invalidates every queued edit/reaction as well.
        existing = [] if kind == "delete" else [
            action for action in target.get("pending_actions", [])
            if isinstance(action, dict) and action.get("kind") not in {kind, "delete"}
        ]
        if pending_by_recipient:
            recipients = list(dict.fromkeys(
                key for key in pending_by_recipient
                if is_valid_public_key(key) and isinstance(pending_by_recipient.get(key), dict)
            ))[:MAX_GROUP_MEMBERS]
            if recipients:
                existing.append({
                    "kind": kind,
                    "payload": copy.deepcopy(payload),
                    "recipients": recipients,
                    "transports": {key: copy.deepcopy(pending_by_recipient[key]) for key in recipients},
                })
        target["pending_actions"] = existing[-MAX_PENDING_MESSAGE_ACTIONS:]

    def _saved_legacy_action_event_valid(self, event, sender, recipient, target_id, group_id):
        if (not isinstance(event, dict) or event.get("kind") != GLOBAL_DM_KIND
                or event.get("pubkey") != trim_text(sender, 64).lower() or not verify_event(event)
                or recipient not in self._event_tag_values(event, "p")
                or target_id not in self._event_tag_values(event, "e")
                or (group_id and group_id not in self._event_tag_values(event, "g"))
                or GLOBAL_DM_TAG not in self._event_tag_values(event, "t")):
            return False
        try:
            encrypted = json.loads(event.get("content", "{}"))
        except (TypeError, ValueError, json.JSONDecodeError):
            return False
        return isinstance(encrypted, dict) and {"nonce", "ciphertext", "mac"}.issubset(encrypted)

    def _retry_message_action(self, target):
        """Retry saved edit/delete/reaction payloads only to unconfirmed peers."""
        actions = target.get("pending_actions", [])
        if not actions:
            return True, "No pending message actions"
        own_key = self._global_identity()["public_key"]
        group_id = trim_text(target.get("group_id"), 40).lower()
        group = self.state.get("global", {}).get("groups", {}).get(group_id, {}) if group_id else {}
        friendship = self.state.get("global", {}).get("friendships", {})
        remaining = []
        for action in actions:
            payload = action.get("payload", {})
            transports = action.get("transports", {})
            expected_fields = {
                "edit": {"v", "type", "target_id", "group_id", "text"},
                "delete": {"v", "type", "target_id", "group_id"},
                "reaction": {"v", "type", "target_id", "group_id", "emoji"},
            }.get(action.get("kind"), set())
            expected_payload = {
                "v": 3,
                "type": action.get("kind"),
                "target_id": target.get("id"),
                "group_id": group_id,
            }
            if action.get("kind") == "edit":
                expected_payload["text"] = trim_text(payload.get("text"), 2000)
            elif action.get("kind") == "delete":
                pass
            elif action.get("kind") == "reaction":
                expected_payload["emoji"] = payload.get("emoji")
            if (not expected_fields or set(payload) != expected_fields or payload != expected_payload
                    or (action.get("kind") == "reaction" and payload.get("emoji") not in ALLOWED_MESSAGE_REACTIONS)):
                continue
            still_pending = {}
            for recipient in action.get("recipients", []):
                if group_id:
                    allowed = own_key in group.get("members", {}) and recipient in group.get("members", {}) and friendship.get(recipient, {}).get("status") == "friends"
                else:
                    allowed = recipient == target.get("conversation_key") and friendship.get(recipient, {}).get("status") == "friends"
                transport = transports.get(recipient, {})
                if not isinstance(transport, dict):
                    continue
                if not allowed:
                    # A former friend/group member must not keep retryable
                    # private transport data indefinitely or receive a later retry.
                    continue
                try:
                    if transport.get("kind") == "nip17_rumor":
                        rumor = transport.get("rumor")
                        rumor_id = trim_text(rumor.get("id"), 64) if isinstance(rumor, dict) else ""
                        if (not self._saved_nip17_rumor_valid(
                                rumor, trim_text(target.get("id"), 64), recipient, group_id,
                                action.get("kind"), payload,
                        )
                                or rumor.get("pubkey") != own_key):
                            still_pending[recipient] = transport
                            continue
                        ok, _ = self._publish_nip17(recipient, rumor)
                    elif transport.get("kind") == "legacy_event":
                        event = transport.get("event")
                        target_id = trim_text(target.get("id"), 64)
                        try:
                            encrypted = json.loads(event.get("content", "{}")) if isinstance(event, dict) else {}
                            envelope = json.loads(_decrypt_legacy_private_text(
                                self._global_identity()["secret_key"], recipient, encrypted,
                            ))
                        except (TypeError, ValueError, json.JSONDecodeError):
                            envelope = {}
                        if (not isinstance(event, dict) or event.get("pubkey") != own_key or not verify_event(event)
                                or not any(isinstance(tag, list) and len(tag) >= 2 and tag[0] == "p" and tag[1] == recipient for tag in event.get("tags", []))
                                or not any(isinstance(tag, list) and len(tag) >= 2 and tag[0] == "e" and tag[1] == target_id for tag in event.get("tags", []))
                                or (group_id and not any(isinstance(tag, list) and len(tag) >= 2 and tag[0] == "g" and tag[1] == group_id for tag in event.get("tags", [])))
                                or envelope != payload):
                            still_pending[recipient] = transport
                            continue
                        ok, relay_status = self._publish_global_event(event)
                        self.state["global"]["relays"].update(relay_status)
                    else:
                        still_pending[recipient] = transport
                        continue
                except (TypeError, ValueError, OSError, ssl.SSLError):
                    ok = False
                if not ok:
                    still_pending[recipient] = transport
            if still_pending:
                remaining.append({
                    "kind": action.get("kind"),
                    "payload": copy.deepcopy(payload),
                    "recipients": list(still_pending),
                    "transports": still_pending,
                })
        target["pending_actions"] = remaining
        self.save_state()
        if remaining:
            return False, "Some current conversation members still have unconfirmed actions; retry remains available"
        return True, "All message action deliveries confirmed"

    def retry_message_action(self, target_id):
        target_id = trim_text(target_id, 64).lower()
        if not re.fullmatch(r"[0-9a-f]{64}", target_id):
            return False, "That message cannot be retried"
        target = next((item for item in self.state.get("global", {}).get("messages", []) if isinstance(item, dict) and item.get("id") == target_id), None)
        if not isinstance(target, dict) or target.get("incoming"):
            return False, "Only your own message actions can be retried"
        return self._retry_message_action(target)

    def _global_unread_counts(self):
        global_state = self.state.setdefault("global", {})
        cursors = global_state.setdefault("read_cursors", {})
        counts = {}
        for message in global_state.get("messages", []):
            if not isinstance(message, dict) or not message.get("incoming") or message.get("deleted"):
                continue
            if message.get("message_type") not in (None, "", "direct", "group_message"):
                continue
            group_id = trim_text(message.get("group_id"), 40).lower()
            conversation = "group:" + group_id if group_id else "friend:" + trim_text(message.get("public_key"), 64).lower()
            received_at = safe_int(message.get("received_at_ms")) or safe_int(message.get("timestamp")) * 1000
            if received_at > safe_int(cursors.get(conversation)):
                counts[conversation] = counts.get(conversation, 0) + 1
        return counts

    def mark_conversation_read(self, kind, identifier):
        kind = trim_text(kind, 8).lower()
        identifier = trim_text(identifier, 64).lower()
        global_state = self.state.setdefault("global", {})
        if kind == "friend" and is_valid_public_key(identifier):
            friendship = global_state.get("friendships", {}).get(identifier, {})
            if friendship.get("status") != "friends":
                return False, "That private conversation is not available"
        elif kind == "group" and identifier in global_state.get("groups", {}):
            pass
        else:
            return False, "That private conversation is not available"
        conversation = f"{kind}:{identifier}"
        cursors = global_state.setdefault("read_cursors", {})
        previous_cursor = safe_int(cursors.get(conversation))
        read_cursor = time.time_ns() // 1_000_000
        share_receipts = self.state.get("profile", {}).get("privacy", {}).get("share_read_receipts", False)
        if share_receipts:
            for message in global_state.get("messages", []):
                if not message.get("incoming") or message.get("deleted"):
                    continue
                message_conversation = (
                    "group:" + trim_text(message.get("group_id"), 40).lower()
                    if message.get("group_id") else "friend:" + trim_text(message.get("public_key"), 64).lower()
                )
                received_at = safe_int(message.get("received_at_ms")) or safe_int(message.get("timestamp")) * 1000
                if message_conversation == conversation and previous_cursor < received_at <= read_cursor:
                    message["read_receipt_eligible"] = True
                    message["read_receipt_retry_attempts"] = 0
                    message["read_receipt_retry_at"] = now_seconds()
            for message in global_state.get("messages", []):
                if not message.get("incoming") or not message.get("read_receipt_eligible"):
                    continue
                message_conversation = (
                    "group:" + trim_text(message.get("group_id"), 40).lower()
                    if message.get("group_id") else "friend:" + trim_text(message.get("public_key"), 64).lower()
                )
                if message_conversation == conversation:
                    # Opening a chat is an explicit retry after a previous
                    # backoff window has been exhausted.
                    message["read_receipt_retry_attempts"] = 0
                    message["read_receipt_retry_at"] = now_seconds()
        cursors[conversation] = max(previous_cursor, read_cursor)
        if len(cursors) > MAX_READ_CURSORS:
            global_state["read_cursors"] = dict(list(cursors.items())[-MAX_READ_CURSORS:])
        if share_receipts:
            self._send_read_receipts(kind, identifier)
        self.save_state()
        return True, "Conversation marked as read"

    def set_conversation_pinned(self, kind, identifier, pinned):
        kind = trim_text(kind, 8).lower()
        identifier = trim_text(identifier, 64).lower()
        global_state = self.state.setdefault("global", {})
        if kind == "friend" and is_valid_public_key(identifier):
            if global_state.get("friendships", {}).get(identifier, {}).get("status") != "friends":
                return False, "That private conversation is not available"
        elif kind == "group" and identifier in global_state.get("groups", {}):
            group = global_state["groups"][identifier]
            if self._global_identity()["public_key"] not in group.get("members", {}):
                return False, "That private group is not available"
        else:
            return False, "That private conversation is not available"

        key = f"{kind}:{identifier}"
        current = global_state.setdefault("pinned_conversations", [])
        if not isinstance(current, list):
            current = []
            global_state["pinned_conversations"] = current
        if pinned:
            if key in current:
                return True, "Conversation is already pinned"
            if len(current) >= MAX_PINNED_CONVERSATIONS:
                return False, f"You can pin up to {MAX_PINNED_CONVERSATIONS} conversations"
            current.append(key)
        else:
            global_state["pinned_conversations"] = [item for item in current if item != key]
        self.save_state()
        return True, "Conversation pinned" if pinned else "Conversation unpinned"

    def set_conversation_muted(self, kind, identifier, muted):
        kind = trim_text(kind, 8).lower()
        identifier = trim_text(identifier, 64).lower()
        global_state = self.state.setdefault("global", {})
        if kind == "friend" and is_valid_public_key(identifier):
            if global_state.get("friendships", {}).get(identifier, {}).get("status") != "friends":
                return False, "That private conversation is not available"
        elif kind == "group" and identifier in global_state.get("groups", {}):
            group = global_state["groups"][identifier]
            if self._global_identity()["public_key"] not in group.get("members", {}):
                return False, "That private group is not available"
        else:
            return False, "That private conversation is not available"

        key = f"{kind}:{identifier}"
        current = global_state.setdefault("muted_conversations", [])
        if not isinstance(current, list):
            current = []
            global_state["muted_conversations"] = current
        if muted:
            if key not in current:
                if len(current) >= MAX_MUTED_CONVERSATIONS:
                    return False, "Too many muted conversations"
                current.append(key)
        else:
            global_state["muted_conversations"] = [item for item in current if item != key]
        self.save_state()
        return True, "Conversation muted" if muted else "Conversation unmuted"

    def _normalize_group(self, group_id, item):
        if not isinstance(item, dict):
            return None
        group_id = trim_text(group_id or item.get("id"), 40).lower()
        name = " ".join(trim_text(item.get("name"), MAX_GROUP_NAME_LENGTH).split())
        if not group_id or not name:
            return None
        members = {}
        raw_members = item.get("members", {})
        if isinstance(raw_members, list):
            raw_members = {member.get("public_key"): member for member in raw_members if isinstance(member, dict)}
        if not isinstance(raw_members, dict):
            return None
        for public_key, member in raw_members.items():
            public_key = trim_text(public_key, 64).lower()
            if not is_valid_public_key(public_key) or not isinstance(member, dict):
                continue
            members[public_key] = {
                "public_key": public_key,
                "handle": trim_text(member.get("handle"), 24) or generate_global_handle(public_key),
                "avatar": member.get("avatar") if member.get("avatar") in AVAILABLE_AVATARS else "👾",
            }
            if len(members) >= MAX_GROUP_MEMBERS:
                break
        current_state = getattr(self, "state", {})
        own_key = trim_text((current_state.get("global_identity") or {}).get("public_key"), 64).lower()
        if own_key and is_valid_public_key(own_key) and own_key not in members:
            members[own_key] = {
                "public_key": own_key,
                "handle": trim_text(current_state.get("profile", {}).get("handle"), 24) or "You",
                "avatar": current_state.get("profile", {}).get("avatar") if current_state.get("profile", {}).get("avatar") in AVAILABLE_AVATARS else "👾",
            }
        if len(members) < 2:
            return None
        created_by = trim_text(item.get("created_by"), 64).lower()
        return {
            "id": group_id,
            "name": name,
            "members": members,
            "created_by": created_by if is_valid_public_key(created_by) else own_key,
            "created_at": safe_int(item.get("created_at"), now_seconds()),
        }

    def _normalize_community_message(self, item):
        if not isinstance(item, dict):
            return None
        message_id = trim_text(item.get("id"), 64).lower()
        public_key = trim_text(item.get("public_key"), 64).lower()
        text = trim_text(item.get("text"), 500)
        if not message_id or not is_valid_public_key(public_key) or not text:
            return None
        return {
            "id": message_id,
            "public_key": public_key,
            "handle": trim_text(item.get("handle"), 24) or generate_global_handle(public_key),
            "avatar": item.get("avatar") if item.get("avatar") in AVAILABLE_AVATARS else "👾",
            "text": text,
            "timestamp": safe_int(item.get("timestamp"), now_seconds()),
            "time_ago": format_age(safe_int(item.get("timestamp"), now_seconds())),
            "incoming": bool(item.get("incoming", False)),
        }

    def _normalize_pulse(self, item):
        if not isinstance(item, dict):
            return None
        pulse_id = trim_text(item.get("id"), 40)
        if not pulse_id:
            return None
        timestamp = safe_int(item.get("timestamp"), now_seconds())
        return {
            "id": pulse_id,
            "user": trim_text(item.get("user"), 24) or "A nearby builder",
            "avatar": trim_text(item.get("avatar"), 4) or "👾",
            "action": trim_text(item.get("action"), 16) or "signal",
            "text": trim_text(item.get("text"), 140),
            "timestamp": timestamp,
            "time_ago": format_age(timestamp),
            "cheers": safe_int(item.get("cheers"), maximum=999),
            "remote": bool(item.get("remote", False)),
            "peer_code": normalize_code(item.get("peer_code")),
        }

    def _normalize_event(self, event):
        if not isinstance(event, dict):
            return None
        event_id = trim_text(event.get("id"), 64)
        if not event_id:
            return None
        return {
            "id": event_id,
            "action": trim_text(event.get("action"), 16) or "signal",
            "icon": trim_text(event.get("icon"), 4) or "✦",
            "from_name": trim_text(event.get("from_name"), 24) or "A nearby builder",
            "from_avatar": trim_text(event.get("from_avatar"), 4) or "👾",
            "message": trim_text(event.get("message"), 180),
            "timestamp": safe_int(event.get("timestamp"), now_seconds()),
        }

    def _normalize_invites(self, invites):
        normalized = []
        for invite in invites or []:
            if not isinstance(invite, dict):
                continue
            invite_id = trim_text(invite.get("id"), 40)
            code = normalize_code(invite.get("from_code"))
            if not invite_id or not is_valid_friend_code(code):
                continue
            normalized.append(
                {
                    "id": invite_id,
                    "from_code": code,
                    "from_name": trim_text(invite.get("from_name"), 24) or "A nearby builder",
                    "from_avatar": trim_text(invite.get("from_avatar"), 4) or "👾",
                    "duration_mins": safe_int(invite.get("duration_mins"), 25, 5, 120),
                    "started_at": safe_int(invite.get("started_at"), now_seconds()),
                    "ends_at": safe_int(invite.get("ends_at"), now_seconds() + 1500),
                }
            )
        return normalized[-MAX_INVITES:]

    @staticmethod
    def _unique_peers(peers):
        result = []
        seen = set()
        for peer in peers:
            if peer and peer["code"] not in seen:
                result.append(peer)
                seen.add(peer["code"])
        return result

    @staticmethod
    def _unique_messages(messages):
        """Collapse relay echoes and legacy duplicate messages by event id."""
        result = []
        positions = {}
        for message in messages:
            message_id = message.get("id") if isinstance(message, dict) else ""
            if not message_id:
                continue
            position = positions.get(message_id)
            if position is None:
                positions[message_id] = len(result)
                result.append(message)
                continue
            # Keep the local copy when a relay echo has the same event id.
            if result[position].get("incoming") and not message.get("incoming"):
                result[position] = message
        return result

    def _message_conversation_descriptor(self, message, own_public_key=None):
        if not isinstance(message, dict):
            return None
        group_id = trim_text(message.get("group_id"), 40).lower()
        if group_id:
            return ("group", group_id)
        peer_key = trim_text(message.get("conversation_key"), 64).lower()
        if not peer_key:
            peer_key = trim_text(message.get("public_key"), 64).lower()
        if not is_valid_public_key(peer_key):
            return None
        if own_public_key is None:
            own_public_key = self._global_identity()["public_key"]
        if peer_key == trim_text(own_public_key, 64).lower():
            # Older relay imports could retain an outgoing direct message but
            # lose its recipient tag. Keep those records in a local-only
            # archive instead of silently dropping them from the UI index.
            if not message.get("incoming") and not trim_text(message.get("conversation_key"), 64):
                return ("unlinked", "local")
            return None
        return ("friend", peer_key)

    @staticmethod
    def _conversation_index_token(descriptor, key):
        if not descriptor:
            return ""
        kind, identifier = descriptor
        payload = b"omarchy-friends-conversation-index-v1\0" + kind.encode("ascii") + b"\0" + identifier.encode("utf-8")
        return hmac.new(key, payload, hashlib.sha256).hexdigest()

    @staticmethod
    def _ensure_message_journal_schema(db):
        db.execute("CREATE TABLE IF NOT EXISTS messages (message_key TEXT PRIMARY KEY, payload BLOB NOT NULL)")
        columns = {row[1] for row in db.execute("PRAGMA table_info(messages)")}
        if "conversation_token" not in columns:
            db.execute("ALTER TABLE messages ADD COLUMN conversation_token TEXT")
        db.execute("CREATE INDEX IF NOT EXISTS messages_conversation_token_idx ON messages(conversation_token)")
        db.execute("CREATE TABLE IF NOT EXISTS conversation_index (conversation_token TEXT PRIMARY KEY, payload BLOB NOT NULL)")
        db.execute("CREATE TABLE IF NOT EXISTS journal_meta (meta_key TEXT PRIMARY KEY, meta_value TEXT NOT NULL)")
        for operation in ("INSERT", "UPDATE", "DELETE"):
            db.execute(
                f"CREATE TRIGGER IF NOT EXISTS messages_index_invalidate_{operation.lower()} "
                f"AFTER {operation} ON messages BEGIN "
                "DELETE FROM journal_meta WHERE meta_key='conversation-index-version'; END"
            )

    @staticmethod
    def _encrypt_conversation_index(token, entry, key):
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        nonce = secrets.token_bytes(12)
        aad = STATE_FILE_MAGIC + b"conversation-index:" + token.encode("ascii")
        payload = json.dumps(entry, separators=(",", ":")).encode("utf-8")
        return nonce + AESGCM(key).encrypt(nonce, payload, aad)

    @staticmethod
    def _decrypt_conversation_index(token, encrypted, key):
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        encrypted = bytes(encrypted)
        nonce, ciphertext = encrypted[:12], encrypted[12:]
        aad = STATE_FILE_MAGIC + b"conversation-index:" + token.encode("ascii")
        value = json.loads(AESGCM(key).decrypt(nonce, ciphertext, aad).decode("utf-8"))
        if not isinstance(value, dict):
            raise ValueError("invalid encrypted conversation index")
        return value

    @staticmethod
    def _decrypt_message_payload(digest, encrypted, key):
        from cryptography.hazmat.primitives.ciphers.aead import AESGCM
        encrypted = bytes(encrypted)
        nonce, ciphertext = encrypted[:12], encrypted[12:]
        aad = STATE_FILE_MAGIC + b"message:" + digest.encode("ascii")
        message = json.loads(AESGCM(key).decrypt(nonce, ciphertext, aad).decode("utf-8"))
        if not isinstance(message, dict):
            raise ValueError("invalid journal message")
        return message

    def _ensure_journal_index(self):
        """Add a keyed conversation index without exposing peer IDs or message text."""
        if not self.message_journal_file.exists():
            return False
        key = self._get_state_key()
        try:
            with closing(sqlite3.connect(self.message_journal_file, timeout=10)) as db:
                self._ensure_message_journal_schema(db)
                version = db.execute("SELECT meta_value FROM journal_meta WHERE meta_key='conversation-index-version'").fetchone()
                if version and version[0] == "2":
                    db.commit()
                    return True
                db.execute("BEGIN IMMEDIATE")
                own_key = self._global_identity()["public_key"]
                summaries = {}
                for digest, encrypted in db.execute("SELECT message_key, payload FROM messages ORDER BY rowid"):
                    message = self._decrypt_message_payload(digest, encrypted, key)
                    descriptor = self._message_conversation_descriptor(message, own_key)
                    if not descriptor:
                        db.execute("UPDATE messages SET conversation_token=NULL WHERE message_key=?", (digest,))
                        continue
                    token = self._conversation_index_token(descriptor, key)
                    db.execute("UPDATE messages SET conversation_token=? WHERE message_key=?", (token, digest))
                    rank = (
                        safe_int(message.get("timestamp")),
                        safe_int(message.get("received_at_ms")),
                        trim_text(message.get("id"), 64),
                    )
                    entry = summaries.setdefault(token, {"count": 0, "latest_message_key": "", "latest_rank": None})
                    entry["count"] += 1
                    if entry["latest_rank"] is None or rank >= tuple(entry["latest_rank"]):
                        entry["latest_message_key"] = digest
                        entry["latest_rank"] = list(rank)
                db.execute("DELETE FROM conversation_index")
                for token, entry in summaries.items():
                    encrypted = self._encrypt_conversation_index(token, entry, key)
                    db.execute("INSERT INTO conversation_index(conversation_token,payload) VALUES(?,?)", (token, encrypted))
                db.execute(
                    "INSERT INTO journal_meta(meta_key,meta_value) VALUES('conversation-index-version','2') "
                    "ON CONFLICT(meta_key) DO UPDATE SET meta_value=excluded.meta_value"
                )
                db.commit()
            return True
        except Exception as error:
            raise RuntimeError("Could not authenticate or index the encrypted message journal; data was preserved") from error

    def _journal_conversation_summaries(self):
        if not self._ensure_journal_index():
            return []
        key = self._get_state_key()
        own_key = self._global_identity()["public_key"]
        result = []
        try:
            with closing(sqlite3.connect(self.message_journal_file, timeout=10)) as db:
                rows = db.execute("SELECT conversation_token,payload FROM conversation_index").fetchall()
                for token, encrypted_index in rows:
                    descriptor = None
                    entry = self._decrypt_conversation_index(token, encrypted_index, key)
                    digest = trim_text(entry.get("latest_message_key"), 64)
                    if len(digest) != 64:
                        continue
                    stored = db.execute("SELECT payload FROM messages WHERE message_key=?", (digest,)).fetchone()
                    if not stored:
                        continue
                    message = self._decrypt_message_payload(digest, stored[0], key)
                    descriptor = self._message_conversation_descriptor(message, own_key)
                    if not descriptor or self._conversation_index_token(descriptor, key) != token:
                        raise ValueError("conversation index does not match its encrypted message")
                    normalized = self._normalize_global_message(message, own_key)
                    if normalized:
                        if descriptor[0] == "unlinked":
                            normalized["legacy_unlinked"] = True
                        result.append((descriptor, safe_int(entry.get("count")), normalized))
            return result
        except Exception as error:
            raise RuntimeError("Could not authenticate the encrypted conversation index; data was preserved") from error

    def _journal_conversation_messages(self, descriptor):
        if not self._ensure_journal_index():
            return []
        key = self._get_state_key()
        own_key = self._global_identity()["public_key"]
        token = self._conversation_index_token(descriptor, key)
        messages = []
        try:
            with closing(sqlite3.connect(self.message_journal_file, timeout=10)) as db:
                rows = db.execute(
                    "SELECT message_key,payload FROM messages WHERE conversation_token=?",
                    (token,),
                ).fetchall()
                for digest, encrypted in rows:
                    message = self._decrypt_message_payload(digest, encrypted, key)
                    actual = self._message_conversation_descriptor(message, own_key)
                    if actual != descriptor:
                        raise ValueError("message conversation index mismatch")
                    normalized = self._normalize_global_message(message, own_key)
                    if normalized:
                        if descriptor[0] == "unlinked":
                            normalized["legacy_unlinked"] = True
                        messages.append(normalized)
            messages.sort(key=lambda item: (
                safe_int(item.get("timestamp")), safe_int(item.get("received_at_ms")), trim_text(item.get("id"), 64)
            ))
            return messages
        except Exception as error:
            raise RuntimeError("Could not authenticate the selected encrypted conversation; data was preserved") from error

    def _journal_all_messages(self):
        if not self.message_journal_file.exists():
            return []
        key = self._get_state_key()
        messages = []
        hidden_ids = set(self.state.get("global", {}).get("locally_hidden_message_ids", []))
        try:
            with closing(sqlite3.connect(self.message_journal_file, timeout=10)) as db:
                for digest, encrypted in db.execute("SELECT message_key,payload FROM messages ORDER BY rowid"):
                    message = self._decrypt_message_payload(digest, encrypted, key)
                    if message.get("id") not in hidden_ids:
                        messages.append(message)
            return messages
        except Exception as error:
            raise RuntimeError("Could not authenticate the encrypted message journal; data was preserved") from error

    def save_state(self, state=None):
        if state is not None:
            self.state = state
        desired = copy.deepcopy(self.state)
        lock_file = self.state_dir / ".friends_state.lock"
        with lock_file.open("a", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            try:
                if self.state_file.exists():
                    try:
                        latest = self._read_state_file()
                    except (OSError, TypeError, ValueError) as error:
                        raise RuntimeError(f"Cannot safely update Friends state: {error}") from error
                    if not isinstance(latest, dict):
                        raise RuntimeError("Cannot safely update invalid Friends state")
                    if isinstance(self._persisted_state, dict):
                        old_blocked = set(
                            self._persisted_state.get("global", {}).get("blocked_pubkeys", [])
                        )
                        latest_blocked = set(latest.get("global", {}).get("blocked_pubkeys", []))
                        newly_blocked = latest_blocked - old_blocked
                        desired = self._merge_concurrent_value(self._persisted_state, latest, desired)
                    else:
                        newly_blocked = set()
                else:
                    newly_blocked = set()
                self._remove_blocked_state(desired, newly_blocked)
                hidden_message_ids = set(desired.get("global", {}).get("locally_hidden_message_ids", []))
                if hidden_message_ids:
                    desired.setdefault("global", {})["messages"] = [
                        item for item in desired.get("global", {}).get("messages", [])
                        if item.get("id") not in hidden_message_ids
                    ]
                self._write_state_locked(desired)
                self._replace_state_in_place(self.state, desired)
                self._persisted_state = copy.deepcopy(desired)
            finally:
                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)

    @classmethod
    def _replace_state_in_place(cls, target, source):
        """Apply merged state without invalidating nested references held by callers."""
        if isinstance(target, dict) and isinstance(source, dict):
            for key in list(target):
                if key not in source:
                    del target[key]
            for key, value in source.items():
                current = target.get(key)
                if isinstance(current, dict) and isinstance(value, dict):
                    cls._replace_state_in_place(current, value)
                elif isinstance(current, list) and isinstance(value, list):
                    current[:] = copy.deepcopy(value)
                else:
                    target[key] = copy.deepcopy(value)

    @staticmethod
    def _remove_blocked_state(state, blocked):
        global_state = state.get("global") if isinstance(state, dict) else None
        if not isinstance(global_state, dict) or not blocked:
            return
        for name in ("peers", "friendships", "memory"):
            mapping = global_state.get(name)
            if isinstance(mapping, dict):
                for public_key in blocked:
                    mapping.pop(public_key, None)
        for name in ("pings", "community"):
            entries = global_state.get(name)
            if isinstance(entries, list):
                global_state[name] = [
                    item for item in entries
                    if not isinstance(item, dict) or item.get("public_key") not in blocked
                ]

    def _write_state_locked(self, state):
        tmp_file = self.state_dir / f".friends_state.{os.getpid()}.{uuid.uuid4().hex}.tmp"
        try:
            try:
                from cryptography.hazmat.primitives.ciphers.aead import AESGCM
            except ImportError as error:
                raise RuntimeError("Install python-cryptography to encrypt Friends history") from error
            identity = state.get("global_identity") if isinstance(state.get("global_identity"), dict) else {}
            own_key = trim_text(identity.get("public_key"), 64).lower()
            if not is_valid_public_key(own_key):
                own_key = generate_keypair(identity.get("secret_key"))["public_key"]
            global_state = state.get("global", {})
            self._write_message_journal_locked(
                global_state.get("messages", []),
                own_key,
                global_state.get("locally_hidden_message_ids", []),
            )
            persisted = copy.deepcopy(state)
            if isinstance(persisted.get("global"), dict):
                persisted["global"]["messages"] = []
            plaintext = json.dumps(persisted, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
            nonce = secrets.token_bytes(12)
            ciphertext = AESGCM(self._get_state_key(create=True)).encrypt(
                nonce, plaintext, STATE_FILE_MAGIC
            )
            with tmp_file.open("wb") as state_file:
                state_file.write(STATE_FILE_MAGIC + nonce + ciphertext)
                state_file.flush()
                os.fsync(state_file.fileno())
            os.chmod(tmp_file, 0o600)
            os.replace(tmp_file, self.state_file)
            directory_fd = os.open(self.state_dir, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
            try:
                os.fsync(directory_fd)
            finally:
                os.close(directory_fd)
        except RuntimeError:
            raise
        except OSError as error:
            raise RuntimeError(f"Could not safely save Friends state: {error}") from error
        finally:
            try:
                tmp_file.unlink()
            except (FileNotFoundError, OSError):
                pass

    def get_focus_minutes(self):
        started = safe_int(self.state["profile"].get("focus_started_at"), now_seconds())
        return max(0, (now_seconds() - started) // 60)

    def _profile_status(self):
        status_id = self.state["profile"].get("status", "coding")
        return AVAILABLE_STATUSES.get(status_id, AVAILABLE_STATUSES["coding"])

    def get_public_payload(self):
        profile = self.state["profile"]
        privacy = profile.get("privacy", {})
        payload = {
            "protocol": PROTOCOL_VERSION,
            "type": "presence",
            "code": profile["code"],
            "handle": profile["handle"],
            "avatar": profile["avatar"],
            "status": profile.get("status", "coding"),
            "activity": get_active_window() if privacy.get("share_window", False) else "",
            "music": get_active_music() if privacy.get("share_music", False) else "",
            "focus_mins": self.get_focus_minutes(),
            "timestamp": now_seconds(),
        }
        if privacy.get("share_project", False):
            payload.update(
                {
                    "project_name": profile.get("project_name", ""),
                    "project_desc": profile.get("project_desc", ""),
                    "project_url": profile.get("project_url", ""),
                }
            )
        if privacy.get("share_interests", False):
            payload["interests"] = list(profile.get("interests", []))
        if privacy.get("share_room", False):
            payload["room"] = normalize_room(profile.get("room"))
        if privacy.get("share_theme", False):
            payload["theme"] = trim_text(get_current_theme(), 48)
            payload["wallpaper"] = trim_text(
                os.path.basename(get_current_wallpaper()), 100
            )
        return payload

    def _global_identity(self):
        identity = self.state.get("global_identity")
        try:
            candidate = generate_keypair(identity.get("secret_key")) if isinstance(identity, dict) else None
            if candidate and candidate["public_key"] == trim_text(identity.get("public_key"), 64).lower():
                return candidate
        except (TypeError, ValueError, OverflowError):
            pass
        identity = generate_keypair()
        self.state["global_identity"] = identity
        if self.state["profile"].get("handle") in ("", "OmarchyHacker"):
            self.state["profile"]["handle"] = generate_global_handle(identity["public_key"])
        self.save_state()
        return identity

    @staticmethod
    def _validate_blossom_server(value):
        server = trim_text(value, 512).rstrip("/")
        if not server:
            return ""
        parsed = urllib.parse.urlsplit(server)
        if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.path not in ("", "/") or parsed.query or parsed.fragment:
            raise ValueError("Use a Blossom server origin such as https://files.example")
        return f"https://{parsed.netloc}"

    def set_blossom_server(self, value):
        try:
            server = self._validate_blossom_server(value)
        except ValueError as error:
            return False, str(error)
        self.state.setdefault("global", {})["blossom_server"] = server
        self.save_state()
        return True, "Large file server saved" if server else "Large file server cleared"

    def _upload_ciphertext(self, server, file_path, file_size, checksum):
        parsed = urllib.parse.urlsplit(server)
        host = parsed.hostname
        port = parsed.port or 443
        try:
            addresses = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        except OSError as error:
            raise ValueError("Could not resolve the encrypted file server") from error
        if not addresses or any(not _public_unicast_address(address[4][0]) for address in addresses):
            raise ValueError("The encrypted file server resolves to a private or reserved network address")
        pinned_address = addresses[0][4][0]
        identity = self._global_identity()
        auth_event = build_event(
            identity["secret_key"], 24242,
            [["t", "upload"], ["expiration", str(now_seconds() + 300)], ["server", host.lower()], ["x", checksum]],
            "Omarchy Friends encrypted attachment upload",
        )
        token = base64.urlsafe_b64encode(json.dumps(auth_event, separators=(",", ":")).encode()).decode().rstrip("=")
        connection = PinnedPublicHTTPSConnection(host, port, pinned_address, timeout=120, context=ssl.create_default_context())
        try:
            connection.putrequest("PUT", "/upload")
            connection.putheader("Host", parsed.netloc)
            connection.putheader("Authorization", "Nostr " + token)
            connection.putheader("Content-Type", "application/octet-stream")
            connection.putheader("Content-Length", str(file_size))
            connection.endheaders()
            with open_regular_attachment_file(file_path) as source:
                while chunk := source.read(1024 * 1024):
                    connection.send(chunk)
            response = connection.getresponse()
            body = response.read(1024 * 1024 + 1)
            if len(body) > 1024 * 1024:
                raise ValueError("File server returned an oversized response")
            if response.status not in (200, 201):
                if response.status == 413:
                    raise ValueError("This file server does not accept files this large")
                raise ValueError(f"File upload failed (HTTP {response.status})")
            try:
                descriptor = json.loads(body.decode("utf-8"))
            except (UnicodeDecodeError, ValueError) as error:
                raise ValueError("File server returned an invalid upload response") from error
            url = trim_text(descriptor.get("url"), 2048) if isinstance(descriptor, dict) else ""
            if isinstance(descriptor, dict):
                if descriptor.get("sha256") and trim_text(descriptor.get("sha256"), 64).lower() != checksum:
                    raise ValueError("File server returned a mismatched ciphertext hash")
                if descriptor.get("size") is not None and safe_int(descriptor.get("size"), -1) != file_size:
                    raise ValueError("File server returned a mismatched ciphertext size")
            parsed_url = urllib.parse.urlsplit(url)
            if parsed_url.scheme != "https" or not parsed_url.hostname or parsed_url.username or parsed_url.password or parsed_url.fragment:
                raise ValueError("File server returned an unsafe download URL")
            return url
        except (OSError, ssl.SSLError, http.client.HTTPException) as error:
            raise ValueError(f"File upload failed: {trim_text(error, 140)}") from error
        finally:
            connection.close()

    def _upload_private_attachment(self, path, name, content_type, is_archive=False):
        server = self._validate_blossom_server(self.state.get("global", {}).get("blossom_server", ""))
        if not server:
            raise ValueError("Set a Blossom file server in Me → Large files before sending files over 16 KiB")
        try:
            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
        except ImportError as error:
            raise ValueError("Install python-cryptography to send encrypted large files") from error
        key, nonce = secrets.token_bytes(32), secrets.token_bytes(12)
        encryptor = Cipher(algorithms.AES(key), modes.GCM(nonce)).encryptor()
        cipher_path = self.state_dir / f".attachment-{uuid.uuid4().hex}.enc"
        plain_hash, cipher_hash = hashlib.sha256(), hashlib.sha256()
        plain_size = cipher_size = 0
        try:
            with open_regular_attachment_file(path) as source, cipher_path.open("xb") as encrypted:
                os.chmod(cipher_path, 0o600)
                while chunk := source.read(1024 * 1024):
                    plain_size += len(chunk)
                    if plain_size > MAX_REMOTE_ATTACHMENT_BYTES:
                        raise ValueError("Files and compressed folders are limited to 100 MiB")
                    plain_hash.update(chunk)
                    output = encryptor.update(chunk)
                    encrypted.write(output)
                    cipher_hash.update(output)
                    cipher_size += len(output)
                tail = encryptor.finalize()
                encrypted.write(tail)
                cipher_hash.update(tail)
                cipher_size += len(tail)
                encrypted.write(encryptor.tag)
                cipher_hash.update(encryptor.tag)
                cipher_size += len(encryptor.tag)
                encrypted.flush()
                os.fsync(encrypted.fileno())
            if not plain_size:
                raise ValueError("Empty files cannot be attached")
            checksum = cipher_hash.hexdigest()
            url = self._upload_ciphertext(server, cipher_path, cipher_size, checksum)
            return {
                "transport": "blossom", "name": safe_attachment_name(name),
                "content_type": trim_text(content_type, 100) or "application/octet-stream",
                "size": plain_size, "cipher_size": cipher_size, "sha256": checksum,
                "plain_sha256": plain_hash.hexdigest(), "url": url,
                "key": base64.urlsafe_b64encode(key).decode().rstrip("="),
                "nonce": base64.urlsafe_b64encode(nonce).decode().rstrip("="),
                "is_archive": is_archive,
            }
        except OSError as error:
            raise ValueError("Could not prepare the encrypted attachment") from error
        finally:
            try:
                cipher_path.unlink()
            except OSError:
                pass

    def _prepare_private_attachment(self, path, is_folder=False):
        if not path:
            return None
        original = Path(os.path.abspath(os.path.expanduser(str(path))))
        if original.is_symlink():
            raise ValueError("Symbolic links cannot be attached")
        source = original
        temporary_zip = None
        is_archive = bool(is_folder)
        try:
            if is_folder:
                if not original.is_dir():
                    raise ValueError("Choose a folder that still exists")
                import tempfile
                fd, temp_name = tempfile.mkstemp(prefix=".folder-", suffix=".zip", dir=self.state_dir)
                os.close(fd)
                temporary_zip = source = Path(temp_name)
                os.chmod(source, 0o600)
                with zipfile.ZipFile(source, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
                    _append_private_folder_to_zip(
                        original, archive, MAX_PRIVATE_FOLDER_SOURCE_BYTES, MAX_REMOTE_ATTACHMENT_BYTES
                    )
            if not source.is_file():
                raise ValueError("Choose a file that still exists")
            size = source.stat().st_size
            if size > MAX_REMOTE_ATTACHMENT_BYTES:
                raise ValueError("Files and compressed folders are limited to 100 MiB")
            name = safe_attachment_name(original.name) + (".zip" if is_archive else "")
            content_type = "application/zip" if is_archive else (mimetypes.guess_type(name)[0] or "application/octet-stream")
            if size <= MAX_PRIVATE_ATTACHMENT_BYTES:
                attachment = read_private_attachment(source)
                if is_archive:
                    attachment.update({"name": name, "content_type": content_type, "is_archive": True})
                return attachment
            return self._upload_private_attachment(source, name, content_type, is_archive)
        except OSError as error:
            raise ValueError("Could not read that file or folder") from error
        finally:
            if temporary_zip:
                try:
                    temporary_zip.unlink()
                except OSError:
                    pass

    def _global_presence_content(self):
        profile = self.state["profile"]
        privacy = profile.get("privacy", {})
        content = {
            "app": "omarchy-friends",
            "v": 1,
            "plugin_version": PLUGIN_VERSION,
            "capabilities": list(GLOBAL_CAPABILITIES),
            "dm_relays": list(NIP17_DM_RELAYS),
            "type": "presence",
            "handle": trim_text(profile.get("handle"), 24) or "Omarchy Builder",
            "avatar": profile.get("avatar") if profile.get("avatar") in AVAILABLE_AVATARS else "👾",
            "status": profile.get("status", "coding"),
            "focus_mins": self.get_focus_minutes(),
            "timestamp": now_seconds(),
        }
        if privacy.get("share_window", False):
            content["activity"] = get_active_window()
        if privacy.get("share_music", False):
            content["music"] = get_active_music()
        if privacy.get("share_project", False):
            content.update(
                {
                    "project_name": profile.get("project_name", ""),
                    "project_desc": profile.get("project_desc", ""),
                    "project_url": profile.get("project_url", ""),
                }
            )
        if privacy.get("share_interests", False):
            content["interests"] = list(profile.get("interests", []))
        if privacy.get("share_room", False):
            content["room"] = normalize_room(profile.get("room"))
        if privacy.get("share_theme", False):
            content["theme"] = trim_text(get_current_theme(), 48)
            content["wallpaper"] = trim_text(os.path.basename(get_current_wallpaper()), 100)
        return content

    def _fresh_global_presence_event(self, presence_event):
        """Reuse signed presence between refreshes, replacing only its timestamp."""
        content = json.loads(presence_event.get("content", "{}"))
        content["timestamp"] = now_seconds()
        return build_event(
            self._global_identity()["secret_key"],
            GLOBAL_PRESENCE_KIND,
            presence_event.get("tags", []),
            json.dumps(content, ensure_ascii=False, separators=(",", ":")),
        )

    def _global_presence_event(self):
        identity = self._global_identity()
        content = json.dumps(
            self._global_presence_content(),
            ensure_ascii=False,
            separators=(",", ":"),
        )
        return build_event(
            identity["secret_key"],
            GLOBAL_PRESENCE_KIND,
            [
                ["d", GLOBAL_PRESENCE_TAG],
                ["t", "omarchy-friends"],
                ["alt", "Omarchy Friends online presence"],
            ],
            content,
        )

    @staticmethod
    def _event_tag_values(event, name):
        return [
            tag[1]
            for tag in event.get("tags", [])
            if isinstance(tag, list) and len(tag) >= 2 and tag[0] == name and isinstance(tag[1], str)
        ]

    def _global_peer_from_event(self, event):
        if not verify_event(event) or int(event.get("kind", -1)) != GLOBAL_PRESENCE_KIND:
            return None
        if event.get("pubkey") == self._global_identity()["public_key"]:
            return None
        if GLOBAL_PRESENCE_TAG not in self._event_tag_values(event, "d"):
            return None
        if "omarchy-friends" not in self._event_tag_values(event, "t"):
            return None
        try:
            content = json.loads(event.get("content", "{}"))
        except (TypeError, ValueError):
            return None
        if not isinstance(content, dict) or content.get("app") != "omarchy-friends" or content.get("type") != "presence":
            return None
        created_at = safe_int(event.get("created_at"))
        if created_at < now_seconds() - GLOBAL_PEER_TTL_SECONDS or created_at > now_seconds() + 30:
            return None
        return self._normalize_global_peer(
            {
                **content,
                "public_key": event.get("pubkey"),
                "last_seen": created_at,
                "online": True,
            }
        )

    def _global_ping_from_event(self, event):
        if not verify_event(event) or int(event.get("kind", -1)) != GLOBAL_PING_KIND:
            return None
        if GLOBAL_PING_TAG not in self._event_tag_values(event, "t"):
            return None
        identity = self._global_identity()
        if identity["public_key"] not in self._event_tag_values(event, "p"):
            return None
        created_at = safe_int(event.get("created_at"))
        if created_at < now_seconds() - 900 or created_at > now_seconds() + 30:
            return None
        try:
            content = json.loads(event.get("content", "{}"))
        except (TypeError, ValueError):
            return None
        if not isinstance(content, dict) or content.get("app") != "omarchy-friends" or content.get("type") != "ping":
            return None
        return self._normalize_global_ping(
            {
                **content,
                "id": event.get("id"),
                "public_key": event.get("pubkey"),
                "timestamp": created_at,
            }
        )

    def _message_from_private_envelope(self, sender, message_id, timestamp, envelope, fallback_text=""):
        identity = self._global_identity()
        own_key = identity["public_key"]
        friendship = self.state.get("global", {}).get("friendships", {}).get(sender, {})
        if sender != own_key and friendship.get("status") != "friends":
            return None
        handle = (
            self.state.get("profile", {}).get("handle", "You")
            if sender == own_key
            else friendship.get("handle", "A friend")
        )
        text = fallback_text
        media = []
        attachments = []
        group_id = ""
        group_name = ""
        message_type = "direct"
        group_payload = None
        reply_to = None
        reaction_target_id = ""
        delete_target_id = ""
        edit_target_id = ""
        read_receipt_target_ids = []

        if isinstance(envelope, dict):
            version = safe_int(envelope.get("v"))
            if version == 3 and envelope.get("type") == "delete":
                message_type = "delete"
                group_id = trim_text(envelope.get("group_id"), 40).lower()
                delete_target_id = trim_text(envelope.get("target_id"), 64).lower()
                if not re.fullmatch(r"[0-9a-f]{64}", delete_target_id):
                    return None
                group = self.state.get("global", {}).get("groups", {}).get(group_id) if group_id else None
                if group_id and (not group or sender not in group.get("members", {})):
                    return None
                text = "Message deleted"
            elif version == 3 and envelope.get("type") == "read_receipt":
                message_type = "read_receipt"
                group_id = trim_text(envelope.get("group_id"), 40).lower()
                group = self.state.get("global", {}).get("groups", {}).get(group_id) if group_id else None
                if group_id and (not group or sender not in group.get("members", {})):
                    return None
                raw_targets = envelope.get("target_ids")
                if not isinstance(raw_targets, list) or not raw_targets or len(raw_targets) > MAX_READ_RECEIPT_TARGETS:
                    return None
                read_receipt_target_ids = list(dict.fromkeys(
                    trim_text(value, 64).lower() for value in raw_targets
                    if re.fullmatch(r"[0-9a-f]{64}", trim_text(value, 64).lower())
                ))
                if not read_receipt_target_ids:
                    return None
                text = ""
            elif version == 3 and envelope.get("type") == "edit":
                message_type = "edit"
                group_id = trim_text(envelope.get("group_id"), 40).lower()
                edit_target_id = trim_text(envelope.get("target_id"), 64).lower()
                if not re.fullmatch(r"[0-9a-f]{64}", edit_target_id):
                    return None
                group = self.state.get("global", {}).get("groups", {}).get(group_id) if group_id else None
                if group_id and (not group or sender not in group.get("members", {})):
                    return None
                text = envelope.get("text", "")
            elif version == 3 and envelope.get("type") == "reaction":
                message_type = "reaction"
                group_id = trim_text(envelope.get("group_id"), 40).lower()
                reaction_emoji = envelope.get("emoji")
                reaction_target_id = trim_text(envelope.get("target_id"), 64).lower()
                if reaction_emoji not in ALLOWED_MESSAGE_REACTIONS or not re.fullmatch(r"[0-9a-f]{64}", reaction_target_id):
                    return None
                group = self.state.get("global", {}).get("groups", {}).get(group_id) if group_id else None
                if group_id and (not group or sender not in group.get("members", {})):
                    return None
                text = reaction_emoji
            elif version in (1, 3) and envelope.get("type") in (None, "", "direct"):
                message_type = "direct"
                text = envelope.get("text", fallback_text)
                media = normalize_media_items(envelope.get("media"))
                attachments = normalize_private_attachments(envelope.get("attachments"))
            elif version in (2, 3):
                message_type = trim_text(envelope.get("type"), 24)
                group_id = trim_text(envelope.get("group_id"), 40).lower()
                group_payload = envelope.get("group") if isinstance(envelope.get("group"), dict) else None
                if message_type == "group_invite":
                    normalized_group = self._normalize_group(group_id, group_payload or {})
                    if not normalized_group or sender not in normalized_group["members"]:
                        return None
                    group_name = normalized_group["name"]
                    text = f"You were invited to {group_name}"
                elif message_type == "group_message":
                    group = self.state.get("global", {}).get("groups", {}).get(group_id)
                    if not group or sender not in group.get("members", {}):
                        return None
                    group_name = group.get("name", "Group")
                    text = envelope.get("text", fallback_text)
                    media = normalize_media_items(envelope.get("media"))
                    attachments = normalize_private_attachments(envelope.get("attachments"))
                else:
                    return None

            raw_reply = envelope.get("reply_to")
            if isinstance(raw_reply, dict):
                reply_id = trim_text(raw_reply.get("id"), 64).lower()
                if re.fullmatch(r"[0-9a-f]{64}", reply_id):
                    reply_to = {
                        "id": reply_id,
                        "handle": trim_text(raw_reply.get("handle"), 24) or "Message",
                        "text": trim_text(raw_reply.get("text"), 240),
                    }
            reaction_target_id = trim_text(envelope.get("target_id"), 64).lower() if message_type == "reaction" else ""
            delete_target_id = trim_text(envelope.get("target_id"), 64).lower() if message_type == "delete" else ""
            edit_target_id = trim_text(envelope.get("target_id"), 64).lower() if message_type == "edit" else ""

        text = trim_text(text, 2000)
        if not text and not media and not attachments and message_type == "direct":
            return None
        return {
            "id": trim_text(message_id, 64).lower(),
            "public_key": sender,
            "conversation_key": sender if not group_id else "",
            "handle": trim_text(handle, 24) or ("You" if sender == own_key else "A friend"),
            "group_id": group_id,
            "group_name": group_name,
            "message_type": message_type,
            "group": group_payload,
            "text": text,
            "media": media,
            "attachments": attachments,
            "reply_to": reply_to,
            "reaction_target_id": reaction_target_id,
            "delete_target_id": delete_target_id,
            "edit_target_id": edit_target_id,
            "read_receipt_target_ids": read_receipt_target_ids,
            "deleted": message_type == "delete",
            "timestamp": safe_int(timestamp, now_seconds()),
            "incoming": sender != own_key,
        }

    @staticmethod
    def _valid_nip17_file_rumor(rumor, envelope):
        if not isinstance(envelope, dict) or not isinstance(envelope.get("attachments"), list) or len(envelope["attachments"]) != 1:
            return False
        attachment = envelope["attachments"][0]
        if not isinstance(attachment, dict) or attachment.get("transport") != "blossom":
            return False
        values = {}
        for tag in rumor.get("tags", []) if isinstance(rumor, dict) else []:
            if isinstance(tag, list) and len(tag) >= 2 and tag[0] in ("file-type", "encryption-algorithm", "decryption-key", "decryption-nonce", "x", "size"):
                if tag[0] in values:
                    return False
                values[tag[0]] = tag[1]
        expected = {
            "file-type": attachment.get("content_type"),
            "encryption-algorithm": "aes-gcm",
            "decryption-key": attachment.get("key"),
            "decryption-nonce": attachment.get("nonce"),
            "x": attachment.get("sha256"),
            "size": str(attachment.get("cipher_size", "")),
        }
        return (
            values == expected
            and rumor.get("content") == attachment.get("url")
            and isinstance(rumor.get("content"), str)
        )

    @staticmethod
    def _standard_nip17_file_attachment(rumor):
        """Parse a standard encrypted NIP-17 file into the safe download shape."""
        if not isinstance(rumor, dict) or not isinstance(rumor.get("content"), str):
            return None
        url = rumor["content"]
        parsed = urllib.parse.urlsplit(url)
        if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.fragment:
            return None
        values = {}
        for tag in rumor.get("tags", []):
            if not isinstance(tag, list) or len(tag) < 2:
                continue
            name, value = tag[0], tag[1]
            if name in ("file-type", "encryption-algorithm", "decryption-key", "decryption-nonce", "x", "ox", "size"):
                if name in values or not isinstance(value, str):
                    return None
                values[name] = value
        required = ("file-type", "encryption-algorithm", "decryption-key", "decryption-nonce", "x", "size")
        if any(name not in values for name in required) or values["encryption-algorithm"] != "aes-gcm":
            return None
        if not re.fullmatch(r"[0-9a-f]{64}", values["x"]):
            return None
        if values.get("ox") and not re.fullmatch(r"[0-9a-f]{64}", values["ox"]):
            return None
        if not values["file-type"] or len(values["file-type"]) > 100 or any(ord(c) < 32 for c in values["file-type"]):
            return None
        if not re.fullmatch(r"[A-Za-z0-9_-]{43}", values["decryption-key"]):
            return None
        if not re.fullmatch(r"[A-Za-z0-9_-]{16}", values["decryption-nonce"]):
            return None
        try:
            key = base64.urlsafe_b64decode(values["decryption-key"] + "=")
            nonce = base64.urlsafe_b64decode(values["decryption-nonce"] + "==")
            cipher_size = int(values["size"])
        except (ValueError, base64.binascii.Error):
            return None
        if len(key) != 32 or len(nonce) != 12 or str(cipher_size) != values["size"]:
            return None
        if cipher_size < 16 or cipher_size > MAX_REMOTE_ATTACHMENT_BYTES + 16:
            return None
        filename = safe_attachment_name(Path(urllib.parse.unquote(parsed.path)).name or "shared-file")
        return {
            "transport": "blossom", "name": filename, "content_type": values["file-type"],
            "size": cipher_size - 16, "cipher_size": cipher_size, "sha256": values["x"],
            "plain_sha256": values.get("ox", ""), "standard_nip17": True, "url": url,
            "key": values["decryption-key"], "nonce": values["decryption-nonce"], "is_archive": False,
        }

    def _global_dm_from_event(self, event):
        identity = self._global_identity()
        try:
            event_kind = int(event.get("kind", -1)) if isinstance(event, dict) else -1
        except (TypeError, ValueError, OverflowError):
            return None
        if isinstance(event, dict) and event_kind == NIP59_GIFT_WRAP_KIND:
            try:
                rumor = unwrap_nip17_gift_wrap(identity["secret_key"], event)
            except (KeyError, TypeError, ValueError, UnicodeError, json.JSONDecodeError):
                return None
            sender = trim_text(rumor.get("pubkey"), 64).lower()
            if not is_valid_public_key(sender):
                return None
            own_key = identity["public_key"]
            rumor_receivers = self._event_tag_values(rumor, "p")
            if sender != own_key and own_key not in rumor_receivers:
                return None
            envelope = app_envelope_from_rumor(rumor)
            if rumor.get("kind") == NIP17_FILE_KIND:
                has_friends_envelope = any(
                    isinstance(tag, list) and len(tag) >= 2 and tag[0] == "omarchy-envelope"
                    for tag in rumor.get("tags", [])
                )
                if has_friends_envelope:
                    if not self._valid_nip17_file_rumor(rumor, envelope):
                        return None
                else:
                    recipients = list(dict.fromkeys(self._event_tag_values(rumor, "p")))
                    if len(recipients) != 1 or recipients[0] != own_key:
                        return None
                    attachment = self._standard_nip17_file_attachment(rumor)
                    if not attachment:
                        return None
                    envelope = {"v": 3, "type": "direct", "text": f"Shared {attachment['name']}", "attachments": [attachment]}
            if rumor.get("kind") == NIP17_REACTION_KIND:
                if not isinstance(envelope, dict) or envelope.get("type") != "reaction":
                    return None
            elif rumor.get("kind") == NIP17_DELETE_KIND:
                if not isinstance(envelope, dict) or envelope.get("type") != "delete":
                    return None
            elif isinstance(envelope, dict) and envelope.get("type") == "reaction":
                return None
            elif isinstance(envelope, dict) and envelope.get("type") == "delete":
                return None
            if isinstance(envelope, dict) and isinstance(envelope.get("reply_to"), dict):
                reply_id = trim_text(envelope["reply_to"].get("id"), 64).lower()
                if reply_id and reply_id not in self._event_tag_values(rumor, "e"):
                    return None
            if isinstance(envelope, dict) and envelope.get("type") == "reaction":
                reaction_target_id = trim_text(envelope.get("target_id"), 64).lower()
                if reaction_target_id and reaction_target_id not in self._event_tag_values(rumor, "e"):
                    return None
            if isinstance(envelope, dict) and envelope.get("type") == "delete":
                delete_target_id = trim_text(envelope.get("target_id"), 64).lower()
                if delete_target_id and delete_target_id not in self._event_tag_values(rumor, "e"):
                    return None
            if isinstance(envelope, dict) and envelope.get("type") == "edit":
                edit_target_id = trim_text(envelope.get("target_id"), 64).lower()
                if edit_target_id and edit_target_id not in self._event_tag_values(rumor, "e"):
                    return None
            return self._message_from_private_envelope(
                sender,
                rumor.get("id"),
                rumor.get("created_at"),
                envelope,
                rumor.get("content", ""),
            )

        if not verify_event(event) or int(event.get("kind", -1)) != GLOBAL_DM_KIND:
            return None
        if (
            GLOBAL_DM_TAG not in self._event_tag_values(event, "t")
            or identity["public_key"] not in self._event_tag_values(event, "p")
        ):
            return None
        sender = trim_text(event.get("pubkey"), 64).lower()
        friendship = self.state.get("global", {}).get("friendships", {}).get(sender, {})
        if friendship.get("status") != "friends":
            return None
        try:
            payload = json.loads(event.get("content", "{}"))
            decrypted = decrypt_private_text(identity["secret_key"], sender, payload)
        except (KeyError, TypeError, ValueError, UnicodeError, base64.binascii.Error):
            return None
        try:
            envelope = json.loads(decrypted)
        except (TypeError, ValueError):
            envelope = None
        if isinstance(envelope, dict) and envelope.get("type") == "reaction":
            reaction_target_id = trim_text(envelope.get("target_id"), 64).lower()
            if reaction_target_id and reaction_target_id not in self._event_tag_values(event, "e"):
                return None
        if isinstance(envelope, dict) and envelope.get("type") == "delete":
            delete_target_id = trim_text(envelope.get("target_id"), 64).lower()
            if delete_target_id and delete_target_id not in self._event_tag_values(event, "e"):
                return None
        if isinstance(envelope, dict) and envelope.get("type") == "edit":
            edit_target_id = trim_text(envelope.get("target_id"), 64).lower()
            if edit_target_id and edit_target_id not in self._event_tag_values(event, "e"):
                return None
        return self._message_from_private_envelope(
            sender,
            event.get("id"),
            event.get("created_at"),
            envelope,
            decrypted,
        )

    def _global_community_from_event(self, event):
        if not verify_event(event) or int(event.get("kind", -1)) != GLOBAL_COMMUNITY_KIND:
            return None
        if GLOBAL_COMMUNITY_TAG not in self._event_tag_values(event, "t"):
            return None
        created_at = safe_int(event.get("created_at"))
        if created_at < now_seconds() - 86400 or created_at > now_seconds() + 30:
            return None
        try:
            content = json.loads(event.get("content", "{}"))
        except (TypeError, ValueError):
            return None
        if not isinstance(content, dict) or content.get("app") != "omarchy-friends" or content.get("type") != "community":
            return None
        message = self._normalize_community_message({
            **content,
            "id": event.get("id"),
            "public_key": event.get("pubkey"),
            "timestamp": created_at,
            "incoming": True,
        })
        return message

    def _allow_global_signal(self, public_key, category="signal"):
        category = "private" if category == "private" else "signal"
        cutoff = now_seconds() - 60
        global_state = self.state.setdefault("global", {})
        receipts = [
            item
            for item in global_state.get("incoming_receipts", [])
            if safe_int(item.get("timestamp")) >= cutoff
        ]
        limit = MAX_INCOMING_PRIVATE_MESSAGES_PER_MINUTE if category == "private" else MAX_INCOMING_SIGNALS_PER_MINUTE
        if sum(
            1 for item in receipts
            if item.get("public_key") == public_key
            and (item.get("category") or "signal") == category
        ) >= limit:
            global_state["incoming_receipts"] = receipts[-MAX_SIGNAL_RECEIPTS:]
            return False
        receipts.append({"public_key": public_key, "timestamp": now_seconds(), "category": category})
        global_state["incoming_receipts"] = receipts[-MAX_SIGNAL_RECEIPTS:]
        return True

    def _normalize_memory_entry(self, public_key, entry):
        public_key = trim_text(public_key, 64).lower()
        if not is_valid_public_key(public_key) or not isinstance(entry, dict):
            return None
        avatar = entry.get("avatar")
        if avatar not in AVAILABLE_AVATARS:
            avatar = generate_global_avatar(public_key)
        now = now_seconds()
        first_seen = safe_int(entry.get("first_seen")) or safe_int(entry.get("last_seen")) or now
        last_seen = safe_int(entry.get("last_seen")) or first_seen
        return {
            "handle": trim_text(entry.get("handle"), 24) or generate_global_handle(public_key),
            "avatar": avatar,
            "first_seen": first_seen,
            "last_seen": last_seen,
            "encounters": safe_int(entry.get("encounters"), maximum=100000),
            "waves_sent": safe_int(entry.get("waves_sent"), maximum=100000),
            "waves_received": safe_int(entry.get("waves_received"), maximum=100000),
            "sparks_sent": safe_int(entry.get("sparks_sent"), maximum=100000),
            "sparks_received": safe_int(entry.get("sparks_received"), maximum=100000),
            "chats_requested": safe_int(entry.get("chats_requested"), maximum=100000),
            "chats_received": safe_int(entry.get("chats_received"), maximum=100000),
            "friends_since": safe_int(entry.get("friends_since")),
            "dms_sent": safe_int(entry.get("dms_sent"), maximum=100000),
            "dms_received": safe_int(entry.get("dms_received"), maximum=100000),
            "focus_shared": safe_int(entry.get("focus_shared"), maximum=100000),
            "focus_streak": safe_int(entry.get("focus_streak"), maximum=3650),
            "focus_last_day": safe_int(entry.get("focus_last_day")),
            "last_action": trim_text(entry.get("last_action"), 16),
            "last_direction": trim_text(entry.get("last_direction"), 8) if trim_text(entry.get("last_direction"), 8) in ("sent", "received") else "",
            "last_at": safe_int(entry.get("last_at")),
        }

    def _touch_memory(self, public_key, handle="", avatar="", encounter=False):
        """Record a local-only sighting of a world peer. Never published."""
        public_key = trim_text(public_key, 64).lower()
        if not is_valid_public_key(public_key):
            return None
        try:
            if public_key == self._global_identity()["public_key"]:
                return None
        except (TypeError, ValueError):
            return None
        global_state = self.state.setdefault("global", {})
        if public_key in global_state.get("blocked_pubkeys", []):
            return None
        memory = global_state.setdefault("memory", {})
        entry = memory.get(public_key)
        now = now_seconds()
        if entry is None:
            entry = self._normalize_memory_entry(public_key, {
                "handle": handle,
                "avatar": avatar,
                "first_seen": now,
                "last_seen": now,
            })
            memory[public_key] = entry
        if handle:
            entry["handle"] = trim_text(handle, 24) or entry["handle"]
        if avatar and avatar in AVAILABLE_AVATARS:
            entry["avatar"] = avatar
        entry["last_seen"] = now
        if encounter:
            entry["encounters"] = safe_int(entry.get("encounters")) + 1
        if len(memory) > MAX_MEMORY_PEERS:
            ordered = sorted(memory.items(), key=lambda kv: safe_int(kv[1].get("last_seen")))
            for old_key, _ in ordered[: len(memory) - MAX_MEMORY_PEERS]:
                memory.pop(old_key, None)
        return entry

    def _remember_memory_signal(self, public_key, action, direction, handle="", avatar=""):
        entry = self._touch_memory(public_key, handle, avatar)
        if entry is None:
            return None
        action = trim_text(action, 16)
        if direction not in ("sent", "received"):
            return entry
        now = now_seconds()
        entry["last_action"] = action
        entry["last_direction"] = direction
        entry["last_at"] = now
        entry["last_seen"] = now
        suffix = "received" if direction == "received" else "sent"
        if action == "spark":
            entry["sparks_" + suffix] = safe_int(entry.get("sparks_" + suffix)) + 1
        elif action in ("friend_request", "friend_accept"):
            if direction == "sent" and action == "friend_request":
                entry["chats_requested"] = safe_int(entry.get("chats_requested")) + 1
            elif direction == "received" and action == "friend_request":
                entry["chats_received"] = safe_int(entry.get("chats_received")) + 1
            if action == "friend_accept" and not safe_int(entry.get("friends_since")):
                entry["friends_since"] = now
        elif action in ("focus", "focus_accept"):
            if action == "focus_accept":
                entry["focus_shared"] = safe_int(entry.get("focus_shared")) + 1
                day = now // 86400
                last_day = safe_int(entry.get("focus_last_day"))
                if last_day == day - 1:
                    entry["focus_streak"] = safe_int(entry.get("focus_streak")) + 1
                elif last_day != day:
                    entry["focus_streak"] = 1
                entry["focus_last_day"] = day
            else:
                entry["waves_" + suffix] = safe_int(entry.get("waves_" + suffix)) + 1
        elif action == "focus_cancel":
            entry["waves_" + suffix] = safe_int(entry.get("waves_" + suffix)) + 1
        elif action == "dm":
            entry["dms_" + suffix] = safe_int(entry.get("dms_" + suffix)) + 1
        else:
            entry["waves_" + suffix] = safe_int(entry.get("waves_" + suffix)) + 1
        return entry

    def _mark_friends_memory(self, public_key, handle="", avatar=""):
        entry = self._touch_memory(public_key, handle, avatar)
        if entry is None:
            return None
        if not safe_int(entry.get("friends_since")):
            entry["friends_since"] = now_seconds()
        return entry

    @staticmethod
    def _memory_summary(entry):
        if not isinstance(entry, dict):
            return {"familiar": False, "exchanges": 0, "summary": ""}
        exchanges = (
            safe_int(entry.get("waves_sent"))
            + safe_int(entry.get("waves_received"))
            + safe_int(entry.get("sparks_sent"))
            + safe_int(entry.get("sparks_received"))
            + safe_int(entry.get("chats_requested"))
            + safe_int(entry.get("chats_received"))
            + safe_int(entry.get("dms_sent"))
            + safe_int(entry.get("dms_received"))
            + safe_int(entry.get("focus_shared"))
        )
        familiar = bool(safe_int(entry.get("encounters")) > 1 or exchanges > 0 or safe_int(entry.get("friends_since")))
        summary = ""
        streak = safe_int(entry.get("focus_streak"))
        if familiar:
            parts = []
            if exchanges > 0:
                parts.append(f"{exchanges} exchange{'s' if exchanges != 1 else ''}")
            elif safe_int(entry.get("encounters")) > 1:
                parts.append(f"seen {safe_int(entry.get('encounters'))}x")
            if safe_int(entry.get("friends_since")):
                parts.append("friends")
            if streak >= 2:
                parts.append(f"🔥 {streak}-day focus streak")
            last_at = safe_int(entry.get("last_at") or entry.get("last_seen"))
            if last_at:
                parts.append(f"last {trim_text(entry.get('last_action'), 16) or 'seen'} {format_age(last_at)}")
            summary = " · ".join(parts)
        return {
            "familiar": familiar,
            "exchanges": exchanges,
            "encounters": safe_int(entry.get("encounters")),
            "friends_since": safe_int(entry.get("friends_since")),
            "focus_streak": streak,
            "last_action": trim_text(entry.get("last_action"), 16),
            "last_direction": entry.get("last_direction") if entry.get("last_direction") in ("sent", "received") else "",
            "last_at": safe_int(entry.get("last_at") or entry.get("last_seen")),
            "last_ago": format_age(safe_int(entry.get("last_at") or entry.get("last_seen"))) if safe_int(entry.get("last_at") or entry.get("last_seen")) else "never",
            "first_seen": safe_int(entry.get("first_seen")),
            "summary": summary,
        }

    def _cleanup_global_peers(self):
        cutoff = now_seconds() - GLOBAL_PEER_TTL_SECONDS
        global_state = self.state.setdefault("global", {})
        blocked = set(global_state.get("blocked_pubkeys", []))
        global_state["peers"] = {
            key: dict(peer, online=True)
            for key, peer in global_state.get("peers", {}).items()
            if is_valid_public_key(key)
            and key not in blocked
            and isinstance(peer, dict)
            and safe_int(peer.get("last_seen")) >= cutoff
        }
        global_state["pings"] = [
            item
            for item in global_state.get("pings", [])
            if isinstance(item, dict) and not item.get("public_key") in blocked
        ][-GLOBAL_MAX_PINGS:]
        for item in global_state["pings"]:
            item["time_ago"] = format_age(item.get("timestamp"))

    def _global_peers(self):
        self._cleanup_global_peers()
        profile = self.state["profile"]
        active_app = get_active_window() if profile.get("privacy", {}).get("share_window", False) else ""
        memory = self.state.get("global", {}).get("memory", {})
        peers = []
        for peer in self.state.get("global", {}).get("peers", {}).values():
            item = dict(peer, online=True)
            item["same_room"] = self._same_room(item)
            item["common_ground"] = self._common_ground(item, active_app)
            item["icebreaker"] = self._icebreaker(item)
            entry = memory.get(item.get("public_key"), {})
            item["memory"] = self._memory_summary(entry) if entry else {"familiar": False, "exchanges": 0, "encounters": 0, "friends_since": 0, "focus_streak": 0, "last_action": "", "last_direction": "", "last_at": 0, "last_ago": "never", "first_seen": 0, "summary": ""}
            peers.append(item)
        own_interests = set(profile.get("interests", []))
        peers.sort(
            key=lambda item: (
                -int(self._same_room(item)),
                -len(own_interests.intersection(item.get("interests", []))),
                -safe_int(item.get("last_seen")),
                item.get("handle", "").casefold(),
            )
        )
        return peers[:GLOBAL_MAX_PEERS]

    @staticmethod
    def _world_prompt():
        day_number = now_seconds() // 86400
        return WORLD_PROMPTS[day_number % len(WORLD_PROMPTS)]

    def _least_recently_pinged(self, peers):
        """Rotate automatic signals across builders instead of hammering peers[0]."""
        sent = {
            item.get("public_key"): safe_int(item.get("timestamp"))
            for item in self.state.get("global", {}).get("sent_pings", [])
            if isinstance(item, dict)
        }
        return min(peers, key=lambda peer: (sent.get(peer.get("public_key"), 0), peer.get("handle", "")))

    def global_spark(self):
        """Choose the most promising real peer and send a bounded opener."""
        peers = self._global_peers()
        if not peers:
            return False, "No builders are online yet — refresh the World in a moment"
        peer = self._least_recently_pinged(peers)
        prompt = peer.get("icebreaker") or self._world_prompt()
        ok, message = self.global_ping(peer["public_key"], "spark", prompt)
        if ok:
            return True, f"Spark sent to {peer.get('handle', 'a builder')} · {prompt}"
        return False, message

    def request_friend(self, public_key):
        public_key = trim_text(public_key, 64).lower()
        friendships = self.state.setdefault("global", {}).setdefault("friendships", {})
        if friendships.get(public_key, {}).get("status") in ("pending", "friends"):
            return False, "Friend request already sent"
        request_id = uuid.uuid4().hex
        ok, message = self.global_ping(public_key, "friend_request", session_id=request_id, allow_offline=True)
        if not ok:
            return False, message
        peer = self.state["global"]["peers"].get(public_key, {})
        handle = peer.get("handle") or generate_global_handle(public_key)
        avatar = peer.get("avatar") or generate_global_avatar(public_key)
        friendships[public_key] = {"status": "pending", "request_id": request_id, "handle": handle, "avatar": avatar}
        needs_update = peer and not bool(peer.get("can_chat"))
        if needs_update:
            self.global_ping(
                public_key,
                "hello",
                "Update to unlock chat: omarchy plugin update community.omarchy-friends --yes",
                allow_offline=True,
            )
        self.save_state()
        if needs_update:
            return True, "Chat invite sent — they need to update Omarchy Friends before accepting"
        return True, "Chat invite sent"

    def request_friend_direct(self, public_key):
        """Send a chat invite from a copied invite link, even if World has not cached the peer."""
        public_key = trim_text(public_key, 64).lower()
        if not is_valid_public_key(public_key):
            return False, "That invite link is not valid"
        if public_key == self._global_identity()["public_key"]:
            return False, "You cannot invite yourself"
        friendships = self.state.setdefault("global", {}).setdefault("friendships", {})
        if friendships.get(public_key, {}).get("status") in ("pending", "friends"):
            return False, "Chat invite already sent"
        request_id = uuid.uuid4().hex
        ok, message = self.global_ping(public_key, "friend_request", session_id=request_id, allow_offline=True)
        if not ok:
            return False, message
        self.global_ping(
            public_key,
            "hello",
            "Open Omarchy Friends to accept this chat invite (update first if needed).",
            allow_offline=True,
        )
        friendships[public_key] = {
            "status": "pending",
            "request_id": request_id,
            "handle": generate_global_handle(public_key),
            "avatar": generate_global_avatar(public_key),
        }
        self.save_state()
        return True, "Chat invite sent from invite link"

    def accept_friend_request(self, ping_id):
        ping = next((item for item in self.state.get("global", {}).get("pings", []) if item.get("id") == trim_text(ping_id, 64).lower()), None)
        if not ping or ping.get("action") != "friend_request":
            return False, "That friend request is no longer available"
        ok, message = self.global_ping(ping["public_key"], "friend_accept", session_id=ping.get("session_id"), allow_offline=True)
        if not ok:
            return False, message
        self.state["global"].setdefault("friendships", {})[ping["public_key"]] = {"status": "friends", "handle": ping.get("handle", "A builder"), "avatar": ping.get("avatar", "👾")}
        self.state["global"]["pings"] = [item for item in self.state["global"]["pings"] if item.get("id") != ping_id]
        self._remember_handled_friend_request(ping)
        self.state["stats"]["friends_made"] += 1
        self._mark_friends_memory(ping["public_key"], ping.get("handle", ""), ping.get("avatar", ""))
        self.save_state()
        return True, "You are now friends"

    def decline_friend_request(self, ping_id):
        """Decline one incoming request and notify the original sender."""
        ping_id = trim_text(ping_id, 64).lower()
        pings = self.state.setdefault("global", {}).setdefault("pings", [])
        ping = next((item for item in pings if item.get("id") == ping_id), None)
        if not ping or ping.get("action") != "friend_request":
            return False, "That friend request is no longer available"
        ok, message = self.global_ping(
            ping["public_key"],
            "friend_decline",
            session_id=ping.get("session_id"),
            allow_offline=True,
        )
        if not ok:
            return False, message
        self.state["global"]["pings"] = [item for item in pings if item.get("id") != ping_id]
        self._remember_handled_friend_request(ping)
        self.save_state()
        return True, "Friend request declined"

    def cancel_friend_request(self, public_key):
        """Cancel one outgoing pending request and notify the recipient."""
        public_key = trim_text(public_key, 64).lower()
        friendships = self.state.setdefault("global", {}).setdefault("friendships", {})
        friendship = friendships.get(public_key, {})
        if friendship.get("status") != "pending":
            return False, "That sent request is no longer pending"
        ok, message = self.global_ping(
            public_key,
            "friend_cancel",
            session_id=friendship.get("request_id"),
            allow_offline=True,
        )
        if not ok:
            return False, message
        friendships.pop(public_key, None)
        self.save_state()
        return True, "Friend request cancelled"

    def _friend_request_key(self, ping):
        session_id = trim_text(ping.get("session_id"), 128)
        if session_id:
            return f"{ping.get('public_key', '')}:{session_id}"
        event_id = trim_text(ping.get("id"), 64).lower()
        return f"{ping.get('public_key', '')}:event:{event_id}" if event_id else ""

    def _remember_handled_friend_request(self, ping):
        key = self._friend_request_key(ping)
        if not key:
            return
        handled = self.state.setdefault("global", {}).setdefault("handled_friend_requests", [])
        if key not in handled:
            handled.append(key)
        self.state["global"]["handled_friend_requests"] = handled[-MAX_SEEN_EVENT_IDS:]

    def _supports_nip17(self, public_key):
        public_key = trim_text(public_key, 64).lower()
        global_state = self.state.setdefault("global", {})
        friendship = global_state.setdefault("friendships", {}).get(public_key, {})
        if isinstance(friendship, dict) and friendship.get("private_protocol") == "nip17-v1":
            return True
        peer = global_state.get("peers", {}).get(public_key, {})
        capabilities = set(peer.get("capabilities", [])) if isinstance(peer, dict) else set()
        modern = {"nip44-v2", "nip17-dm-v1", "nip17-inbox-relays-v1"}.issubset(capabilities)
        if modern and isinstance(friendship, dict) and friendship.get("status") == "friends":
            # Security upgrade is sticky: once a friend has advertised the
            # modern protocol, a later absence/stale presence must not silently
            # downgrade that established friendship to the legacy transport.
            friendship["private_protocol"] = "nip17-v1"
            friendship["private_protocol_seen_at"] = now_seconds()
        return modern

    def _supports_nip17_file_messages(self, public_key):
        peer = self.state.get("global", {}).get("peers", {}).get(trim_text(public_key, 64).lower(), {})
        capabilities = set(peer.get("capabilities", [])) if isinstance(peer, dict) else set()
        return "nip17-file-kind15-v1" in capabilities

    @staticmethod
    def _normalize_nip17_dm_relays(relay_urls):
        result = []
        for relay_url in relay_urls or []:
            if not isinstance(relay_url, str):
                continue
            relay_url = relay_url.strip().rstrip("/")
            # Remote kind-10050 data never gets to create arbitrary network
            # destinations. Friends only follows relays the user already
            # configured locally through GLOBAL_RELAYS.
            if relay_url in GLOBAL_RELAYS and relay_url not in result:
                result.append(relay_url)
            if len(result) >= NIP17_MAX_DM_RELAYS:
                break
        return result

    def _dm_relay_list_event(self):
        identity = self._global_identity()
        relays = self._normalize_nip17_dm_relays(NIP17_DM_RELAYS)
        if not relays:
            raise ValueError("no configured NIP-17 inbox relays")
        return build_event(
            identity["secret_key"],
            NIP17_DM_RELAY_LIST_KIND,
            [["relay", relay_url] for relay_url in relays],
            "",
        )

    def _dm_relays_from_event(self, event, expected_public_key):
        expected_public_key = trim_text(expected_public_key, 64).lower()
        if (
            not is_valid_public_key(expected_public_key)
            or not verify_event(event)
            or int(event.get("kind", -1)) != NIP17_DM_RELAY_LIST_KIND
            or trim_text(event.get("pubkey"), 64).lower() != expected_public_key
        ):
            return []
        return self._normalize_nip17_dm_relays(self._event_tag_values(event, "relay"))

    def _remember_nip17_dm_relay_event(self, public_key, event):
        public_key = trim_text(public_key, 64).lower()
        friendship = self.state.setdefault("global", {}).setdefault("friendships", {}).get(public_key)
        if not isinstance(friendship, dict) or friendship.get("status") != "friends":
            return []
        relays = self._dm_relays_from_event(event, public_key)
        if not relays:
            return []
        event_at = safe_int(event.get("created_at"))
        if event_at < safe_int(friendship.get("nip17_dm_relays_event_at")):
            return self._normalize_nip17_dm_relays(friendship.get("nip17_dm_relays", []))
        friendship["nip17_dm_relays"] = relays
        friendship["nip17_dm_relays_seen_at"] = now_seconds()
        friendship["nip17_dm_relays_event_at"] = event_at
        return relays

    def _fetch_nip17_dm_relays(self, public_key):
        public_key = trim_text(public_key, 64).lower()
        if public_key == self._global_identity()["public_key"]:
            return self._normalize_nip17_dm_relays(NIP17_DM_RELAYS)
        friendship = self.state.setdefault("global", {}).setdefault("friendships", {}).get(public_key, {})
        cached = self._normalize_nip17_dm_relays(friendship.get("nip17_dm_relays", [])) if isinstance(friendship, dict) else []
        cache_age = now_seconds() - safe_int(friendship.get("nip17_dm_relays_seen_at")) if isinstance(friendship, dict) else NIP17_DM_RELAY_CACHE_SECONDS + 1
        if cached and cache_age <= NIP17_DM_RELAY_CACHE_SECONDS:
            return cached
        if not is_valid_public_key(public_key):
            return []

        # Metadata discovery is on the send critical path. Query configured
        # relays concurrently under one bounded deadline instead of spending
        # up to 1.5 seconds on each relay in sequence.
        def query_relay(relay_url):
            sub_id = "ofdr" + uuid.uuid4().hex[:12]
            try:
                with WebSocketClient(relay_url, timeout=1.5) as relay:
                    relay.send_json([
                        "REQ", sub_id,
                        {"kinds": [NIP17_DM_RELAY_LIST_KIND], "authors": [public_key], "limit": 4},
                    ])
                    candidates = []
                    deadline = time.monotonic() + 1.0
                    while time.monotonic() < deadline:
                        try:
                            message = relay.recv_json(max(0.05, deadline - time.monotonic()))
                        except EOFError:
                            break
                        if not isinstance(message, list) or not message:
                            continue
                        if message[0] == "EVENT" and len(message) >= 3 and message[1] == sub_id:
                            event = message[2]
                            if self._dm_relays_from_event(event, public_key):
                                candidates.append(event)
                        elif message[0] in ("EOSE", "CLOSED") and len(message) >= 2 and message[1] == sub_id:
                            break
                    try:
                        relay.send_json(["CLOSE", sub_id])
                    except OSError:
                        pass
                    return candidates
            except (OSError, ValueError, ssl.SSLError, EOFError):
                return []

        candidates = []
        replies = queue.Queue()

        def query_detached(relay_url):
            try:
                replies.put(query_relay(relay_url))
            except Exception:
                replies.put([])

        for relay_url in GLOBAL_RELAYS:
            threading.Thread(target=query_detached, args=(relay_url,), daemon=True).start()
        deadline = time.monotonic() + 1.25
        completed = 0
        while completed < len(GLOBAL_RELAYS) and time.monotonic() < deadline:
            try:
                candidates.extend(replies.get(timeout=max(0.01, deadline - time.monotonic())))
            except queue.Empty:
                break
            completed += 1
            # One signed current relay-list event is sufficient.
            if candidates:
                break
        if candidates:
            newest = max(candidates, key=lambda item: safe_int(item.get("created_at")))
            relays = self._remember_nip17_dm_relay_event(public_key, newest)
            if relays:
                return relays
        return []

    def _legacy_private_event(self, public_key, envelope, extra_tags=None, alt="Omarchy Friends private message"):
        identity = self._global_identity()
        encrypted = encrypt_legacy_private_text(
            identity["secret_key"],
            public_key,
            json.dumps(envelope, ensure_ascii=False, separators=(",", ":")),
        )
        tags = [["p", public_key], ["t", GLOBAL_DM_TAG]]
        for tag in extra_tags or []:
            if isinstance(tag, (list, tuple)) and tag:
                tags.append([str(value) for value in tag])
        tags.append(["alt", alt])
        return build_event(
            identity["secret_key"],
            GLOBAL_DM_KIND,
            tags,
            json.dumps(encrypted, separators=(",", ":")),
        )

    def _publish_nip17(self, recipient_public_key, rumor):
        identity = self._global_identity()
        event = wrap_nip17_rumor(identity["secret_key"], recipient_public_key, rumor)
        relay_urls = self._fetch_nip17_dm_relays(recipient_public_key)
        if not relay_urls:
            return False, event
        ok, relay_status = self._publish_event_to_relays(event, relay_urls)
        self.state.setdefault("global", {}).setdefault("relays", {}).update(relay_status)
        return ok, event

    def _remember_local_private_rumor(self, rumor_id):
        rumor_id = trim_text(rumor_id, 64).lower()
        if not rumor_id:
            return
        global_state = self.state.setdefault("global", {})
        self._remember_nip17_rumor(rumor_id)
        processed = global_state.setdefault("processed_event_ids", [])
        if rumor_id not in processed:
            processed.append(rumor_id)
            global_state["processed_event_ids"] = processed[-MAX_SEEN_EVENT_IDS:]

    def _remember_nip17_rumor(self, rumor_id):
        rumor_id = trim_text(rumor_id, 64).lower()
        if not re.fullmatch(r"[0-9a-f]{64}", rumor_id):
            return
        global_state = self.state.setdefault("global", {})
        seen = global_state.setdefault("nip17_seen_rumors", {})
        cutoff = now_seconds() - NIP17_RUMOR_DEDUPE_SECONDS
        seen = {
            event_id: safe_int(seen_at)
            for event_id, seen_at in seen.items()
            if safe_int(seen_at) >= cutoff
        }
        seen[rumor_id] = now_seconds()
        if len(seen) > MAX_SEEN_NIP17_RUMORS:
            seen = dict(sorted(seen.items(), key=lambda item: item[1])[-MAX_SEEN_NIP17_RUMORS:])
        global_state["nip17_seen_rumors"] = seen

    def _persist_outgoing_message(self, message):
        messages = self.state.setdefault("global", {}).setdefault("messages", [])
        existing = next((item for item in messages if item.get("id") == message.get("id")), None)
        if existing is None:
            messages.append(message)
        else:
            existing.update(message)
        self.save_state()

    def _normalize_reply_reference(self, reply_to, *, public_key="", group_id=""):
        if not isinstance(reply_to, dict):
            return None
        reply_id = trim_text(reply_to.get("id"), 64).lower()
        if not re.fullmatch(r"[0-9a-f]{64}", reply_id):
            return None
        own_key = self._global_identity()["public_key"]
        target = next(
            (item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == reply_id),
            None,
        )
        if not isinstance(target, dict):
            return None
        if group_id:
            if target.get("group_id") != group_id:
                return None
        elif target.get("group_id") or target.get("public_key") not in (public_key, own_key):
            return None
        return {
            "id": reply_id,
            "handle": trim_text(target.get("handle"), 24) or "Message",
            "text": trim_text(target.get("text") or "Attachment", 240),
        }

    def send_dm(self, public_key, text, media_url="", attachment_path="", attachment_is_folder=False, reply_to=None):
        self.last_sent_message_id = ""
        public_key = trim_text(public_key, 64).lower()
        if self.state.setdefault("global", {}).setdefault("friendships", {}).get(public_key, {}).get("status") != "friends":
            return False, "DMs are available after you become friends"
        reply = self._normalize_reply_reference(reply_to, public_key=public_key) if reply_to else None
        if reply_to and not reply:
            return False, "That reply is no longer available in this conversation"
        text = trim_text(text, 2000)
        media = normalize_media_items(media_url)
        try:
            attachment = self._prepare_private_attachment(attachment_path, attachment_is_folder)
        except ValueError as error:
            return False, str(error)
        attachments = [attachment] if attachment else []
        if not text and not media and not attachments:
            return False, "Write a message or add a media link first"
        wire_text = text or ("Shared " + attachments[0]["name"] if attachments else "")
        identity = self._global_identity()
        message_id = ""
        delivered = False
        try:
            if self._supports_nip17(public_key):
                envelope = {"v": 3, "type": "direct", "text": wire_text, "media": media, "attachments": attachments, "reply_to": reply}
                file_message = bool(attachments and attachments[0].get("transport") == "blossom" and self._supports_nip17_file_messages(public_key))
                rumor = create_nip17_rumor(
                    identity["secret_key"],
                    [public_key],
                    attachments[0].get("url", "") if file_message else (wire_text or "Shared media"),
                    app_envelope=envelope,
                    reply_to=reply["id"] if reply else "",
                    file_metadata=attachments[0] if file_message else None,
                    kind=NIP17_FILE_KIND if file_message else NIP17_MESSAGE_KIND,
                )
                message_id = rumor["id"]
                self.last_sent_message_id = message_id
                retry_actions = [{"kind": "nip17_rumor", "recipient": public_key, "rumor": rumor}]
                self._persist_outgoing_message({
                    "id": message_id, "public_key": public_key,
                    "conversation_key": public_key,
                    "handle": self.state["global"]["friendships"][public_key].get("handle", "Friend"),
                    "text": wire_text, "media": media, "attachments": attachments,
                    "reply_to": reply,
                    "timestamp": now_seconds(), "incoming": False, "sendState": "Sending…",
                    "retry_actions": retry_actions,
                })
                ok, _ = self._publish_nip17(public_key, rumor)
                delivered = bool(ok)
                if ok:
                    self._remember_local_private_rumor(message_id)
            else:
                event = self._legacy_private_event(
                    public_key,
                    {"v": 1, "text": wire_text, "media": media, "attachments": attachments, "reply_to": reply},
                )
                message_id = event["id"]
                self.last_sent_message_id = message_id
                retry_actions = [{"kind": "legacy_event", "recipient": public_key, "event": event}]
                self._persist_outgoing_message({
                    "id": message_id, "public_key": public_key,
                    "conversation_key": public_key,
                    "handle": self.state["global"]["friendships"][public_key].get("handle", "Friend"),
                    "text": wire_text, "media": media, "attachments": attachments,
                    "reply_to": reply,
                    "timestamp": now_seconds(), "incoming": False, "sendState": "Sending…",
                    "retry_actions": retry_actions,
                })
                ok, relay_status = self._publish_global_event(event)
                delivered = bool(ok)
                self.state["global"]["relays"].update(relay_status)
        except (TypeError, ValueError):
            return False, "That friend key is invalid"

        if not message_id or not delivered:
            if message_id:
                self._persist_outgoing_message({
                    "id": message_id,
                    "sendState": "Unconfirmed · retry",
                    "retry_attempts": 0,
                    "retry_at": now_seconds() + PRIVATE_AUTO_RETRY_DELAYS[0],
                })
            else:
                self.save_state()
            return False, "No inbox relay confirmed delivery; the message may still arrive, so check before retrying"

        friend = self.state["global"]["friendships"][public_key]
        self._persist_outgoing_message({
            "id": message_id,
            "public_key": public_key,
            "conversation_key": public_key,
            "handle": friend.get("handle", "Friend"),
            "text": wire_text,
            "media": media,
            "attachments": attachments,
            "reply_to": reply,
            "timestamp": now_seconds(),
            "incoming": False,
            "sendState": "Sent",
            "retry_actions": [],
        })
        self._remember_memory_signal(public_key, "dm", "sent", friend.get("handle", ""), "")
        if not self.state.get("invite_nudge_dismissed"):
            self.state["invite_nudge"] = True
        return True, "Private message sent"

    def retry_private_message(self, target_id):
        """Retry only unconfirmed recipients using the saved authenticated payload."""
        target_id = trim_text(target_id, 64).lower()
        if not re.fullmatch(r"[0-9a-f]{64}", target_id):
            return False, "That message cannot be retried"
        message = next(
            (item for item in self.state.get("global", {}).get("messages", [])
             if isinstance(item, dict) and item.get("id") == target_id),
            None,
        )
        if not isinstance(message, dict) or message.get("incoming") or message.get("deleted"):
            return False, "Only your own available message can be retried"
        actions = message.get("retry_actions")
        if not isinstance(actions, list) or not actions:
            return False, "This message has no pending delivery to retry"

        group_id = trim_text(message.get("group_id"), 40).lower()
        own_key = self._global_identity()["public_key"]
        if group_id:
            group = self.state.get("global", {}).get("groups", {}).get(group_id)
            if not group or own_key not in group.get("members", {}):
                return False, "That group is no longer available"
            allowed_recipients = {
                key for key in group.get("members", {})
                if key != own_key and self.state.get("global", {}).get("friendships", {}).get(key, {}).get("status") == "friends"
            }
        else:
            recipient = trim_text(message.get("conversation_key"), 64).lower()
            friendship = self.state.get("global", {}).get("friendships", {}).get(recipient, {})
            if not is_valid_public_key(recipient) or friendship.get("status") != "friends":
                return False, "Reconnect with this friend before retrying"
            allowed_recipients = {recipient}

        remaining_actions = []
        delivered_count = 0
        last_error = "No inbox relay confirmed delivery"
        for action in actions:
            recipient = trim_text(action.get("recipient"), 64).lower() if isinstance(action, dict) else ""
            if not isinstance(action, dict) or recipient not in allowed_recipients:
                last_error = "Saved retry data does not match this conversation"
                remaining_actions.append(action)
                continue
            ok = False
            try:
                if action.get("kind") == "nip17_rumor":
                    rumor = action.get("rumor")
                    if (not self._saved_nip17_rumor_valid(rumor, target_id, recipient, group_id)
                            or rumor.get("pubkey") != own_key):
                        last_error = "Saved encrypted message could not be verified"
                        remaining_actions.append(action)
                        continue
                    ok, _ = self._publish_nip17(recipient, rumor)
                    if ok:
                        self._remember_local_private_rumor(target_id)
                elif action.get("kind") == "legacy_event":
                    event = action.get("event")
                    if (not isinstance(event, dict) or (not group_id and event.get("id") != target_id)
                            or event.get("pubkey") != own_key or not verify_event(event)
                            or not any(isinstance(tag, list) and len(tag) >= 2 and tag[0] == "p" and tag[1] == recipient for tag in event.get("tags", []))
                            or (group_id and not any(isinstance(tag, list) and len(tag) >= 2 and tag[0] == "g" and tag[1] == group_id for tag in event.get("tags", [])))):
                        last_error = "Saved encrypted message could not be verified"
                        remaining_actions.append(action)
                        continue
                    ok, relay_status = self._publish_global_event(event)
                    self.state.setdefault("global", {}).setdefault("relays", {}).update(relay_status)
                else:
                    last_error = "Saved retry data uses an unsupported transport"
            except (TypeError, ValueError):
                ok = False
            if ok:
                delivered_count += 1
            else:
                remaining_actions.append(action)

        if not remaining_actions:
            self._persist_outgoing_message({
                "id": target_id, "sendState": "Sent", "retry_actions": [],
                "retry_attempts": 0, "retry_at": 0,
            })
            return True, "Message delivery confirmed"
        retry_attempts = min(
            MAX_PRIVATE_AUTO_RETRIES,
            safe_int(message.get("retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES) + 1,
        )
        retry_at = (
            now_seconds() + PRIVATE_AUTO_RETRY_DELAYS[retry_attempts]
            if retry_attempts < MAX_PRIVATE_AUTO_RETRIES else 0
        )
        self._persist_outgoing_message({
            "id": target_id,
            "sendState": "Partial · retry" if group_id and (delivered_count or message.get("sendState", "").startswith("Partial")) else "Unconfirmed · retry",
            "retry_actions": remaining_actions,
            "retry_attempts": retry_attempts, "retry_at": retry_at,
        })
        if delivered_count:
            return False, f"Delivery confirmed for {delivered_count} recipient(s); {len(remaining_actions)} still need retry"
        return False, last_error

    def retry_pending_private_messages(self, limit=1):
        """Retry due private messages in a bounded batch using saved payloads."""
        limit = safe_int(limit, 1, 1, 3)
        now = now_seconds()
        due_ids = []
        for item in self.state.get("global", {}).get("messages", []):
            if (not isinstance(item, dict) or item.get("incoming") or item.get("deleted")
                    or not item.get("retry_actions")
                    or safe_int(item.get("retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES) >= MAX_PRIVATE_AUTO_RETRIES):
                continue
            message_id = item.get("id", "")
            retry_at = safe_int(item.get("retry_at"))
            stale_initial_send = (
                item.get("sendState") == "Sending…"
                and now - safe_int(item.get("timestamp")) >= PRIVATE_SEND_STALE_SECONDS
            )
            if stale_initial_send:
                self._persist_outgoing_message({
                    "id": message_id,
                    "sendState": "Unconfirmed · retry",
                    "retry_attempts": 0,
                    "retry_at": now,
                })
                retry_at = now
            if 0 < retry_at <= now:
                due_ids.append(message_id)
                if len(due_ids) >= limit:
                    break
        delivered = 0
        for message_id in due_ids:
            ok, _ = self.retry_private_message(message_id)
            if ok:
                delivered += 1
        return len(due_ids), delivered

    def react_to_message(self, target_id, public_key="", group_id="", emoji="👍"):
        target_id = trim_text(target_id, 64).lower()
        public_key = trim_text(public_key, 64).lower()
        group_id = trim_text(group_id, 40).lower()
        if emoji not in ALLOWED_MESSAGE_REACTIONS or not re.fullmatch(r"[0-9a-f]{64}", target_id):
            return False, "Choose a supported reaction"
        target = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == target_id), None)
        if not isinstance(target, dict) or trim_text(target.get("group_id"), 40).lower() != group_id:
            return False, "That message is no longer available in this conversation"
        identity = self._global_identity()
        own_key = identity["public_key"]
        if group_id:
            group = self.state.get("global", {}).get("groups", {}).get(group_id)
            if not group or own_key not in group.get("members", {}):
                return False, "That group is no longer available"
            recipients = [key for key in group.get("members", {}) if key != own_key and self.state.get("global", {}).get("friendships", {}).get(key, {}).get("status") == "friends"]
        else:
            if not is_valid_public_key(public_key) or target.get("conversation_key") != public_key:
                return False, "That message is no longer available in this conversation"
            if self.state.get("global", {}).get("friendships", {}).get(public_key, {}).get("status") != "friends":
                return False, "Reactions are available only in a private conversation"
            recipients = [public_key]
        if not recipients:
            return False, "No available conversation members"

        envelope = {"v": 3, "type": "reaction", "target_id": target_id, "group_id": group_id, "emoji": emoji}
        failed_transports = {}
        accepted_count = 0
        for recipient in recipients:
            transport = {}
            try:
                if self._supports_nip17(recipient):
                    rumor = create_nip17_rumor(
                        identity["secret_key"], [recipient], emoji,
                        app_envelope=envelope,
                        referenced_pubkey=target.get("public_key", ""),
                        reply_to=target_id,
                        kind=NIP17_REACTION_KIND,
                    )
                    accepted, _ = self._publish_nip17(recipient, rumor)
                    transport = {"kind": "nip17_rumor", "rumor": rumor}
                else:
                    event = self._legacy_private_event(
                        recipient, envelope,
                        [["e", target_id], ["p", target.get("public_key", "")]],
                        "Omarchy Friends private message reaction",
                    )
                    accepted, relay_status = self._publish_global_event(event)
                    self.state["global"]["relays"].update(relay_status)
                    transport = {"kind": "legacy_event", "event": event}
            except (TypeError, ValueError, OSError, ssl.SSLError):
                accepted = False
            if accepted:
                accepted_count += 1
            elif transport:
                failed_transports[recipient] = transport
        self._store_pending_message_action(target, "reaction", envelope, failed_transports)
        if accepted_count:
            self._apply_message_reaction(target_id, own_key, self.state["profile"].get("handle", "You"), emoji, group_id)
        self.save_state()
        if accepted_count < len(recipients):
            if accepted_count:
                return False, f"Reaction confirmed for {accepted_count} of {len(recipients)} conversation member(s); retry remains available"
            return False, "No conversation relay confirmed the reaction; retry remains available"
        return True, "Reaction sent"

    def delete_message(self, target_id):
        target_id = trim_text(target_id, 64).lower()
        if not re.fullmatch(r"[0-9a-f]{64}", target_id):
            return False, "That message cannot be deleted"
        target = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == target_id), None)
        identity = self._global_identity()
        own_key = identity["public_key"]
        if not isinstance(target, dict) or target.get("deleted") or target.get("incoming"):
            return False, "Only your own available messages can be deleted for everyone"
        group_id = trim_text(target.get("group_id"), 40).lower()
        if group_id:
            group = self.state.get("global", {}).get("groups", {}).get(group_id)
            if not group or own_key not in group.get("members", {}):
                return False, "That group is no longer available"
            recipients = [key for key in group.get("members", {}) if key != own_key and self.state.get("global", {}).get("friendships", {}).get(key, {}).get("status") == "friends"]
        else:
            recipient = trim_text(target.get("conversation_key"), 64).lower()
            if not is_valid_public_key(recipient) or self.state.get("global", {}).get("friendships", {}).get(recipient, {}).get("status") != "friends":
                return False, "That private conversation is no longer available"
            recipients = [recipient]
        if not recipients:
            return False, "No conversation member is available to receive the deletion"

        envelope = {"v": 3, "type": "delete", "target_id": target_id, "group_id": group_id}
        failed_transports = {}
        accepted_count = 0
        for recipient in recipients:
            transport = {}
            try:
                if self._supports_nip17(recipient):
                    rumor = create_nip17_rumor(
                        identity["secret_key"], [recipient], "Message deleted",
                        app_envelope=envelope, reply_to=target_id, kind=NIP17_DELETE_KIND,
                    )
                    accepted, _ = self._publish_nip17(recipient, rumor)
                    transport = {"kind": "nip17_rumor", "rumor": rumor}
                else:
                    event = self._legacy_private_event(
                        recipient, envelope,
                        [["e", target_id]] + ([["g", group_id]] if group_id else []),
                        "Omarchy Friends private message deletion",
                    )
                    accepted, relay_status = self._publish_global_event(event)
                    self.state["global"]["relays"].update(relay_status)
                    transport = {"kind": "legacy_event", "event": event}
            except (TypeError, ValueError, OSError, ssl.SSLError):
                accepted = False
            if accepted:
                accepted_count += 1
            elif transport:
                failed_transports[recipient] = transport
        self._store_pending_message_action(target, "delete", envelope, failed_transports)
        # Delete locally as soon as the user asks, even while relay delivery
        # is pending. The encrypted retry payload is retained for failed peers.
        self._apply_message_deletion(target_id, own_key, group_id)
        if failed_transports:
            target["sendState"] = "Deletion pending · retry"
        self.save_state()
        if accepted_count < len(recipients):
            if accepted_count:
                return False, f"Deletion confirmed for {accepted_count} of {len(recipients)} conversation member(s); retry remains available"
            return False, "Deletion is hidden here but no conversation relay confirmed delivery; retry remains available"
        return True, f"Deletion sent to all {accepted_count} conversation member(s)"

    def _apply_message_edit(self, target_id, actor, group_id, text, edited_at):
        target_id = trim_text(target_id, 64).lower()
        actor = trim_text(actor, 64).lower()
        group_id = trim_text(group_id, 40).lower()
        text = trim_text(text, 2000)
        edited_at = safe_int(edited_at)
        target = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == target_id), None)
        if not isinstance(target, dict) or target.get("deleted") or not text:
            return False
        author = target.get("public_key") if target.get("group_id") or target.get("incoming") else self._global_identity()["public_key"]
        if author != actor or trim_text(target.get("group_id"), 40) != group_id:
            return False
        original_at = safe_int(target.get("timestamp"))
        if original_at <= 0 or edited_at < original_at or edited_at > now_seconds() + 30:
            return False
        if edited_at - original_at > MAX_MESSAGE_EDIT_AGE:
            return False
        if target.get("edited_at") and edited_at <= safe_int(target.get("edited_at")):
            return False
        if target.get("attachments") or target.get("media"):
            return False
        target["text"] = text
        target["edited"] = True
        target["edited_at"] = edited_at
        return True

    def _apply_message_read_receipt(self, target_id, actor, group_id):
        target_id = trim_text(target_id, 64).lower()
        actor = trim_text(actor, 64).lower()
        group_id = trim_text(group_id, 40).lower()
        target = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == target_id), None)
        if not isinstance(target, dict) or target.get("incoming") or target.get("deleted"):
            return False
        if trim_text(target.get("group_id"), 40).lower() != group_id:
            return False
        own_key = self._global_identity()["public_key"]
        if group_id:
            group = self.state.get("global", {}).get("groups", {}).get(group_id, {})
            if actor == own_key or actor not in group.get("members", {}):
                return False
        elif actor != trim_text(target.get("conversation_key"), 64).lower():
            return False
        readers = target.setdefault("read_by", [])
        if actor not in readers:
            readers.append(actor)
            target["read_by"] = readers[-MAX_GROUP_MEMBERS:]
        return True

    def _send_read_receipts(self, kind, identifier):
        if not self.state.get("profile", {}).get("privacy", {}).get("share_read_receipts", False):
            return 0
        global_state = self.state.setdefault("global", {})
        own_key = self._global_identity()["public_key"]
        if kind == "friend":
            recipient_keys = [identifier]
            group_id = ""
        else:
            group_id = identifier
            group = global_state.get("groups", {}).get(group_id, {})
            recipient_keys = [
                key for key in group.get("members", {})
                if key != own_key and global_state.get("friendships", {}).get(key, {}).get("status") == "friends"
            ]
        if not recipient_keys:
            return 0

        published = 0
        attempted_ids = set()
        messages = global_state.get("messages", [])
        for recipient in recipient_keys:
            targets = [
                message for message in messages
                if message.get("incoming")
                and message.get("read_receipt_eligible")
                and not message.get("deleted")
                and trim_text(message.get("group_id"), 40).lower() == group_id
                and message.get("public_key") in (recipient_keys if group_id else [recipient])
                and recipient not in message.get("read_receipt_sent_to", [])
                and safe_int(message.get("read_receipt_retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES) < MAX_PRIVATE_AUTO_RETRIES
                and safe_int(message.get("read_receipt_retry_at")) <= now_seconds()
            ][:MAX_READ_RECEIPT_TARGETS]
            if not targets:
                continue
            target_ids = [message["id"] for message in targets if re.fullmatch(r"[0-9a-f]{64}", str(message.get("id", "")))]
            if not target_ids:
                continue
            attempted_ids.update(target_ids)
            envelope = {"v": 3, "type": "read_receipt", "group_id": group_id, "target_ids": target_ids}
            try:
                if self._supports_nip17(recipient):
                    rumor = create_nip17_rumor(
                        self._global_identity()["secret_key"], [recipient], "Read receipt",
                        app_envelope=envelope, kind=NIP17_MESSAGE_KIND,
                    )
                    accepted, _ = self._publish_nip17(recipient, rumor)
                    if accepted:
                        self._remember_local_private_rumor(rumor["id"])
                else:
                    event = self._legacy_private_event(
                        recipient, envelope, alt="Omarchy Friends private read receipt",
                    )
                    accepted, relay_status = self._publish_global_event(event)
                    global_state.setdefault("relays", {}).update(relay_status)
                if accepted:
                    published += 1
                    for message in targets:
                        sent_to = message.setdefault("read_receipt_sent_to", [])
                        if recipient not in sent_to:
                            sent_to.append(recipient)
                            message["read_receipt_sent_to"] = sent_to[-MAX_GROUP_MEMBERS:]
            except (TypeError, ValueError):
                continue
        for message in messages:
            if message.get("read_receipt_eligible"):
                expected = set(recipient_keys)
                sent = set(message.get("read_receipt_sent_to", []))
                if expected.issubset(sent):
                    message["read_receipt_eligible"] = False
                    message["read_receipt_retry_attempts"] = 0
                    message["read_receipt_retry_at"] = 0
                elif message.get("id") in attempted_ids:
                    attempts = min(
                        MAX_PRIVATE_AUTO_RETRIES,
                        safe_int(message.get("read_receipt_retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES) + 1,
                    )
                    message["read_receipt_retry_attempts"] = attempts
                    message["read_receipt_retry_at"] = (
                        now_seconds() + PRIVATE_AUTO_RETRY_DELAYS[attempts - 1]
                        if attempts < MAX_PRIVATE_AUTO_RETRIES else 0
                    )
        return published

    def retry_pending_read_receipts(self, limit=3):
        """Retry opted-in read receipts on a bounded exponential backoff."""
        if not self.state.get("profile", {}).get("privacy", {}).get("share_read_receipts", False):
            return 0, 0
        limit = safe_int(limit, 3, 1, 8)
        now = now_seconds()
        due = []
        discarded = False
        own_key = self._global_identity()["public_key"]
        for message in self.state.get("global", {}).get("messages", []):
            if (not isinstance(message, dict) or not message.get("incoming")
                    or not message.get("read_receipt_eligible") or message.get("deleted")
                    or safe_int(message.get("read_receipt_retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES) >= MAX_PRIVATE_AUTO_RETRIES
                    or safe_int(message.get("read_receipt_retry_at")) > now):
                continue
            group_id = trim_text(message.get("group_id"), 40).lower()
            if group_id:
                key = ("group", group_id)
                group = self.state.get("global", {}).get("groups", {}).get(group_id, {})
                if not group or own_key not in group.get("members", {}):
                    message["read_receipt_eligible"] = False
                    message["read_receipt_retry_at"] = 0
                    discarded = True
                    continue
                recipients = [
                    member for member in group.get("members", {})
                    if member != own_key
                    and self.state.get("global", {}).get("friendships", {}).get(member, {}).get("status") == "friends"
                ]
                if not recipients:
                    message["read_receipt_eligible"] = False
                    message["read_receipt_retry_at"] = 0
                    discarded = True
                    continue
            else:
                key = ("friend", trim_text(message.get("public_key"), 64).lower())
                if self.state.get("global", {}).get("friendships", {}).get(key[1], {}).get("status") != "friends":
                    message["read_receipt_eligible"] = False
                    message["read_receipt_retry_at"] = 0
                    discarded = True
                    continue
            if key not in due:
                due.append(key)
                if len(due) >= limit:
                    break
        attempted = 0
        published = 0
        for kind, identifier in due:
            eligible_before = sum(
                1 for message in self.state.get("global", {}).get("messages", [])
                if message.get("incoming") and message.get("read_receipt_eligible")
                and trim_text(message.get("group_id"), 40).lower() == (identifier if kind == "group" else "")
                and (kind == "group" or trim_text(message.get("public_key"), 64).lower() == identifier)
                and safe_int(message.get("read_receipt_retry_attempts"), maximum=MAX_PRIVATE_AUTO_RETRIES) < MAX_PRIVATE_AUTO_RETRIES
                and safe_int(message.get("read_receipt_retry_at")) <= now
            )
            if not eligible_before:
                continue
            attempted += 1
            published += self._send_read_receipts(kind, identifier)
        if attempted or discarded:
            self.save_state()
        return attempted, published

    def edit_message(self, target_id, text):
        target_id = trim_text(target_id, 64).lower()
        text = trim_text(text, 2000)
        if not re.fullmatch(r"[0-9a-f]{64}", target_id) or not text:
            return False, "Enter valid text to edit this message"
        target = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == target_id), None)
        own_key = self._global_identity()["public_key"]
        if not isinstance(target, dict) or target.get("deleted") or target.get("incoming") or (target.get("sendState") and target.get("sendState") != "Sent"):
            return False, "Only your sent messages can be edited"
        if target.get("attachments") or target.get("media") or not target.get("text"):
            return False, "Only text-only messages can be edited"
        now = now_seconds()
        original_at = safe_int(target.get("timestamp"))
        if original_at <= 0 or now < original_at or now - original_at > MAX_MESSAGE_EDIT_AGE:
            return False, "Messages can be edited for 15 minutes after sending"
        group_id = trim_text(target.get("group_id"), 40).lower()
        if group_id:
            group = self.state.get("global", {}).get("groups", {}).get(group_id)
            if not group or own_key not in group.get("members", {}):
                return False, "That group is no longer available"
            recipients = [key for key in group.get("members", {}) if key != own_key and self.state.get("global", {}).get("friendships", {}).get(key, {}).get("status") == "friends"]
        else:
            recipient = trim_text(target.get("conversation_key"), 64).lower()
            if not is_valid_public_key(recipient) or self.state.get("global", {}).get("friendships", {}).get(recipient, {}).get("status") != "friends":
                return False, "That private conversation is no longer available"
            recipients = [recipient]
        if not recipients:
            return False, "No conversation member is available to receive the edit"
        envelope = {"v": 3, "type": "edit", "target_id": target_id, "group_id": group_id, "text": text}
        failed_transports = {}
        accepted_count = 0
        for recipient in recipients:
            transport = {}
            try:
                if self._supports_nip17(recipient):
                    rumor = create_nip17_rumor(
                        self._global_identity()["secret_key"], [recipient], text,
                        subject=target.get("group_name", "") if group_id else "",
                        app_envelope=envelope, reply_to=target_id, kind=NIP17_MESSAGE_KIND,
                    )
                    sent, _ = self._publish_nip17(recipient, rumor)
                    transport = {"kind": "nip17_rumor", "rumor": rumor}
                else:
                    event = self._legacy_private_event(
                        recipient, envelope, [["e", target_id], *([["g", group_id]] if group_id else [])],
                        "Omarchy Friends private message edit",
                    )
                    sent, relay_status = self._publish_global_event(event)
                    self.state["global"]["relays"].update(relay_status)
                    transport = {"kind": "legacy_event", "event": event}
            except (TypeError, ValueError, OSError, ssl.SSLError):
                sent = False
            if sent:
                accepted_count += 1
            elif transport:
                failed_transports[recipient] = transport
        self._store_pending_message_action(target, "edit", envelope, failed_transports)
        if accepted_count:
            self._apply_message_edit(target_id, own_key, group_id, text, now)
        self.save_state()
        if accepted_count < len(recipients):
            if accepted_count:
                return False, f"Edit confirmed for {accepted_count} of {len(recipients)} conversation member(s); retry remains available"
            return False, "No conversation relay confirmed the edit; retry remains available"
        return True, "Message edit sent to all conversation members"

    def delete_message_for_me(self, target_id):
        """Hide one private message on this device without publishing an event."""
        target_id = trim_text(target_id, 64).lower()
        if not re.fullmatch(r"[0-9a-f]{64}", target_id):
            return False, "That message cannot be removed"
        messages = self.state.setdefault("global", {}).setdefault("messages", [])
        if not any(isinstance(item, dict) and item.get("id") == target_id for item in messages):
            return False, "That message is no longer available"
        global_state = self.state.setdefault("global", {})
        hidden = global_state.setdefault("locally_hidden_message_ids", [])
        if target_id not in hidden:
            hidden.append(target_id)
        messages[:] = [item for item in messages if item.get("id") != target_id]
        for item in messages:
            if item.get("reply_to", {}).get("id") == target_id:
                item["reply_to"] = None
        self.save_state()
        return True, "Message removed from this device"

    def save_attachment(self, message_id, index=0):
        message_id = trim_text(message_id, 64)
        index = safe_int(index, 0, 0, 0)
        message = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == message_id), None)
        attachments = normalize_private_attachments(message.get("attachments") if message else None)
        if index >= len(attachments):
            return False, "That attachment is no longer available on this device"
        attachment = attachments[index]
        try:
            if attachment.get("transport") == "blossom":
                destination = self._download_blossom_attachment(attachment)
                return True, str(destination)
            data = base64.b64decode(attachment["data"], validate=True)
            if hashlib.sha256(data).hexdigest() != attachment["sha256"]:
                return False, "The attachment checksum does not match"
            downloads = Path.home() / "Downloads"
            downloads.mkdir(mode=0o700, parents=True, exist_ok=True)
            base = safe_attachment_name(attachment["name"])
            destination = downloads / base
            stem, suffix = Path(base).stem, Path(base).suffix
            counter = 1
            while True:
                try:
                    with destination.open("xb") as output:
                        os.chmod(destination, 0o600)
                        output.write(data)
                    break
                except FileExistsError:
                    destination = downloads / f"{stem} ({counter}){suffix}"
                    counter += 1
                    if counter > 1000:
                        return False, "Could not find a free Downloads filename"
        except (OSError, ValueError, RuntimeError) as error:
            if isinstance(error, ValueError):
                return False, str(error)
            return False, "Could not save the attachment to Downloads"
        return True, str(destination)

    def _download_blossom_attachment(self, attachment):
        try:
            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
        except ImportError as error:
            raise ValueError("Install python-cryptography to decrypt large attachments") from error
        parsed = urllib.parse.urlsplit(attachment["url"])
        host, port = parsed.hostname, parsed.port or 443
        if parsed.scheme != "https" or not host or parsed.username or parsed.password or parsed.fragment:
            raise ValueError("This attachment has an unsafe download address")
        try:
            addresses = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
        except OSError as error:
            raise ValueError("Could not resolve the attachment server") from error
        if not addresses or any(not _public_unicast_address(address[4][0]) for address in addresses):
            raise ValueError("This attachment points to a private or reserved network address")
        pinned_address = addresses[0][4][0]
        expected_size = safe_int(attachment.get("cipher_size"), maximum=MAX_REMOTE_ATTACHMENT_BYTES + 16)
        if expected_size < 16:
            raise ValueError("This attachment has an invalid encrypted size")
        encrypted_path = self.state_dir / f".download-{uuid.uuid4().hex}.enc"
        plaintext_path = self.state_dir / f".download-{uuid.uuid4().hex}.plain"
        staged_path = None
        connection = PinnedPublicHTTPSConnection(host, port, pinned_address, timeout=90, context=ssl.create_default_context())
        try:
            target = urllib.parse.urlunsplit(("", "", parsed.path or "/", parsed.query, ""))
            connection.request("GET", target, headers={"Accept": "application/octet-stream"})
            response = connection.getresponse()
            if response.status != 200:
                raise ValueError(f"File download failed (HTTP {response.status})")
            content_length = response.getheader("Content-Length")
            if content_length and (not content_length.isdigit() or int(content_length) > expected_size):
                raise ValueError("The file server advertised an oversized attachment")
            digest = hashlib.sha256()
            received = 0
            with encrypted_path.open("xb") as output:
                os.chmod(encrypted_path, 0o600)
                while True:
                    chunk = response.read(1024 * 1024)
                    if not chunk:
                        break
                    received += len(chunk)
                    if received > expected_size or received > MAX_REMOTE_ATTACHMENT_BYTES + 16:
                        raise ValueError("The downloaded attachment exceeds its declared size")
                    digest.update(chunk)
                    output.write(chunk)
                output.flush()
                os.fsync(output.fileno())
            if received != expected_size or digest.hexdigest() != attachment["sha256"]:
                raise ValueError("The encrypted attachment checksum or size does not match")
            key = base64.urlsafe_b64decode(attachment["key"] + "===")
            nonce = base64.urlsafe_b64decode(attachment["nonce"] + "===")
            if len(key) != 32 or len(nonce) != 12:
                raise ValueError("This attachment has invalid encryption metadata")
            with encrypted_path.open("rb") as source:
                source.seek(-16, os.SEEK_END)
                tag = source.read(16)
                source.seek(0)
                decryptor = Cipher(algorithms.AES(key), modes.GCM(nonce, tag)).decryptor()
                remaining = received - 16
                plain_hash = hashlib.sha256()
                plain_size = 0
                with plaintext_path.open("xb") as output:
                    os.chmod(plaintext_path, 0o600)
                    while remaining:
                        chunk = source.read(min(1024 * 1024, remaining))
                        if not chunk:
                            raise ValueError("The encrypted attachment is truncated")
                        remaining -= len(chunk)
                        plain = decryptor.update(chunk)
                        plain_size += len(plain)
                        if plain_size > MAX_REMOTE_ATTACHMENT_BYTES:
                            raise ValueError("Decrypted attachment exceeds the 100 MiB limit")
                        plain_hash.update(plain)
                        output.write(plain)
                    try:
                        output.write(decryptor.finalize())
                    except Exception as error:
                        raise ValueError("The attachment failed AES-GCM authentication") from error
                    output.flush()
                    os.fsync(output.fileno())
            if plain_size != attachment["size"] or (attachment["plain_sha256"] and plain_hash.hexdigest() != attachment["plain_sha256"]):
                raise ValueError("The decrypted attachment checksum or size does not match")
            downloads = Path.home() / "Downloads"
            downloads.mkdir(mode=0o700, parents=True, exist_ok=True)
            os.chmod(downloads, 0o700)
            name = safe_attachment_name(attachment["name"])
            stem, suffix = Path(name).stem, Path(name).suffix
            import tempfile
            fd, staged_name = tempfile.mkstemp(prefix=".friends-download-", dir=downloads)
            staged_path = Path(staged_name)
            try:
                os.fchmod(fd, 0o600)
                with os.fdopen(fd, "wb") as output, plaintext_path.open("rb") as source:
                    while chunk := source.read(1024 * 1024):
                        output.write(chunk)
                    output.flush()
                    os.fsync(output.fileno())
            except Exception:
                try:
                    staged_path.unlink()
                except OSError:
                    pass
                raise
            for counter in range(1001):
                candidate = downloads / (name if counter == 0 else f"{stem} ({counter}){suffix}")
                try:
                    os.link(staged_path, candidate)
                    staged_path.unlink()
                    staged_path = None
                    return candidate
                except FileExistsError:
                    continue
                except OSError as error:
                    raise ValueError("Could not atomically save the attachment to Downloads") from error
            staged_path.unlink()
            staged_path = None
            raise ValueError("Could not find a free Downloads filename")
        except ssl.SSLError as error:
            raise ValueError("Could not establish a secure connection to the file server") from error
        finally:
            connection.close()
            for temp_path in (encrypted_path, plaintext_path, staged_path):
                if temp_path is None:
                    continue
                try:
                    temp_path.unlink()
                except OSError:
                    pass

    def create_group(self, name, member_keys):
        name = " ".join(trim_text(name, MAX_GROUP_NAME_LENGTH).split())
        if not name:
            return False, "Give the group a name first"
        keys = []
        friendships = self.state.setdefault("global", {}).setdefault("friendships", {})
        for public_key in member_keys or []:
            public_key = trim_text(public_key, 64).lower()
            if not is_valid_public_key(public_key) or public_key in keys:
                continue
            if friendships.get(public_key, {}).get("status") != "friends":
                continue
            keys.append(public_key)
        if len(keys) < 2:
            return False, "Choose at least two friends for a group"
        keys = keys[: MAX_GROUP_MEMBERS - 1]

        identity = self._global_identity()
        own_key = identity["public_key"]
        members = {
            own_key: {
                "public_key": own_key,
                "handle": trim_text(self.state["profile"].get("handle"), 24) or "You",
                "avatar": self.state["profile"].get("avatar")
                if self.state["profile"].get("avatar") in AVAILABLE_AVATARS
                else "👾",
            }
        }
        for public_key in keys:
            friend = friendships[public_key]
            members[public_key] = {
                "public_key": public_key,
                "handle": trim_text(friend.get("handle"), 24) or generate_global_handle(public_key),
                "avatar": friend.get("avatar") if friend.get("avatar") in AVAILABLE_AVATARS else "👾",
            }

        group = {
            "id": uuid.uuid4().hex[:24],
            "name": name,
            "members": members,
            "created_by": own_key,
            "created_at": now_seconds(),
        }
        envelope = {"v": 3, "type": "group_invite", "group_id": group["id"], "group": group}
        nip17_keys = [key for key in keys if self._supports_nip17(key)]
        rumor = None
        if nip17_keys:
            rumor = create_nip17_rumor(
                identity["secret_key"],
                keys,
                f"Invitation to {name}",
                subject=name,
                app_envelope=envelope,
            )

        published = 0
        for public_key in keys:
            try:
                if public_key in nip17_keys:
                    ok, _ = self._publish_nip17(public_key, rumor)
                else:
                    event = self._legacy_private_event(
                        public_key,
                        {"v": 2, "type": "group_invite", "group_id": group["id"], "group": group},
                        [["g", group["id"]]],
                        "Omarchy Friends private group invite",
                    )
                    ok, relay_status = self._publish_global_event(event)
                    self.state["global"]["relays"].update(relay_status)
                published += int(ok)
            except (TypeError, ValueError):
                continue

        if rumor is not None and published:
            self._remember_local_private_rumor(rumor["id"])
            try:
                self._publish_nip17(own_key, rumor)
            except (TypeError, ValueError):
                pass

        if not published:
            self.save_state()
            return False, "Could not reach the group invite relay"

        self.state["global"].setdefault("groups", {})[group["id"]] = group
        self.state["global"]["groups"] = dict(list(self.state["global"]["groups"].items())[-MAX_GROUPS:])
        self.save_state()
        return True, f"Group {name} created"

    def send_group_message(self, group_id, text, media_url="", attachment_path="", attachment_is_folder=False, reply_to=None):
        self.last_sent_message_id = ""
        group_id = trim_text(group_id, 40).lower()
        group = self.state.setdefault("global", {}).setdefault("groups", {}).get(group_id)
        if not group:
            return False, "That group is no longer available"
        reply = self._normalize_reply_reference(reply_to, group_id=group_id) if reply_to else None
        if reply_to and not reply:
            return False, "That reply is no longer available in this group"
        text = trim_text(text, 2000)
        media = normalize_media_items(media_url)
        try:
            attachment = self._prepare_private_attachment(attachment_path, attachment_is_folder)
        except ValueError as error:
            return False, str(error)
        attachments = [attachment] if attachment else []
        if not text and not media and not attachments:
            return False, "Write a message or add a media link first"
        wire_text = text or ("Shared " + attachments[0]["name"] if attachments else "")

        identity = self._global_identity()
        recipient_keys = []
        for public_key in group.get("members", {}):
            if public_key == identity["public_key"]:
                continue
            if self.state["global"].get("friendships", {}).get(public_key, {}).get("status") == "friends":
                recipient_keys.append(public_key)

        nip17_keys = [key for key in recipient_keys if self._supports_nip17(key)]
        file_nip17 = bool(
            nip17_keys
            and attachments
            and attachments[0].get("transport") == "blossom"
            and all(self._supports_nip17_file_messages(key) for key in nip17_keys)
        )
        envelope = {
            "v": 3,
            "type": "group_message",
            "group_id": group_id,
            "text": wire_text,
            "media": media,
            "attachments": attachments,
            "reply_to": reply,
        }
        rumor = None
        if nip17_keys:
            rumor = create_nip17_rumor(
                identity["secret_key"],
                nip17_keys if file_nip17 else recipient_keys,
                attachments[0].get("url", "") if file_nip17 else (wire_text or "Shared media"),
                subject=group.get("name", "Group"),
                app_envelope=envelope,
                reply_to=reply["id"] if reply else "",
                file_metadata=attachments[0] if file_nip17 else None,
                kind=NIP17_FILE_KIND if file_nip17 else NIP17_MESSAGE_KIND,
            )

        legacy_events = {}
        for public_key in recipient_keys:
            if public_key in nip17_keys:
                continue
            legacy_events[public_key] = self._legacy_private_event(
                public_key,
                {"v": 2, "type": "group_message", "group_id": group_id, "text": wire_text, "media": media, "attachments": attachments, "reply_to": reply},
                [["g", group_id]],
                "Omarchy Friends private group message",
            )
        first_event_id = rumor["id"] if rumor else (next(iter(legacy_events.values()))["id"] if legacy_events else "")
        if not first_event_id:
            return False, "No available group members"
        self.last_sent_message_id = first_event_id
        retry_actions = [
            {"kind": "nip17_rumor", "recipient": public_key, "rumor": rumor}
            for public_key in nip17_keys
        ]
        retry_actions.extend(
            {"kind": "legacy_event", "recipient": public_key, "event": event}
            for public_key, event in legacy_events.items()
        )
        self._persist_outgoing_message({
            "id": first_event_id,
            "public_key": identity["public_key"],
            "handle": self.state["profile"].get("handle", "You"),
            "group_id": group_id,
            "group_name": group.get("name", "Group"),
            "message_type": "group_message",
            "text": wire_text,
            "media": media,
            "attachments": attachments,
            "reply_to": reply,
            "timestamp": now_seconds(),
            "incoming": False,
            "sendState": "Sending…",
            "retry_actions": retry_actions,
        })

        published = 0
        remaining_actions = []
        for action in retry_actions:
            public_key = action["recipient"]
            try:
                if action["kind"] == "nip17_rumor":
                    ok, _ = self._publish_nip17(public_key, action["rumor"])
                else:
                    event = action["event"]
                    ok, relay_status = self._publish_global_event(event)
                    self.state["global"]["relays"].update(relay_status)
                if ok:
                    published += 1
                else:
                    remaining_actions.append(action)
            except (TypeError, ValueError):
                remaining_actions.append(action)

        if rumor is not None and published:
            self._remember_local_private_rumor(rumor["id"])
            first_event_id = rumor["id"]

        if remaining_actions:
            self._persist_outgoing_message({
                "id": first_event_id,
                "sendState": "Partial · retry" if published else "Unconfirmed · retry",
                "retry_actions": remaining_actions,
                "retry_attempts": 0, "retry_at": now_seconds() + PRIVATE_AUTO_RETRY_DELAYS[0],
            })
            if published:
                return False, f"Delivery confirmed for {published} of {len(recipient_keys)} members; retry the remaining {len(remaining_actions)}"
            return False, "Could not reach any group member; retry is available"

        self._persist_outgoing_message({
            "id": first_event_id, "sendState": "Sent", "retry_actions": [],
            "retry_attempts": 0, "retry_at": 0,
        })
        return True, f"Sent to {group.get('name', 'group')}"

    def send_community_message(self, text):
        """Publish a short, signed message to the public Omarchy community room."""
        text = trim_text(text, 500)
        if not text:
            return False, "Write a community message first"
        identity = self._global_identity()
        event = build_event(
            identity["secret_key"],
            GLOBAL_COMMUNITY_KIND,
            [["t", GLOBAL_COMMUNITY_TAG], ["alt", "Omarchy Friends community message"]],
            json.dumps({
                "app": "omarchy-friends",
                "v": 1,
                "type": "community",
                "handle": self.state["profile"]["handle"],
                "avatar": self.state["profile"]["avatar"],
                "text": text,
            }, ensure_ascii=False, separators=(",", ":")),
        )
        ok, relay_status = self._publish_global_event(event)
        self.state["global"]["relays"].update(relay_status)
        if not ok:
            self.save_state()
            return False, "Could not reach the community right now"
        message = self._normalize_community_message({
            "id": event["id"],
            "public_key": identity["public_key"],
            "handle": self.state["profile"]["handle"],
            "avatar": self.state["profile"]["avatar"],
            "text": text,
            "timestamp": now_seconds(),
            "incoming": False,
        })
        if message:
            self.state["global"].setdefault("community", []).append(message)
            self.state["global"]["community"] = self.state["global"]["community"][-MAX_COMMUNITY_MESSAGES:]
            processed = self.state["global"].setdefault("processed_event_ids", [])
            if message["id"] not in processed:
                processed.append(message["id"])
                self.state["global"]["processed_event_ids"] = processed[-MAX_SEEN_EVENT_IDS:]
        self.save_state()
        return True, "Posted to the community"

    def _current_global_focus(self):
        focus = self.state.setdefault("global_focus", self._empty_global_focus())
        status = focus.get("status") if focus.get("status") in ("pending", "active") else "idle"
        now = now_seconds()
        if status == "pending":
            remaining = focus.get("started_at", 0) + GLOBAL_FOCUS_PENDING_SECONDS - now
            if remaining <= 0 or not focus.get("session_id") or not focus.get("buddy_public_key"):
                self.state["global_focus"] = self._empty_global_focus()
                status = "idle"
                remaining = 0
        elif status == "active":
            remaining = safe_int(focus.get("ends_at")) - now
            if remaining <= 0:
                self.state["global_focus"] = self._empty_global_focus()
                status = "idle"
                remaining = 0
        else:
            remaining = 0

        if status == "idle":
            focus = self.state["global_focus"]
        return {
            "status": status,
            "active": status == "active",
            "pending": status == "pending",
            "session_id": trim_text(focus.get("session_id"), 40),
            "buddy_public_key": trim_text(focus.get("buddy_public_key"), 64).lower(),
            "buddy_name": trim_text(focus.get("buddy_name"), 24),
            "buddy_avatar": focus.get("buddy_avatar") if focus.get("buddy_avatar") in AVAILABLE_AVATARS else "👾",
            "remaining_seconds": max(0, safe_int(remaining)),
            "total_seconds": safe_int(focus.get("total_seconds"), maximum=7200),
        }

    def global_focus_invite(self, public_key=None, duration_mins=GLOBAL_FOCUS_DEFAULT_MINUTES):
        """Invite one real online builder to a bounded shared focus session."""
        if self._current_global_focus()["status"] != "idle":
            return False, "Finish your current World focus ritual first"
        peers = self._global_peers()
        requested_key = trim_text(public_key, 64).lower() if public_key else ""
        peer = next((item for item in peers if item.get("public_key") == requested_key), None) if requested_key else None
        if peer is None and peers:
            peer = self._least_recently_pinged(peers)
        if not peer:
            return False, "No builders are online yet — refresh the World in a moment"
        duration_mins = safe_int(duration_mins, GLOBAL_FOCUS_DEFAULT_MINUTES, 5, 120)
        session_id = uuid.uuid4().hex
        ok, message = self.global_ping(
            peer["public_key"],
            "focus",
            session_id=session_id,
            minutes=duration_mins,
        )
        if not ok:
            return False, message
        started_at = now_seconds()
        self.state["global_focus"] = {
            "status": "pending",
            "session_id": session_id,
            "buddy_public_key": peer["public_key"],
            "buddy_name": peer.get("handle", "A builder"),
            "buddy_avatar": peer.get("avatar", "👾"),
            "started_at": started_at,
            "ends_at": 0,
            "total_seconds": duration_mins * 60,
        }
        self.save_state()
        return True, f"Invited {peer.get('handle', 'a builder')} to focus for {duration_mins} minutes"

    def _handle_global_focus_reply(self, ping):
        focus = self.state.setdefault("global_focus", self._empty_global_focus())
        if (
            focus.get("status") != "pending"
            or focus.get("session_id") != ping.get("session_id")
            or focus.get("buddy_public_key") != ping.get("public_key")
        ):
            return False
        peer = self.state.get("global", {}).get("peers", {}).get(ping["public_key"], ping)
        if ping.get("action") == "focus_accept":
            started_at = now_seconds()
            minutes = safe_int(ping.get("minutes"), GLOBAL_FOCUS_DEFAULT_MINUTES, 5, 120)
            self.state["global_focus"] = {
                "status": "active",
                "session_id": ping["session_id"],
                "buddy_public_key": ping["public_key"],
                "buddy_name": ping.get("handle") or peer.get("handle", "A builder"),
                "buddy_avatar": ping.get("avatar") or peer.get("avatar", "👾"),
                "started_at": started_at,
                "ends_at": started_at + minutes * 60,
                "total_seconds": minutes * 60,
            }
            message = f"{ping.get('handle', 'A builder')} joined your {minutes}m focus session."
            self._append_event("focus_accept", "✅", ping.get("handle"), ping.get("avatar"), message, ping.get("id"))
            self._append_pulse(peer, "focus", message, remote=True)
            return True
        if ping.get("action") == "focus_cancel":
            self.state["global_focus"] = self._empty_global_focus()
            message = f"{ping.get('handle', 'A builder')} ended the World focus ritual."
            self._append_event("focus_cancel", "⏹", ping.get("handle"), ping.get("avatar"), message, ping.get("id"))
            self._append_pulse(peer, "focus_cancel", message, remote=True)
            return True
        return False

    def global_focus_accept(self, ping_id):
        if self._current_global_focus()["status"] != "idle":
            return False, "Finish your current World focus ritual first"
        ping_id = trim_text(ping_id, 64).lower()
        ping = next(
            (item for item in self.state.get("global", {}).get("pings", []) if item.get("id") == ping_id),
            None,
        )
        if not ping or ping.get("action") != "focus":
            return False, "That focus invite is no longer available"
        if safe_int(ping.get("timestamp")) < now_seconds() - GLOBAL_FOCUS_PENDING_SECONDS:
            self.state["global"]["pings"] = [item for item in self.state["global"]["pings"] if item.get("id") != ping_id]
            self.save_state()
            return False, "That focus invite has expired"
        peer = self.state.get("global", {}).get("peers", {}).get(ping.get("public_key"))
        if peer is None or safe_int(peer.get("last_seen")) < now_seconds() - GLOBAL_PEER_TTL_SECONDS:
            # The invite outlives the lobby cache: a fresh invite proves they
            # were online moments ago, so accept from the ping itself.
            peer = None
        if peer is None and (not ping.get("handle") or not ping.get("public_key")):
            return False, "That builder is no longer online"
        minutes = safe_int(ping.get("minutes"), GLOBAL_FOCUS_DEFAULT_MINUTES, 5, 120)
        ok, message = self.global_ping(
            ping["public_key"],
            "focus_accept",
            session_id=ping.get("session_id"),
            minutes=minutes,
            allow_offline=True,
        )
        if not ok:
            return False, message
        started_at = now_seconds()
        self.state["global_focus"] = {
            "status": "active",
            "session_id": ping.get("session_id", ""),
            "buddy_public_key": ping["public_key"],
            "buddy_name": ping.get("handle", "A builder"),
            "buddy_avatar": ping.get("avatar", "👾"),
            "started_at": started_at,
            "ends_at": started_at + minutes * 60,
            "total_seconds": minutes * 60,
        }
        self.state["global"]["pings"] = [item for item in self.state["global"]["pings"] if item.get("id") != ping_id]
        message = f"You joined {ping.get('handle', 'a builder')} for {minutes} minutes"
        self._append_event("focus", "🍅", ping.get("handle"), ping.get("avatar"), message, ping_id)
        self._append_pulse(peer, "focus", message)
        self.save_state()
        return True, message

    def global_focus_cancel(self):
        focus = self._current_global_focus()
        if focus["status"] == "idle":
            return True, "No World focus ritual is active"
        if focus.get("buddy_public_key"):
            self.global_ping(
                focus["buddy_public_key"],
                "focus_cancel",
                session_id=focus.get("session_id"),
                minutes=max(5, safe_int(focus.get("total_seconds"), 1500) // 60),
            )
        self.state["global_focus"] = self._empty_global_focus()
        self.save_state()
        return True, "World focus ritual ended"

    def _global_relay_sync(self, relay_url, presence_event, since, dm_relay_event=None):
        """Publish presence/inbox metadata and collect current addressed events."""
        presence_sub = "ofp" + uuid.uuid4().hex[:12]
        ping_sub = "ofg" + uuid.uuid4().hex[:12]
        dm_sub = "ofdm" + uuid.uuid4().hex[:12]
        community_sub = "ofc" + uuid.uuid4().hex[:12]
        result = {
            "published": False,
            "acknowledged": False,
            "dm_relay_published": False,
            "dm_relay_acknowledged": False,
            "presence": [],
            "pings": [],
            "messages": [],
            "community": [],
        }
        ok_seen = presence_event is None
        dm_ok_seen = False
        with WebSocketClient(relay_url, timeout=3.5) as relay:
            if presence_event is not None:
                relay.send_json(["EVENT", presence_event])
            if dm_relay_event is not None:
                relay.send_json(["EVENT", dm_relay_event])
            relay.send_json(
                [
                    "REQ",
                    presence_sub,
                    {
                        "kinds": [GLOBAL_PRESENCE_KIND],
                        "#t": ["omarchy-friends"],
                        "since": max(0, now_seconds() - GLOBAL_PEER_TTL_SECONDS),
                        "limit": GLOBAL_MAX_PEERS,
                    },
                ]
            )
            relay.send_json(
                [
                    "REQ",
                    ping_sub,
                    {
                        "kinds": [GLOBAL_PING_KIND, GLOBAL_DM_KIND],
                        "#t": [GLOBAL_PING_TAG, GLOBAL_DM_TAG],
                        "#p": [self._global_identity()["public_key"]],
                        "since": max(0, since - 10),
                        "limit": GLOBAL_MAX_PINGS,
                    },
                ]
            )
            relay.send_json(
                [
                    "REQ",
                    dm_sub,
                    {
                        "kinds": [NIP59_GIFT_WRAP_KIND],
                        "#p": [self._global_identity()["public_key"]],
                        # Unlike kind-4 DMs, NIP-59 gift-wrap timestamps are
                        # randomized across a two-day window. A narrow delta
                        # from last_sync misses most wraps during explicit
                        # refresh/recovery when the persistent listener was
                        # unavailable. The rumor-id dedupe makes this bounded
                        # lookback safe for repeated refreshes.
                        "since": max(0, now_seconds() - NIP59_RANDOM_WINDOW_SECONDS - 1),
                        "limit": MAX_RELAY_DM_MESSAGES,
                    },
                ]
            )
            relay.send_json(
                [
                    "REQ",
                    community_sub,
                    {
                        "kinds": [GLOBAL_COMMUNITY_KIND],
                        "#t": [GLOBAL_COMMUNITY_TAG],
                        "since": max(0, now_seconds() - 86400),
                        "limit": MAX_COMMUNITY_MESSAGES,
                    },
                ]
            )
            eose = set()
            deadline = time.monotonic() + 3.5
            while time.monotonic() < deadline:
                if ok_seen and (dm_relay_event is None or dm_ok_seen) and len(eose) >= 4:
                    break
                message = relay.recv_json(max(0.05, min(0.5, deadline - time.monotonic())))
                if not isinstance(message, list) or not message:
                    continue
                if presence_event is not None and message[0] == "OK" and len(message) >= 3 and message[1] == presence_event["id"]:
                    ok_seen = True
                    result["acknowledged"] = True
                    result["published"] = bool(message[2])
                    if (dm_relay_event is None or dm_ok_seen) and len(eose) >= 4:
                        break
                elif dm_relay_event is not None and message[0] == "OK" and len(message) >= 3 and message[1] == dm_relay_event["id"]:
                    dm_ok_seen = True
                    result["dm_relay_acknowledged"] = True
                    result["dm_relay_published"] = bool(message[2])
                    if ok_seen and len(eose) >= 4:
                        break
                elif message[0] == "EVENT" and len(message) >= 3:
                    if message[1] == presence_sub:
                        result["presence"].append(message[2])
                    elif message[1] == ping_sub:
                        event = message[2]
                        if GLOBAL_DM_TAG in self._event_tag_values(event, "t"):
                            result["messages"].append(event)
                        else:
                            result["pings"].append(event)
                    elif message[1] == dm_sub:
                        result["messages"].append(message[2])
                    elif message[1] == community_sub:
                        result["community"].append(message[2])
                elif message[0] in ("EOSE", "CLOSED") and len(message) >= 2:
                    eose.add(message[1])
                    if len(eose) >= 4:
                        if ok_seen and (dm_relay_event is None or dm_ok_seen):
                            break
                        deadline = min(deadline, time.monotonic() + 0.8)
            if presence_event is not None and not ok_seen:
                # No matching OK means this relay did not confirm publication.
                # Do not claim visibility on an EOSE-only/read-only response.
                result["published"] = False
                result["acknowledged"] = False
            if dm_relay_event is not None and not dm_ok_seen:
                result["dm_relay_published"] = False
                result["dm_relay_acknowledged"] = False
            try:
                relay.send_json(["CLOSE", presence_sub])
                relay.send_json(["CLOSE", ping_sub])
                relay.send_json(["CLOSE", dm_sub])
                relay.send_json(["CLOSE", community_sub])
            except OSError:
                pass
        return result

    def _publish_event_to_relays(self, event, relay_urls):
        relay_urls = list(dict.fromkeys(
            self._normalize_nip17_dm_relays(relay_urls)
            if int(event.get("kind", -1)) == NIP59_GIFT_WRAP_KIND
            else (relay_urls or [])
        ))
        relay_status = {}

        def publish_one(relay_url):
            try:
                with WebSocketClient(relay_url, timeout=3.0) as relay:
                    relay.send_json(["EVENT", event])
                    accepted = False
                    ok_seen = False
                    deadline = time.monotonic() + 1.5
                    while time.monotonic() < deadline:
                        try:
                            message = relay.recv_json(max(0.05, deadline - time.monotonic()))
                        except EOFError:
                            break
                        if isinstance(message, list) and len(message) >= 3 and message[0] == "OK" and message[1] == event["id"]:
                            ok_seen = True
                            accepted = bool(message[2])
                            break
                    if accepted:
                        return relay_url, {"online": True, "accepted": accepted, "acknowledged": ok_seen}
                    elif not ok_seen:
                        return relay_url, {
                            "online": True,
                            "accepted": False,
                            "acknowledged": False,
                            "error": "No matching relay acknowledgement",
                        }
                    else:
                        return relay_url, {"online": True, "accepted": False, "acknowledged": True}
            except (OSError, ValueError, ssl.SSLError) as error:
                return relay_url, {"online": False, "error": trim_text(error, 120)}

        if not relay_urls:
            return False, relay_status
        if int(event.get("kind", -1)) == NIP59_GIFT_WRAP_KIND:
            # This CLI exits when send_dm returns. Detached daemon workers
            # would be terminated after the first ACK, so finish every relay
            # attempt concurrently before returning to preserve redundancy.
            with ThreadPoolExecutor(max_workers=min(NIP17_MAX_DM_RELAYS, len(relay_urls))) as pool:
                future_map = {pool.submit(publish_one, url): url for url in relay_urls}
                for future in as_completed(future_map):
                    url = future_map[future]
                    try:
                        _, relay_status[url] = future.result()
                    except Exception as error:
                        relay_status[url] = {"online": False, "error": trim_text(error, 120)}
            return any(item.get("accepted") for item in relay_status.values()), relay_status
        with ThreadPoolExecutor(max_workers=min(NIP17_MAX_DM_RELAYS, len(relay_urls))) as pool:
            future_map = {pool.submit(publish_one, url): url for url in relay_urls}
            for future in as_completed(future_map):
                url = future_map[future]
                try:
                    _, relay_status[url] = future.result()
                except Exception as error:
                    relay_status[url] = {"online": False, "error": trim_text(error, 120)}
        return any(item.get("accepted") for item in relay_status.values()), relay_status

    def _publish_global_event(self, event):
        return self._publish_event_to_relays(event, GLOBAL_RELAYS)

    def _apply_message_reaction(self, target_id, actor, handle, emoji, group_id=""):
        target_id = trim_text(target_id, 64).lower()
        actor = trim_text(actor, 64).lower()
        if emoji not in ALLOWED_MESSAGE_REACTIONS or not is_valid_public_key(actor):
            return False
        target = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == target_id), None)
        if not isinstance(target, dict) or target.get("deleted") or trim_text(target.get("group_id"), 40) != group_id:
            return False
        own_key = self._global_identity()["public_key"]
        if group_id:
            group = self.state.get("global", {}).get("groups", {}).get(group_id, {})
            if actor not in group.get("members", {}) or target.get("public_key") not in group.get("members", {}):
                return False
        elif target.get("conversation_key") != actor and not (actor == own_key and target.get("conversation_key")):
            return False
        reactions = target.setdefault("reactions", [])
        reactions[:] = [item for item in reactions if item.get("public_key") != actor]
        reactions.append({
            "emoji": emoji,
            "public_key": actor,
            "handle": trim_text(handle, 24) or ("You" if actor == own_key else "Friend"),
        })
        target["reactions"] = reactions[-MAX_MESSAGE_REACTIONS:]
        return True

    def _apply_message_deletion(self, target_id, actor, group_id=""):
        target_id = trim_text(target_id, 64).lower()
        actor = trim_text(actor, 64).lower()
        target = next((item for item in self.state.get("global", {}).get("messages", []) if item.get("id") == target_id), None)
        if not isinstance(target, dict):
            return False
        target_author = target.get("public_key") if target.get("group_id") or target.get("incoming") else self._global_identity()["public_key"]
        if target_author != actor:
            return False
        if trim_text(target.get("group_id"), 40) != trim_text(group_id, 40):
            return False
        target.update({
            "text": "Message deleted",
            "media": [],
            "attachments": [],
            "reply_to": None,
            "reactions": [],
            "deleted": True,
            "sendState": "",
        })
        for message in self.state.get("global", {}).get("messages", []):
            reply = message.get("reply_to") if isinstance(message, dict) else None
            if isinstance(reply, dict) and reply.get("id") == target_id:
                reply["text"] = "Message deleted"
        return True

    def _ingest_global_dm(self, event, *, notify=True, historical=False, validated_event_timestamps=None):
        """Store one raw relay DM event and raise its popup. Returns True when stored."""
        global_state = self.state.setdefault("global", {})
        processed_ids = global_state.setdefault("processed_event_ids", [])
        message = self._global_dm_from_event(event)
        if not message:
            return False
        if (
            validated_event_timestamps is not None
            and isinstance(event, dict)
            and safe_int(event.get("kind")) == NIP59_GIFT_WRAP_KIND
        ):
            event_timestamp = safe_int(event.get("created_at"), maximum=now_seconds() + 300000)
            if event_timestamp > 0:
                validated_event_timestamps.append(event_timestamp)
        own_key = self._global_identity()["public_key"]
        if message.get("public_key") == own_key:
            # NIP-17 self-copies are unnecessary because sent messages are
            # stored locally on successful publish; old self-copies must not
            # raise an incoming-message notification.
            return False
        is_nip17 = safe_int(event.get("kind")) == NIP59_GIFT_WRAP_KIND if isinstance(event, dict) else False
        seen_nip17 = global_state.setdefault("nip17_seen_rumors", {})
        if message["id"] in processed_ids or (is_nip17 and message["id"] in seen_nip17):
            return False
        if message["public_key"] in global_state.get("blocked_pubkeys", []):
            processed_ids.append(message["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            return False
        if not self._allow_global_signal(message["public_key"], category="private"):
            return False
        if is_nip17:
            self._remember_nip17_rumor(message["id"])
        if message.get("message_type") == "reaction":
            processed_ids.append(message["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            return self._apply_message_reaction(
                message.get("reaction_target_id"),
                message["public_key"],
                message.get("handle", "Friend"),
                message["text"],
                message.get("group_id", ""),
            )
        if message.get("message_type") == "delete":
            processed_ids.append(message["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            target_id = message.get("delete_target_id", "")
            if self._apply_message_deletion(target_id, message["public_key"], message.get("group_id", "")):
                return True
            # Relay ordering can deliver the deletion before the original.
            # Keep a small encrypted-state queue and validate author/group
            # again when the referenced message arrives.
            pending = global_state.setdefault("pending_private_deletions", {})
            if len(pending) >= 512 and target_id not in pending:
                oldest = next(iter(pending), None)
                if oldest:
                    pending.pop(oldest, None)
            pending[target_id] = {
                "actor": message["public_key"],
                "group_id": message.get("group_id", ""),
                "queued_at": now_seconds(),
            }
            return True
        if message.get("message_type") == "read_receipt":
            processed_ids.append(message["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            for target_id in message.get("read_receipt_target_ids", []):
                self._apply_message_read_receipt(target_id, message["public_key"], message.get("group_id", ""))
            return True
        if message.get("message_type") == "edit":
            processed_ids.append(message["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            target_id = message.get("edit_target_id", "")
            edit = {
                "actor": message["public_key"],
                "group_id": message.get("group_id", ""),
                "text": message.get("text", ""),
                "edited_at": message.get("timestamp", 0),
                "queued_at": now_seconds(),
            }
            if self._apply_message_edit(
                target_id, edit["actor"], edit["group_id"], edit["text"], edit["edited_at"]
            ):
                return True
            pending = global_state.setdefault("pending_private_edits", {})
            if len(pending) >= 512 and target_id not in pending:
                oldest = next(iter(pending), None)
                if oldest:
                    pending.pop(oldest, None)
            pending[target_id] = edit
            return True
        if message.get("message_type") == "group_invite":
            group = self._normalize_group(message.get("group_id"), message.get("group") or {})
            if not group:
                return False
            global_state.setdefault("groups", {})[group["id"]] = group
            global_state["groups"] = dict(list(global_state["groups"].items())[-MAX_GROUPS:])
        if message.get("incoming"):
            message["received_at_ms"] = (
                safe_int(message.get("timestamp")) * 1000
                if historical else time.time_ns() // 1_000_000
            )
        global_state.setdefault("messages", []).append(message)
        pending = global_state.setdefault("pending_private_deletions", {})
        deletion = pending.pop(message["id"], None)
        deleted_before_arrival = bool(
            deletion
            and safe_int(deletion.get("queued_at")) >= now_seconds() - NIP17_RUMOR_DEDUPE_SECONDS
            and self._apply_message_deletion(message["id"], deletion.get("actor", ""), deletion.get("group_id", ""))
        )
        pending_edits = global_state.setdefault("pending_private_edits", {})
        edit = pending_edits.pop(message["id"], None)
        edited_before_arrival = bool(
            edit
            and safe_int(edit.get("queued_at")) >= now_seconds() - NIP17_RUMOR_DEDUPE_SECONDS
            and self._apply_message_edit(
                message["id"], edit.get("actor", ""), edit.get("group_id", ""),
                edit.get("text", ""), edit.get("edited_at", 0),
            )
        )
        processed_ids.append(message["id"])
        global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
        if not deleted_before_arrival:
            self._remember_memory_signal(message["public_key"], "dm", "received", message.get("handle", ""), "")
            conversation_key = (
                "group:" + message["group_id"] if message.get("group_id")
                else "friend:" + message["public_key"]
            )
            if notify and conversation_key not in global_state.get("muted_conversations", []):
                label = f"New message in {message['group_name']}." if message.get("group_id") else f"New private message from {message['handle']}."
                self._append_event("dm", "💬", message["handle"], "💬", label, message["id"])
        return True

    def _ingest_global_community(self, event):
        """Store one raw relay community event and raise its popup. Returns True when stored."""
        global_state = self.state.setdefault("global", {})
        processed_ids = global_state.setdefault("processed_event_ids", [])
        message = self._global_community_from_event(event)
        if not message or message["id"] in processed_ids:
            return False
        if message["public_key"] in global_state.get("blocked_pubkeys", []):
            processed_ids.append(message["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            return False
        if not self._allow_global_signal(message["public_key"]):
            return False
        community = global_state.setdefault("community", [])
        community.append(message)
        global_state["community"] = community[-MAX_COMMUNITY_MESSAGES:]
        processed_ids.append(message["id"])
        global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
        if message.get("public_key") != self._global_identity()["public_key"]:
            preview = trim_text(message.get("text", ""), 120)
            self._append_event(
                "community", "🫂", message.get("handle", "A builder"),
                message.get("avatar", "👾"),
                f"{message.get('handle', 'A builder')}: {preview}",
                message["id"],
            )
        return True

    def _ingest_global_ping(self, event):
        """Store one raw relay ping event and raise its popup. Returns True when stored."""
        global_state = self.state.setdefault("global", {})
        processed_ids = global_state.setdefault("processed_event_ids", [])
        ping = self._global_ping_from_event(event)
        if not ping:
            return False
        if ping["id"] in processed_ids or any(item.get("id") == ping["id"] for item in global_state.get("pings", [])):
            return False
        if ping["public_key"] in global_state.get("blocked_pubkeys", []):
            return False
        if not self._allow_global_signal(ping["public_key"]):
            return False
        if ping.get("action") in ("focus_accept", "focus_cancel"):
            self._remember_memory_signal(ping["public_key"], ping.get("action"), "received", ping.get("handle", ""), ping.get("avatar", ""))
            self._handle_global_focus_reply(ping)
            processed_ids.append(ping["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            return True
        if ping.get("action") == "friend_decline":
            friendship = global_state.setdefault("friendships", {}).get(ping["public_key"], {})
            if friendship.get("status") == "pending" and (
                not ping.get("session_id")
                or not friendship.get("request_id")
                or friendship.get("request_id") == ping.get("session_id")
            ):
                global_state["friendships"].pop(ping["public_key"], None)
                self._remember_memory_signal(ping["public_key"], "friend_decline", "received", ping.get("handle", ""), ping.get("avatar", ""))
                self._append_event(
                    "friend_decline", "✕", ping.get("handle"), ping.get("avatar"),
                    f"{ping.get('handle', 'A builder')} declined your friend request.", ping["id"]
                )
            processed_ids.append(ping["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            return True
        if ping.get("action") == "friend_cancel":
            session_id = ping.get("session_id")
            if session_id:
                self._remember_handled_friend_request(ping)
            else:
                for item in global_state.get("pings", []):
                    if item.get("action") == "friend_request" and item.get("public_key") == ping["public_key"]:
                        self._remember_handled_friend_request(item)
            global_state["pings"] = [
                item for item in global_state.get("pings", [])
                if not (
                    item.get("action") == "friend_request"
                    and item.get("public_key") == ping["public_key"]
                    and (
                        not session_id
                        or not item.get("session_id")
                        or item.get("session_id") == session_id
                    )
                )
            ]
            self._remember_memory_signal(ping["public_key"], "friend_cancel", "received", ping.get("handle", ""), ping.get("avatar", ""))
            processed_ids.append(ping["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            return True
        if ping.get("action") == "friend_accept":
            friendship = global_state.setdefault("friendships", {}).get(ping["public_key"], {})
            if friendship.get("status") == "pending" and (
                not ping.get("session_id")
                or not friendship.get("request_id")
                or friendship.get("request_id") == ping.get("session_id")
            ):
                global_state["friendships"][ping["public_key"]] = {"status": "friends", "handle": ping.get("handle", "A builder"), "avatar": ping.get("avatar", "👾")}
                self.state["stats"]["friends_made"] += 1
                self._mark_friends_memory(ping["public_key"], ping.get("handle", ""), ping.get("avatar", ""))
                self._remember_memory_signal(ping["public_key"], "friend_accept", "received", ping.get("handle", ""), ping.get("avatar", ""))
                self._append_event("friend_accept", "✅", ping.get("handle"), ping.get("avatar"), f"You and {ping.get('handle', 'a builder')} are now friends.", ping["id"])
            processed_ids.append(ping["id"])
            global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
            return True
        if ping.get("action") == "friend_request":
            if self._friend_request_key(ping) in global_state.setdefault("handled_friend_requests", []):
                processed_ids.append(ping["id"])
                global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
                return False
            friendship = global_state.setdefault("friendships", {}).get(ping["public_key"], {})
            if friendship.get("status") == "pending":
                global_state["friendships"][ping["public_key"]] = {"status": "friends", "handle": ping.get("handle", "A builder"), "avatar": ping.get("avatar", "👾")}
                self.state["stats"]["friends_made"] += 1
                self._mark_friends_memory(ping["public_key"], ping.get("handle", ""), ping.get("avatar", ""))
                self._remember_memory_signal(ping["public_key"], "friend_request", "received", ping.get("handle", ""), ping.get("avatar", ""))
                self._append_event("friend_accept", "✅", ping.get("handle"), ping.get("avatar"), f"You and {ping.get('handle', 'a builder')} are now mutual friends.", ping["id"])
                self.global_ping(ping["public_key"], "friend_accept", session_id=ping.get("session_id"), allow_offline=True)
                self._remember_handled_friend_request(ping)
                processed_ids.append(ping["id"])
                global_state["processed_event_ids"] = processed_ids[-MAX_SEEN_EVENT_IDS:]
                return True
        global_state.setdefault("pings", []).append(ping)
        self._remember_memory_signal(ping["public_key"], ping.get("action"), "received", ping.get("handle", ""), ping.get("avatar", ""))
        peer = global_state.get("peers", {}).get(ping["public_key"], ping)
        icon, label = GLOBAL_ACTION_META[ping["action"]]
        text = f"{ping['handle']} sent you {label}."
        if ping.get("prompt"):
            text += f" {ping['prompt']}"
        self._append_event(ping["action"], icon, ping["handle"], ping["avatar"], text, ping["id"])
        self._append_pulse(peer, ping["action"], text, remote=True)
        global_state["pings"] = global_state["pings"][-GLOBAL_MAX_PINGS:]
        return True

    def _ingest_global_presence(self, event):
        """Merge one raw relay presence event into the lobby. Returns True when merged."""
        peer = self._global_peer_from_event(event)
        if not peer:
            return False
        global_state = self.state.setdefault("global", {})
        key = peer["public_key"]
        if safe_int(peer.get("last_seen")) >= safe_int(global_state.get("peers", {}).get(key, {}).get("last_seen", 0)):
            is_new = key not in global_state.get("peers", {})
            global_state.setdefault("peers", {})[key] = peer
            self._touch_memory(key, peer.get("handle", ""), peer.get("avatar", ""), encounter=is_new)
            return True
        return False

    def _official_latest_version(self, global_state):
        """Return the latest version advertised by the canonical public manifest.

        This performs a bounded metadata-only HTTPS read. It never downloads or
        executes plugin code. Users can disable the check with
        OMARCHY_FRIENDS_RELEASE_CHECK=0; peer-version gossip remains available.
        Successful checks are cached for six hours and failed attempts back off
        for thirty minutes so the normal four-second status refresh cannot hammer
        GitHub or stall the UI.
        """
        cached_text = trim_text(global_state.get("official_latest_version"), 16)
        cached = parse_plugin_version(cached_text)
        flag = str(os.environ.get("OMARCHY_FRIENDS_RELEASE_CHECK", "1")).strip().lower()
        if flag in {"0", "false", "off", "no"}:
            return cached

        now = now_seconds()
        last_attempt = safe_int(global_state.get("last_release_check"))
        last_success = safe_int(global_state.get("last_release_check_success"))
        if cached and last_success and now - last_success < OFFICIAL_RELEASE_CHECK_SECONDS:
            return cached
        if last_attempt and now - last_attempt < OFFICIAL_RELEASE_RETRY_SECONDS:
            return cached

        global_state["last_release_check"] = now
        try:
            request = urllib.request.Request(
                OFFICIAL_MANIFEST_URL,
                headers={"User-Agent": f"omarchy-friends/{PLUGIN_VERSION}"},
                method="GET",
            )
            with urllib.request.urlopen(request, timeout=OFFICIAL_RELEASE_TIMEOUT_SECONDS) as response:
                payload = response.read(OFFICIAL_MANIFEST_MAX_BYTES + 1)
            if len(payload) > OFFICIAL_MANIFEST_MAX_BYTES:
                raise ValueError("manifest response is too large")
            document = json.loads(payload.decode("utf-8"))
            version_text = trim_text(document.get("version") if isinstance(document, dict) else "", 16)
            parsed = parse_plugin_version(version_text)
            if not parsed:
                raise ValueError("manifest version is invalid")
            global_state["official_latest_version"] = version_text
            global_state["last_release_check_success"] = now
            self.save_state()
            return parsed
        except (OSError, TimeoutError, UnicodeError, ValueError):
            # Update discovery must never make Friends unavailable. Persist only
            # the attempt time for bounded retry and keep any last-known-good
            # version. Peer gossip remains a second independent signal.
            self.save_state()
            return cached

    def _refresh_update_status(self):
        """Compare our version against both official metadata and live peers.

        A newer observed version raises one local event per version so the
        persistent deck banner points at the explicit one-click updater. Code is
        never downloaded or executed by this check.
        """
        global_state = self.state.setdefault("global", {})
        own = parse_plugin_version(PLUGIN_VERSION) or (0, 0, 0)
        latest = own

        official = self._official_latest_version(global_state)
        if official and official > latest:
            latest = official

        for peer in global_state.get("peers", {}).values():
            if not isinstance(peer, dict):
                continue
            parsed = parse_plugin_version(peer.get("plugin_version"))
            if parsed and parsed > latest:
                latest = parsed

        latest_text = f"{latest[0]}.{latest[1]}.{latest[2]}"
        available = latest > own
        global_state["update_available"] = available
        global_state["latest_version"] = latest_text if available else PLUGIN_VERSION
        if available and global_state.get("last_notified_update") != latest_text:
            global_state["last_notified_update"] = latest_text
            self._append_event(
                "update", "↻", "Omarchy Friends", "👾",
                f"Friends {latest_text} is out (you have {PLUGIN_VERSION}). Open the deck and tap Update.",
            )
        return available

    @staticmethod
    def _world_event():
        """The weekly Ship-It Friday hour all builders share. Fridays 18:00 UTC, one hour."""
        now = now_seconds()
        days = time.gmtime(now)
        # Monday=0 … Sunday=6; Friday=4.
        weekday = days.tm_wday
        midnight = now - (days.tm_hour * 3600 + days.tm_min * 60 + days.tm_sec)
        days_until_friday = (4 - weekday) % 7
        friday_18 = midnight + days_until_friday * 86400 + 18 * 3600
        if now >= friday_18 and now < friday_18 + 3600:
            return {"title": "Ship-It Friday", "live": True, "label": "Live now — open World and say hello"}
        if now >= friday_18 + 3600:
            friday_18 += 7 * 86400
        delta = friday_18 - now
        days_left, remainder = divmod(delta, 86400)
        hours_left = remainder // 3600
        if days_left > 0:
            label = f"In {days_left}d {hours_left}h — every Friday 18:00 UTC"
        elif hours_left > 0:
            label = f"In {hours_left}h — every Friday 18:00 UTC"
        else:
            label = "Starting in under an hour — every Friday 18:00 UTC"
        return {"title": "Ship-It Friday", "live": False, "label": label}

    def dismiss_nudge(self):
        self.state["invite_nudge"] = False
        self.state["invite_nudge_dismissed"] = True
        self.save_state()
        return True

    def _fetch_private_history_from_relay(self, relay_url, own_public_key, until=None):
        """Read one bounded inbox-history page without publishing anything."""
        subscription_id = "ofh" + uuid.uuid4().hex[:12]
        events = []
        encoded_bytes = 0
        complete = False
        deadline = time.monotonic() + 8.0
        with WebSocketClient(relay_url, timeout=8.0) as relay:
            event_filter = {
                "kinds": [NIP59_GIFT_WRAP_KIND],
                "#p": [own_public_key],
                "limit": MAX_RELAY_DM_MESSAGES,
            }
            if until:
                event_filter["until"] = safe_int(until, maximum=now_seconds() + 300000)
            relay.send_json([
                "REQ", subscription_id,
                event_filter,
            ])
            while time.monotonic() < deadline and len(events) < MAX_RELAY_DM_MESSAGES:
                try:
                    message = relay.recv_json(min(0.5, max(0.05, deadline - time.monotonic())))
                except EOFError:
                    return events, False
                if not isinstance(message, list) or not message:
                    continue
                if message[0] == "CLOSED" and len(message) > 1 and message[1] == subscription_id:
                    return events, False
                if message[0] == "EOSE" and len(message) > 1 and message[1] == subscription_id:
                    complete = True
                    break
                if (message[0] != "EVENT" or len(message) < 3 or message[1] != subscription_id
                        or not isinstance(message[2], dict)):
                    continue
                event = message[2]
                event_id = trim_text(event.get("id"), 64).lower()
                if not re.fullmatch(r"[0-9a-f]{64}", event_id):
                    continue
                encoded_bytes += len(json.dumps(event, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))
                # A relay is untrusted. Bound retained response memory even if
                # it ignores the requested event limit or returns huge events.
                if encoded_bytes > 16 * 1024 * 1024:
                    break
                events.append(event)
        return events, complete

    def sync_private_history(self):
        """User-requested bounded recovery from the configured NIP-17 inbox relays."""
        identity = self._global_identity()
        own_public_key = identity["public_key"]
        relay_urls = tuple(dict.fromkeys(NIP17_DM_RELAYS))
        if not relay_urls:
            return False, "No private inbox relays are configured", 0, 0, 0

        global_state = self.state.setdefault("global", {})
        cursors = global_state.setdefault("private_history_cursors", {})
        active_relays = tuple(
            relay_url for relay_url in relay_urls
            if not (isinstance(cursors.get(relay_url), dict) and cursors[relay_url].get("done") is True)
        )
        if not active_relays:
            return True, "Inbox relays have no older history pages remaining", 0, 0, 0

        relay_results = {}
        with ThreadPoolExecutor(max_workers=min(NIP17_MAX_DM_RELAYS, len(relay_urls))) as pool:
            futures = {
                pool.submit(
                    self._fetch_private_history_from_relay,
                    relay_url,
                    own_public_key,
                    (cursors.get(relay_url) or {}).get("until"),
                ): relay_url
                for relay_url in active_relays
            }
            for future in as_completed(futures):
                relay_url = futures[future]
                try:
                    relay_results[relay_url] = future.result()
                except (OSError, ValueError, ssl.SSLError, EOFError) as error:
                    relay_results[relay_url] = ([], False, trim_text(error, 120))

        checked_relays = sum(1 for result in relay_results.values() if len(result) == 2)
        if not checked_relays:
            return False, "Could not reach any configured private inbox relay", 0, 0, 0
        completed_relays = sum(1 for result in relay_results.values() if len(result) == 2 and result[1])

        # Refresh after network I/O so a concurrent live listener's messages
        # are merged before historical events are deduplicated and persisted.
        self.state = self.load_state()
        global_state = self.state.setdefault("global", {})
        cursors = global_state.setdefault("private_history_cursors", {})
        restored = 0
        cursor_changed = False
        for relay_url, result in relay_results.items():
            if len(result) != 2:
                continue
            events, complete = result
            authenticated_timestamps = []
            for event in events:
                try:
                    if self._ingest_global_dm(
                        event,
                        notify=False,
                        historical=True,
                        validated_event_timestamps=authenticated_timestamps,
                    ):
                        restored += 1
                except (TypeError, ValueError, OverflowError, KeyError, UnicodeError, json.JSONDecodeError):
                    continue
            old_cursor = cursors.get(relay_url) if isinstance(cursors.get(relay_url), dict) else {}
            next_cursor = {"until": safe_int(old_cursor.get("until")), "done": False}
            if complete and len(events) < MAX_RELAY_DM_MESSAGES:
                next_cursor["done"] = True
            elif len(events) >= MAX_RELAY_DM_MESSAGES and authenticated_timestamps:
                previous_until = safe_int(old_cursor.get("until"))
                page_timestamps = [
                    timestamp for timestamp in authenticated_timestamps
                    if not previous_until or timestamp <= previous_until
                ]
                oldest = min(page_timestamps) if page_timestamps else 0
                # NIP-01 cursors are timestamp based. Move just before the
                # oldest authenticated gift wrap so the next page is older.
                if oldest:
                    next_cursor["until"] = max(0, oldest - 1)
            else:
                # A short page without EOSE (timeout, disconnect, or the byte
                # cap) cannot prove exhaustion and must not advance the cursor.
                if old_cursor:
                    next_cursor = {"until": safe_int(old_cursor.get("until")), "done": False}
                else:
                    next_cursor = {"until": 0, "done": False}
            if next_cursor != old_cursor:
                cursors[relay_url] = next_cursor
                cursor_changed = True
        if restored or cursor_changed:
            self.save_state()
        if restored:
            message = f"Restored {restored} private message(s) from inbox relays"
        else:
            message = "Inbox relays checked; no additional private messages were available"
        remaining = sum(
            1 for relay_url in relay_urls
            if not (isinstance(cursors.get(relay_url), dict) and cursors[relay_url].get("done") is True)
        )
        if remaining:
            message += f"; older pages may remain on {remaining} relay(s)"
        if completed_relays < checked_relays:
            message += f" ({completed_relays} of {checked_relays} checked relays completed this page)"
        return True, message, restored, checked_relays, completed_relays

    def sync_global(self):
        """Publish the current presence and refresh the public lobby."""
        global_state = self.state.setdefault("global", {})
        visible = bool(self.state["profile"].get("privacy", {}).get("share_global", False))
        presence_event = self._global_presence_event() if visible else None
        dm_relay_event = None
        if (
            NIP17_DM_RELAYS
            and now_seconds() - safe_int(global_state.get("dm_relay_list_last_publish")) >= NIP17_DM_RELAY_REFRESH_SECONDS
        ):
            dm_relay_event = self._dm_relay_list_event()
        sync_since = max(0, safe_int(global_state.get("last_sync")) - 10)
        peers = {}
        relay_counts = {}
        pings = []
        messages = []
        community_events = []
        relay_status = {}
        successes = 0
        published = False
        dm_relay_published = False
        errors = []
        for relay_url in GLOBAL_RELAYS:
            try:
                result = self._global_relay_sync(relay_url, presence_event, sync_since, dm_relay_event)
                successes += 1
                published = published or bool(result.get("published"))
                dm_relay_published = dm_relay_published or bool(result.get("dm_relay_published"))
                relay_status[relay_url] = {
                    "online": True,
                    "accepted": bool(result.get("published")),
                    "acknowledged": bool(result.get("acknowledged")),
                    "error": "",
                }
                for event in result.get("presence", []):
                    peer = self._global_peer_from_event(event)
                    if not peer:
                        continue
                    key = peer["public_key"]
                    if safe_int(peer.get("last_seen")) >= safe_int(peers.get(key, {}).get("last_seen")):
                        peers[key] = peer
                    relay_counts.setdefault(key, set()).add(relay_url)
                for event in result.get("pings", []):
                    pings.append(event)
                messages.extend(result.get("messages", []))
                community_events.extend(result.get("community", []))
            except (OSError, ValueError, ssl.SSLError, EOFError) as error:
                message = trim_text(error, 120)
                errors.append(f"{relay_url}: {message}")
                relay_status[relay_url] = {
                    "online": False,
                    "accepted": False,
                    "acknowledged": False,
                    "error": message,
                }

        for key, peer in peers.items():
            peer["relay_count"] = len(relay_counts.get(key, set()))
        if successes:
            global_state["peers"].update(peers)
            for key, peer in peers.items():
                self._touch_memory(key, peer.get("handle", ""), peer.get("avatar", ""), encounter=True)
        for event in messages:
            try:
                self._ingest_global_dm(event)
            except (TypeError, ValueError, OverflowError, KeyError, UnicodeError, json.JSONDecodeError):
                continue
        for event in community_events:
            try:
                self._ingest_global_community(event)
            except (TypeError, ValueError, OverflowError, KeyError, UnicodeError, json.JSONDecodeError):
                continue
        global_state["community"] = global_state.get("community", [])[-MAX_COMMUNITY_MESSAGES:]
        for event in pings:
            try:
                self._ingest_global_ping(event)
            except (TypeError, ValueError, OverflowError, KeyError, UnicodeError, json.JSONDecodeError):
                continue
        global_state["pings"] = global_state.get("pings", [])[-GLOBAL_MAX_PINGS:]

        if successes:
            global_state["last_sync"] = now_seconds()
            global_state["last_publish"] = now_seconds() if published else global_state.get("last_publish", 0)
            if dm_relay_event is not None and dm_relay_published:
                global_state["dm_relay_list_last_publish"] = now_seconds()
            global_state["last_error"] = "" if (published or not visible) else "Relays reached, but presence was not accepted"
        else:
            global_state["last_error"] = "No public relay answered" if not errors else trim_text(errors[0], 180)
        global_state["relays"] = relay_status
        self._cleanup_global_peers()
        self._refresh_update_status()
        self.save_state()
        if successes and published:
            return True, f"Visible to the Omarchy World ({len(self._global_peers())} online)"
        if successes and not visible:
            return True, f"World refreshed; hidden from discovery ({len(self._global_peers())} online)"
        if successes:
            return True, "World refreshed; presence is waiting for relay acceptance"
        return False, "World is offline; local radar still works"

    def listen_global(self):
        """Hold live subscriptions across every configured private inbox relay.

        NIP-17 senders publish the same gift wrap to the recipient's advertised
        inbox relays.  Listening to only one relay can strand valid messages when
        that relay is reachable but idle or has a read-path problem, so one
        process keeps all configured inbox subscriptions alive and ingests them
        through the same state owner.
        """
        failures = 0
        shell_parent = self._quickshell_parent_snapshot()
        while True:
            # Quickshell can crash/restart without waiting for its long-lived
            # child processes. Do not leave stale relay subscriptions orphaned.
            if not self._quickshell_parent_alive(shell_parent):
                return
            self.state = self.load_state()
            listen_relays = tuple(dict.fromkeys(NIP17_DM_RELAYS or GLOBAL_RELAYS))
            if not listen_relays:
                time.sleep(30)
                continue
            try:
                self._listen_on_relays(listen_relays)
                failures = 0
            except (OSError, ValueError, ssl.SSLError, EOFError):
                failures += 1
                time.sleep(min(30, 2 * failures))

    def _open_global_listener_connection(
        self, relay_url, identity, presence_event, dm_relay_event, started_at
    ):
        relay = WebSocketClient(relay_url, timeout=5.0)
        ping_sub = "ofl" + uuid.uuid4().hex[:12]
        dm_sub = "ofdl" + uuid.uuid4().hex[:12]
        community_sub = "ofcl" + uuid.uuid4().hex[:12]
        presence_sub = "ofpl" + uuid.uuid4().hex[:12]
        try:
            if presence_event is not None:
                relay.send_json(["EVENT", presence_event])
            if dm_relay_event is not None:
                relay.send_json(["EVENT", dm_relay_event])
            relay.send_json([
                "REQ", ping_sub,
                {
                    "kinds": [GLOBAL_PING_KIND, GLOBAL_DM_KIND],
                    "#t": [GLOBAL_PING_TAG, GLOBAL_DM_TAG],
                    "#p": [identity["public_key"]],
                    "since": max(0, started_at - 60),
                    "limit": GLOBAL_MAX_PINGS,
                },
            ])
            relay.send_json([
                "REQ", dm_sub,
                {
                    "kinds": [NIP59_GIFT_WRAP_KIND],
                    "#p": [identity["public_key"]],
                    # NIP-59 gift wraps intentionally randomize their outer
                    # timestamp over the two-day privacy window. A short
                    # listener lookback can otherwise miss a live DM even
                    # when every inbox relay is connected and delivering.
                    "since": max(0, started_at - NIP59_RANDOM_WINDOW_SECONDS - 1),
                    "limit": MAX_RELAY_DM_MESSAGES,
                },
            ])
            relay.send_json([
                "REQ", community_sub,
                {
                    "kinds": [GLOBAL_COMMUNITY_KIND],
                    "#t": [GLOBAL_COMMUNITY_TAG],
                    "since": max(0, started_at - 300),
                    "limit": 20,
                },
            ])
            relay.send_json([
                "REQ", presence_sub,
                {
                    "kinds": [GLOBAL_PRESENCE_KIND],
                    "#t": ["omarchy-friends"],
                    "since": max(0, started_at - GLOBAL_PEER_TTL_SECONDS),
                    "limit": GLOBAL_MAX_PEERS,
                },
            ])
        except (OSError, ValueError, ssl.SSLError, EOFError):
            relay.close()
            raise
        return {
            "url": relay_url,
            "relay": relay,
            "ping_sub": ping_sub,
            "dm_sub": dm_sub,
            "community_sub": community_sub,
            "presence_sub": presence_sub,
            "presence_event_id": presence_event.get("id", "") if presence_event else "",
            "last_presence": time.monotonic(),
        }

    @staticmethod
    def _close_global_listener_connection(connection):
        try:
            connection["relay"].close()
        except (OSError, ValueError, ssl.SSLError, EOFError):
            pass

    def _handle_global_listener_message(self, connection, message):
        if not isinstance(message, list) or not message:
            return False
        if message[0] == "CLOSED":
            raise OSError("relay closed listen subscription")
        if message[0] != "EVENT" or len(message) < 3:
            return False

        # The LAN daemon and user actions are separate processes.  Reload just
        # before an event mutation so a duplicate gift arriving on two relays
        # deduplicates against the freshest persisted state instead of letting a
        # stale listener snapshot overwrite a newer message.
        self.state = self.load_state()
        global_state = self.state.setdefault("global", {})
        sub_id = message[1] if len(message) > 1 else ""
        event = message[2]
        stored = False
        try:
            if sub_id == connection["ping_sub"]:
                if GLOBAL_DM_TAG in self._event_tag_values(event, "t"):
                    stored = self._ingest_global_dm(event)
                else:
                    stored = self._ingest_global_ping(event)
            elif sub_id == connection["dm_sub"]:
                stored = self._ingest_global_dm(event)
            elif sub_id == connection["community_sub"]:
                stored = self._ingest_global_community(event)
            elif sub_id == connection["presence_sub"]:
                stored = self._ingest_global_presence(event)
                if stored:
                    self._refresh_update_status()
            else:
                return False
        except (ValueError, TypeError, AttributeError):
            return False

        if stored:
            global_state["last_sync"] = now_seconds()
            self._cleanup_global_peers()
            self.save_state()
        return stored

    def _listen_on_relays(self, relay_urls, max_cycles=None):
        """Multiplex a small bounded relay set in one state-owning process.

        ``max_cycles`` exists only to make the relay fan-in deterministic in
        unit tests; production callers leave it as ``None``.
        """
        relay_urls = tuple(
            dict.fromkeys(
                relay_url
                for relay_url in (relay_urls or ())
                if isinstance(relay_url, str) and relay_url in GLOBAL_RELAYS
            )
        )
        if not relay_urls:
            raise OSError("no configured listener relay")

        global_state = self.state.setdefault("global", {})
        relay_state = global_state.setdefault("relays", {})
        identity = self._global_identity()
        presence_event = (
            self._global_presence_event()
            if self.state["profile"].get("privacy", {}).get("share_global", False)
            else None
        )
        dm_relay_event = None
        if (
            NIP17_DM_RELAYS
            and now_seconds() - safe_int(global_state.get("dm_relay_list_last_publish")) >= NIP17_DM_RELAY_REFRESH_SECONDS
        ):
            dm_relay_event = self._dm_relay_list_event()

        started_at = now_seconds()
        connections = {}
        for relay_url in relay_urls:
            try:
                connection = self._open_global_listener_connection(
                    relay_url, identity, presence_event, dm_relay_event, started_at
                )
                connections[relay_url] = connection
                relay_state[relay_url] = {"online": True, "accepted": True}
            except (OSError, ValueError, ssl.SSLError, EOFError) as error:
                relay_state[relay_url] = {
                    "online": False,
                    "error": trim_text(error, 120),
                }

        if not connections:
            global_state["last_error"] = "No private inbox relay answered"
            self.save_state()
            raise OSError("no private inbox relay answered")

        global_state["last_sync"] = now_seconds()
        if presence_event is not None:
            global_state["last_publish"] = now_seconds()
        if dm_relay_event is not None:
            global_state["dm_relay_list_last_publish"] = now_seconds()
        global_state["last_error"] = ""
        self.save_state()

        last_reload = time.monotonic()
        last_reconnect = time.monotonic()
        last_presence = time.monotonic()
        cycles = 0
        try:
            while True:
                if max_cycles is not None and cycles >= max_cycles:
                    return
                cycles += 1
                monotonic_now = time.monotonic()

                if monotonic_now - last_reload >= GLOBAL_LISTENER_STATE_REFRESH_SECONDS:
                    self.state = self.load_state()
                    global_state = self.state.setdefault("global", {})
                    relay_state = global_state.setdefault("relays", {})
                    last_reload = monotonic_now
                    visible = bool(self.state["profile"].get("privacy", {}).get("share_global", False))
                    was_visible = presence_event is not None
                    if visible != was_visible:
                        if visible:
                            presence_event = self._global_presence_event()
                            for relay_url, connection in list(connections.items()):
                                try:
                                    connection["relay"].send_json(["EVENT", presence_event])
                                    connection["presence_event_id"] = presence_event["id"]
                                except (OSError, ValueError, ssl.SSLError, EOFError) as error:
                                    relay_state[relay_url] = {"online": False, "error": trim_text(error, 120)}
                                    self._close_global_listener_connection(connection)
                                    connections.pop(relay_url, None)
                            global_state["last_publish"] = now_seconds()
                        else:
                            previous_id = presence_event.get("id", "")
                            presence_event = None
                            if previous_id:
                                deletion = build_event(
                                    identity["secret_key"], 5,
                                    [["e", previous_id], ["k", str(GLOBAL_PRESENCE_KIND)]], ""
                                )
                                for relay_url, connection in list(connections.items()):
                                    try:
                                        connection["relay"].send_json(["EVENT", deletion])
                                    except (OSError, ValueError, ssl.SSLError, EOFError):
                                        pass
                        self.save_state()

                if monotonic_now - last_presence >= GLOBAL_PRESENCE_REFRESH_SECONDS:
                    # Presence is identical across inbox relays; refresh it on
                    # each connection before waiting for inbound traffic. The
                    # payload is cached once, so re-sign only its heartbeat
                    # timestamp instead of repeatedly querying desktop APIs.
                    if presence_event is not None:
                        presence_event = self._fresh_global_presence_event(presence_event)
                        for relay_url, connection in list(connections.items()):
                            try:
                                connection["relay"].send_json(["EVENT", presence_event])
                                connection["presence_event_id"] = presence_event["id"]
                            except (OSError, ValueError, ssl.SSLError, EOFError) as error:
                                relay_state[relay_url] = {
                                    "online": False,
                                    "error": trim_text(error, 120),
                                }
                                self._close_global_listener_connection(connection)
                                connections.pop(relay_url, None)
                        global_state["last_publish"] = now_seconds()
                    last_presence = monotonic_now

                ready_relays = []
                socket_owners = {
                    connection["relay"].sock: relay_url
                    for relay_url, connection in connections.items()
                    if getattr(connection["relay"], "sock", None) is not None
                }
                nonselectable_relays = [
                    relay_url for relay_url, connection in connections.items()
                    if getattr(connection["relay"], "sock", None) is None
                ]
                until_presence = max(0.0, GLOBAL_PRESENCE_REFRESH_SECONDS - (monotonic_now - last_presence))
                until_reconnect = max(0.0, 15.0 - (monotonic_now - last_reconnect))
                until_reload = max(
                    0.0,
                    GLOBAL_LISTENER_STATE_REFRESH_SECONDS - (monotonic_now - last_reload),
                )
                wait_timeout = min(until_presence, until_reconnect, until_reload, 30.0)
                if socket_owners:
                    try:
                        readable, _, exceptional = select.select(
                            list(socket_owners), [], list(socket_owners),
                            0.15 if nonselectable_relays else wait_timeout,
                        )
                    except (OSError, ValueError) as error:
                        raise OSError("private inbox relay select failed") from error
                    failed_sockets = set(exceptional)
                    for ready_socket in readable:
                        ready_relays.append(socket_owners[ready_socket])
                    for failed_socket in failed_sockets:
                        relay_url = socket_owners.get(failed_socket)
                        if relay_url is None:
                            continue
                        connection = connections.pop(relay_url)
                        relay_state[relay_url] = {
                            "online": False,
                            "error": "relay socket reported an exceptional condition",
                        }
                        self._close_global_listener_connection(connection)
                ready_relays.extend(nonselectable_relays)
                # Rotating the first ready socket bounds starvation if one
                # relay has a sustained event backlog.
                if ready_relays:
                    offset = cycles % len(ready_relays)
                    ready_relays = ready_relays[offset:] + ready_relays[:offset]
                for relay_url in ready_relays:
                    connection = connections.get(relay_url)
                    if connection is None:
                        continue
                    try:
                        message = connection["relay"].recv_json(timeout=0.5)
                    except (OSError, ValueError, ssl.SSLError, EOFError) as error:
                        relay_state[relay_url] = {
                            "online": False,
                            "error": trim_text(error, 120),
                        }
                        self._close_global_listener_connection(connection)
                        connections.pop(relay_url, None)
                        continue
                    if message is not None:
                        self._handle_global_listener_message(connection, message)

                if not connections:
                    global_state["last_error"] = "All private inbox relay listeners disconnected"
                    self.save_state()
                    raise OSError("all private inbox relay listeners disconnected")

                # A single relay can recover while the others remain healthy.
                # Reconnect missing configured inboxes without tearing down the
                # subscriptions that are already delivering messages.
                if monotonic_now - last_reconnect >= 15:
                    missing = [relay_url for relay_url in relay_urls if relay_url not in connections]
                    if missing:
                        self.state = self.load_state()
                        global_state = self.state.setdefault("global", {})
                        relay_state = global_state.setdefault("relays", {})
                        identity = self._global_identity()
                        presence_event = (
                            self._global_presence_event()
                            if self.state["profile"].get("privacy", {}).get("share_global", False)
                            else None
                        )
                        for relay_url in missing:
                            try:
                                connection = self._open_global_listener_connection(
                                    relay_url,
                                    identity,
                                    presence_event,
                                    None,
                                    now_seconds(),
                                )
                                connections[relay_url] = connection
                                relay_state[relay_url] = {"online": True, "accepted": True}
                            except (OSError, ValueError, ssl.SSLError, EOFError) as error:
                                relay_state[relay_url] = {
                                    "online": False,
                                    "error": trim_text(error, 120),
                                }
                        self.save_state()
                    last_reconnect = monotonic_now
        finally:
            for connection in list(connections.values()):
                self._close_global_listener_connection(connection)

    def _listen_on_relay(self, relay_url):
        """Compatibility wrapper for targeted tests and diagnostics."""
        return self._listen_on_relays((relay_url,))

    def global_ping(self, public_key, action="hello", prompt="", session_id="", minutes=GLOBAL_FOCUS_DEFAULT_MINUTES, allow_offline=False):
        public_key = trim_text(public_key, 64).lower()
        if not is_valid_public_key(public_key):
            return False, "That world profile is not valid"
        if action not in GLOBAL_ACTION_META:
            return False, "Unknown world signal"
        if public_key in self.state.get("global", {}).get("blocked_pubkeys", []):
            return False, "That profile is blocked"
        peer = self.state.get("global", {}).get("peers", {}).get(public_key) or {}
        if not allow_offline and action in GLOBAL_FOCUS_ACTIONS and (not peer or safe_int(peer.get("last_seen")) < now_seconds() - GLOBAL_PEER_TTL_SECONDS):
            return False, "That builder is no longer online"
        sent = [
            item
            for item in self.state.setdefault("global", {}).get("sent_pings", [])
            if safe_int(item.get("timestamp")) >= now_seconds() - 60
        ]
        if sum(1 for item in sent if item.get("public_key") == public_key) >= 4:
            return False, "Slow down a little — that builder has your last waves"
        identity = self._global_identity()
        icon, label = GLOBAL_ACTION_META[action]
        content = json.dumps(
            {
                "app": "omarchy-friends",
                "v": 1,
                "type": "ping",
                "action": action,
                "handle": self.state["profile"]["handle"],
                "avatar": self.state["profile"]["avatar"],
                "prompt": trim_text(prompt, 120),
                "session_id": trim_text(session_id, 40),
                "minutes": safe_int(minutes, GLOBAL_FOCUS_DEFAULT_MINUTES, 5, 120),
            },
            ensure_ascii=False,
            separators=(",", ":"),
        )
        event = build_event(
            identity["secret_key"],
            GLOBAL_PING_KIND,
            [
                ["p", public_key],
                ["t", GLOBAL_PING_TAG],
                ["alt", "Omarchy Friends ping"],
            ],
            content,
        )
        ok, relay_status = self._publish_global_event(event)
        self.state["global"]["relays"].update(relay_status)
        if not ok:
            self.state["global"]["last_error"] = "No public relay accepted the wave"
            self.save_state()
            return False, "Could not reach the world right now"
        sent.append({"public_key": public_key, "timestamp": now_seconds()})
        self.state["global"]["sent_pings"] = sent[-GLOBAL_MAX_SENT_PINGS:]
        target_handle = peer.get("handle") or generate_global_handle(public_key)
        target_avatar = peer.get("avatar") or generate_global_avatar(public_key)
        message = f"You sent {label} to {target_handle}."
        if prompt:
            message += f" {trim_text(prompt, 120)}"
        self._remember_memory_signal(public_key, action, "sent", target_handle, target_avatar)
        self._append_event(action, icon, target_handle, target_avatar, message, event["id"])
        self._append_pulse(peer or {"handle": target_handle, "avatar": target_avatar, "public_key": public_key}, action, message, remote=False)
        self.save_state()
        return True, f"Sent {label} to {peer.get('handle', 'a builder')}"

    def block_global(self, public_key):
        public_key = trim_text(public_key, 64).lower()
        if not is_valid_public_key(public_key):
            return False, "That world profile is not valid"
        global_state = self.state.setdefault("global", {})
        blocked = global_state.setdefault("blocked_pubkeys", [])
        if public_key not in blocked:
            blocked.append(public_key)
        global_state.get("peers", {}).pop(public_key, None)
        global_state.get("friendships", {}).pop(public_key, None)
        global_state.get("memory", {}).pop(public_key, None)
        global_state["pings"] = [item for item in global_state.get("pings", []) if item.get("public_key") != public_key]
        global_state["community"] = [item for item in global_state.get("community", []) if item.get("public_key") != public_key]
        self.save_state()
        return True, "Builder blocked from your world"

    def unblock_global(self, public_key):
        public_key = trim_text(public_key, 64).lower()
        if not is_valid_public_key(public_key):
            return False, "That public key is not valid"
        global_state = self.state.setdefault("global", {})
        blocked = global_state.setdefault("blocked_pubkeys", [])
        global_state["blocked_pubkeys"] = [key for key in blocked if key != public_key]
        self.save_state()
        return True, "Builder unblocked"

    def set_status(self, status_id):
        if status_id not in AVAILABLE_STATUSES:
            return False
        self.state["profile"]["status"] = status_id
        self.state["profile"]["focus_started_at"] = now_seconds()
        self.save_state()
        return True

    def set_handle(self, handle):
        clean = trim_text(handle, 24)
        if not clean:
            return False
        self.state["profile"]["handle"] = clean
        self.save_state()
        return True

    def set_avatar(self, avatar):
        if avatar not in AVAILABLE_AVATARS:
            return False
        self.state["profile"]["avatar"] = avatar
        self.save_state()
        return True

    def set_project(self, name, desc="", url=""):
        profile = self.state["profile"]
        profile["project_name"] = trim_text(name, 32)
        profile["project_desc"] = trim_text(desc, 80)
        profile["project_url"] = safe_url(url)
        self.save_state()
        return True

    def set_profile(self, handle, project_name="", project_desc="", project_url=""):
        """Persist profile identity and showcase together to avoid write races."""
        cleaned_handle = trim_text(handle, 24)
        if cleaned_handle:
            self.state["profile"]["handle"] = cleaned_handle
        self.state["profile"]["project_name"] = trim_text(project_name, 32)
        self.state["profile"]["project_desc"] = trim_text(project_desc, 80)
        self.state["profile"]["project_url"] = safe_url(project_url)
        self.save_state()
        return True

    def toggle_privacy(self, key):
        if key not in PRIVACY_DEFAULTS:
            return None
        privacy = self.state["profile"].setdefault("privacy", dict(PRIVACY_DEFAULTS))
        privacy[key] = not bool(privacy.get(key, PRIVACY_DEFAULTS[key]))
        if key == "share_read_receipts" and not privacy[key]:
            for message in self.state.setdefault("global", {}).get("messages", []):
                if message.get("read_receipt_eligible"):
                    message["read_receipt_eligible"] = False
                    message["read_receipt_retry_attempts"] = 0
                    message["read_receipt_retry_at"] = 0
        self.save_state()
        return privacy[key]

    def _peer_is_recent(self, peer):
        return bool(peer and now_seconds() - safe_int(peer.get("last_seen")) < PEER_TTL_SECONDS)

    def _common_ground(self, peer, current_activity=""):
        common = []
        own_interests = set(self.state["profile"].get("interests", []))
        if self._same_room(peer):
            common.append(f"Room: {normalize_room(self.state['profile'].get('room'))}")
        for interest_id in peer.get("interests", []):
            if interest_id in own_interests and interest_id in INTEREST_BY_ID:
                item = INTEREST_BY_ID[interest_id]
                common.append(f"{item['emoji']} {item['name']}")
        if (
            current_activity
            and current_activity not in ("Desktop", "Hidden")
            and peer.get("activity") == current_activity
        ):
            common.append(f"Both using {current_activity}")
        if peer.get("status") == self.state["profile"].get("status"):
            status = AVAILABLE_STATUSES.get(peer.get("status"))
            if status:
                common.append(f"Both {status['name'].lower()}")
        return common[:3]

    def _icebreaker(self, peer):
        own_interests = set(self.state["profile"].get("interests", []))
        for interest_id in peer.get("interests", []):
            if interest_id in own_interests and interest_id in ICEBREAKERS:
                return ICEBREAKERS[interest_id]
        if self._same_room(peer):
            room = normalize_room(self.state["profile"].get("room"))
            return f"What are you working on in {room}?"
        return "What are you building today?"

    def set_interests(self, interests):
        self.state["profile"]["interests"] = normalize_interests(interests)
        self.save_state()
        return True

    def set_room(self, room):
        raw_room = " ".join(trim_text(room, MAX_ROOM_LENGTH).split())
        normalized = normalize_room(raw_room)
        if raw_room and not normalized:
            return False, "Use letters, numbers, spaces, dots, dashes, or underscores"
        self.state["profile"]["room"] = normalized
        self.save_state()
        return True, "Gathering room cleared" if not normalized else f"Joined {normalized}"

    def _same_room(self, peer):
        own_room = normalize_room(self.state["profile"].get("room"))
        peer_room = normalize_room((peer or {}).get("room"))
        return bool(own_room and peer_room and own_room.casefold() == peer_room.casefold())

    def _available_peers(self):
        peers = []
        for peer in self.state.get("lan_peers", {}).values():
            if self._peer_is_recent(peer):
                item = dict(peer)
                item["online"] = True
                peers.append(item)
        for friend in self.state.get("friends", []):
            live = self.state.get("lan_peers", {}).get(friend["code"])
            if live and self._peer_is_recent(live):
                item = dict(live)
                item["online"] = True
                peers.append(item)
        return self._unique_peers(sorted(peers, key=lambda item: item["code"]))

    def _find_peer(self, code, require_recent=False):
        code = normalize_code(code)
        candidates = []
        if code in self.state.get("lan_peers", {}):
            candidates.append(self.state["lan_peers"][code])
        candidates.extend(
            friend for friend in self.state.get("friends", []) if friend["code"] == code
        )
        matched_peer = self.state.get("matched_peer") or {}
        if matched_peer.get("code") == code:
            candidates.append(matched_peer)
        for peer in candidates:
            if not require_recent or self._peer_is_recent(peer):
                return peer
        return None

    def match_next(self):
        """Select the next real, recently observed peer on the local radar."""
        self.cleanup_lan_peers()
        candidates = self._available_peers()
        current_code = (self.state.get("matched_peer") or {}).get("code", "")
        candidates = [peer for peer in candidates if peer["code"] != current_code]
        own_interests = set(self.state["profile"].get("interests", []))
        candidates.sort(
            key=lambda peer: (
                -int(self._same_room(peer)),
                -len(own_interests.intersection(peer.get("interests", []))),
                -(peer.get("status") == self.state["profile"].get("status")),
                peer["code"],
            )
        )
        if not candidates:
            self.state["matched_peer"] = None
            self.save_state()
            return None
        peer = dict(candidates[0])
        peer["matched_at"] = now_seconds()
        peer["same_room"] = self._same_room(peer)
        peer["common_ground"] = self._common_ground(peer)
        peer["icebreaker"] = self._icebreaker(peer)
        self.state["matched_peer"] = peer
        self.state["stats"]["hackers_met"] += 1
        self._append_pulse(
            peer,
            "radar",
            f"Found {peer['handle']} on your local radar.",
            remote=False,
        )
        self.save_state()
        return peer

    def add_matched_friend(self):
        peer = self.state.get("matched_peer")
        if not peer or not self._peer_is_recent(peer):
            return False, "No recent peer on the local radar"
        return self.add_friend(peer["code"], peer.get("handle"), peer.get("avatar"))

    def add_friend(self, code, handle=None, avatar=None):
        code = normalize_code(code)
        if not is_valid_friend_code(code):
            return False, "Invalid Friend Code (expected OMAR-XXXX-XXX)"
        if code == self.state["profile"]["code"]:
            return False, "Cannot add your own Friend Code"
        if any(friend["code"] == code for friend in self.state.get("friends", [])):
            return False, "That Friend Code is already saved"

        peer = self._find_peer(code)
        if peer:
            friend = dict(peer)
        else:
            friend = {
                "code": code,
                "handle": trim_text(handle, 24) or "Omarchy Friend",
                "avatar": avatar if avatar in AVAILABLE_AVATARS else "👾",
                "status": "coding",
                "activity": "",
                "music": "",
                "focus_mins": 0,
                "last_seen": 0,
                "source": "friend-code",
            }
        if handle:
            friend["handle"] = trim_text(handle, 24)
        if avatar in AVAILABLE_AVATARS:
            friend["avatar"] = avatar
        friend["online"] = self._peer_is_recent(friend)
        self.state.setdefault("friends", []).append(friend)
        self.state["stats"]["friends_made"] += 1
        self._append_pulse(
            friend,
            "friend",
            f"Saved {friend['handle']} as a trusted friend.",
            remote=False,
        )
        self.save_state()
        return True, f"Saved {friend['handle']} as a trusted friend"

    def remove_friend(self, code):
        code = normalize_code(code)
        before = len(self.state.get("friends", []))
        self.state["friends"] = [
            friend for friend in self.state.get("friends", []) if friend["code"] != code
        ]
        if len(self.state["friends"]) == before:
            return False, "Friend Code not found"
        self.save_state()
        return True, f"Removed {code}"

    def _remember_event_id(self, event_id):
        event_id = trim_text(event_id, 40)
        if not event_id:
            return False
        seen = self.state.setdefault("seen_event_ids", [])
        if event_id in seen:
            return False
        seen.append(event_id)
        del seen[:-MAX_SEEN_EVENT_IDS]
        return True

    def _allow_incoming_signal(self, sender_code):
        cutoff = now_seconds() - 60
        receipts = [
            receipt
            for receipt in self.state.get("signal_receipts", [])
            if safe_int(receipt.get("timestamp")) >= cutoff
        ]
        sender_count = sum(1 for receipt in receipts if receipt.get("code") == sender_code)
        if sender_count >= MAX_INCOMING_SIGNALS_PER_MINUTE:
            self.state["signal_receipts"] = receipts[-MAX_SIGNAL_RECEIPTS:]
            return False
        receipts.append({"code": sender_code, "timestamp": now_seconds()})
        self.state["signal_receipts"] = receipts[-MAX_SIGNAL_RECEIPTS:]
        return True

    def _append_event(self, action, icon, from_name, from_avatar, message, event_id=None):
        event = {
            "id": trim_text(event_id, 64) or uuid.uuid4().hex,
            "action": trim_text(action, 16),
            "icon": trim_text(icon, 4),
            "from_name": trim_text(from_name, 24) or "A nearby builder",
            "from_avatar": trim_text(from_avatar, 4) or "👾",
            "message": trim_text(message, 180),
            "timestamp": now_seconds(),
        }
        self.state.setdefault("events", []).append(event)
        self.state["events"] = self.state["events"][-MAX_EVENTS:]
        return event

    def _append_pulse(self, peer, action, text, remote=False):
        peer = peer or {}
        item = {
            "id": uuid.uuid4().hex,
            "user": trim_text(peer.get("handle"), 24) or "A nearby builder",
            "avatar": trim_text(peer.get("avatar"), 4) or "👾",
            "action": trim_text(action, 16) or "signal",
            "text": trim_text(text, 140),
            "timestamp": now_seconds(),
            "time_ago": "now",
            "cheers": 0,
            "remote": bool(remote),
            "peer_code": normalize_code(peer.get("code")),
        }
        self.state.setdefault("world_pulse", []).append(item)
        self.state["world_pulse"] = self.state["world_pulse"][-MAX_PULSE_ITEMS:]
        return item

    def _send_udp_packet(self, packet):
        try:
            data = json.dumps(packet, separators=(",", ":")).encode("utf-8")
            if len(data) > MAX_PACKET_BYTES:
                return False
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
                sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
                sock.settimeout(0.5)
                sock.sendto(data, ("255.255.255.255", BROADCAST_PORT))
            return True
        except (OSError, TypeError, ValueError):
            return False

    def _target_for_action(self, target_code=None):
        code = normalize_code(target_code)
        if not code:
            code = normalize_code((self.state.get("matched_peer") or {}).get("code"))
        return self._find_peer(code, require_recent=True) if code else None

    def interact(self, target_code, action="high-five"):
        if action not in INTERACTION_META:
            return False, f"Unknown action: {action}"
        target = self._target_for_action(target_code)
        if not target:
            return False, "Target is not a recent opt-in peer"
        if not self.state["profile"]["privacy"].get("share_lan", True):
            return False, "Enable LAN sharing to send a signal"

        icon, label = INTERACTION_META[action]
        event_id = uuid.uuid4().hex
        packet = {
            "protocol": PROTOCOL_VERSION,
            "type": "interaction",
            "event_id": event_id,
            "from_code": self.state["profile"]["code"],
            "from_handle": self.state["profile"]["handle"],
            "from_avatar": self.state["profile"]["avatar"],
            "to_code": target["code"],
            "action": action,
            "timestamp": now_seconds(),
        }
        if action == "hello":
            packet["prompt"] = self._icebreaker(target)
        if not self._send_udp_packet(packet):
            return False, "Could not send the LAN signal"
        self.state["stats"]["high_fives_sent"] += action == "high-five"
        self._append_event(
            action,
            icon,
            target.get("handle"),
            target.get("avatar"),
            f"You sent {label} to {target.get('handle', 'a nearby builder')}.",
            event_id,
        )
        self._append_pulse(
            target,
            action,
            f"You sent {label} to {target.get('handle', 'a nearby builder')}.",
        )
        self.save_state()
        return True, f"Sent {label} to {target.get('handle', 'a nearby builder')}"

    def share_rice(self, target_code=None):
        target = self._target_for_action(target_code)
        if not target:
            return False, "Choose a recent peer before sharing your rice"
        if not self.state["profile"]["privacy"].get("share_lan", True):
            return False, "Enable LAN sharing to share your rice"

        theme = trim_text(get_current_theme(), 48)
        wallpaper = trim_text(os.path.basename(get_current_wallpaper()), 100)
        event_id = uuid.uuid4().hex
        packet = {
            "protocol": PROTOCOL_VERSION,
            "type": "rice",
            "event_id": event_id,
            "from_code": self.state["profile"]["code"],
            "from_handle": self.state["profile"]["handle"],
            "from_avatar": self.state["profile"]["avatar"],
            "to_code": target["code"],
            "theme": theme,
            "wallpaper": wallpaper,
            "timestamp": now_seconds(),
        }
        if not self._send_udp_packet(packet):
            return False, "Could not send the rice signal"
        self.state["stats"]["rices_shared"] += 1
        detail = theme or "your current theme"
        self._append_event(
            "rice",
            "🎨",
            target.get("handle"),
            target.get("avatar"),
            f"You shared {detail} with {target.get('handle', 'a nearby builder')}.",
            event_id,
        )
        self._append_pulse(
            target,
            "rice",
            f"You shared your setup with {target.get('handle', 'a nearby builder')}.",
        )
        self.save_state()
        return True, f"Shared your setup with {target.get('handle', 'a nearby builder')}"

    def start_cowork(self, duration_mins=25, target_code=None):
        try:
            duration_mins = safe_int(duration_mins, 25, 5, 120)
        except (TypeError, ValueError):
            duration_mins = 25

        target = self._target_for_action(target_code)
        if target and not self.state["profile"]["privacy"].get("share_lan", True):
            return False, "Enable LAN sharing to invite a peer"

        started_at = now_seconds()
        ends_at = started_at + duration_mins * 60
        invite_id = uuid.uuid4().hex
        mode = "shared" if target else "solo"
        self.state["cowork"] = {
            "active": True,
            "mode": mode,
            "invite_id": invite_id,
            "buddy_code": target.get("code", "") if target else "",
            "buddy_name": target.get("handle", "") if target else "",
            "buddy_avatar": target.get("avatar", "") if target else "",
            "started_at": started_at,
            "ends_at": ends_at,
            "total_seconds": duration_mins * 60,
        }
        if target:
            packet = {
                "protocol": PROTOCOL_VERSION,
                "type": "cowork",
                "event": "invite",
                "event_id": invite_id,
                "from_code": self.state["profile"]["code"],
                "from_handle": self.state["profile"]["handle"],
                "from_avatar": self.state["profile"]["avatar"],
                "to_code": target["code"],
                "duration_mins": duration_mins,
                "started_at": started_at,
                "ends_at": ends_at,
            }
            if not self._send_udp_packet(packet):
                self.state["cowork"] = self._default_state()["cowork"]
                return False, "Could not send the co-work invite"
            message = f"Invited {target.get('handle', 'a nearby builder')} to co-work"
        else:
            message = "Started a private focus session"
        self._append_pulse(
            target or self.state["profile"],
            "focus",
            f"{message} for {duration_mins} minutes.",
        )
        self.save_state()
        return True, message

    def accept_cowork(self, invite_id):
        invite_id = trim_text(invite_id, 40)
        invite = next(
            (item for item in self.state.get("cowork_invites", []) if item["id"] == invite_id),
            None,
        )
        if not invite or now_seconds() >= invite["ends_at"]:
            return False, "That co-work invite has expired"
        self.state["cowork_invites"] = [
            item for item in self.state["cowork_invites"] if item["id"] != invite_id
        ]
        self.state["cowork"] = {
            "active": True,
            "mode": "shared",
            "invite_id": invite_id,
            "buddy_code": invite["from_code"],
            "buddy_name": invite["from_name"],
            "buddy_avatar": invite["from_avatar"],
            "started_at": invite["started_at"],
            "ends_at": invite["ends_at"],
            "total_seconds": invite["duration_mins"] * 60,
        }
        peer = self._find_peer(invite["from_code"])
        if peer:
            self._append_pulse(peer, "focus", f"Joined {peer['handle']}'s co-work session.")
        self.save_state()
        return True, f"Joined {invite['from_name']} for co-work"

    def dismiss_cowork(self, invite_id):
        before = len(self.state.get("cowork_invites", []))
        self.state["cowork_invites"] = [
            item for item in self.state["cowork_invites"] if item["id"] != trim_text(invite_id, 40)
        ]
        if len(self.state["cowork_invites"]) == before:
            return False, "Invite not found"
        self.save_state()
        return True, "Invite dismissed"

    def cancel_cowork(self):
        cowork = self.state.get("cowork", {})
        if not cowork.get("active"):
            return True, "No co-work session is active"
        if cowork.get("mode") == "shared" and cowork.get("buddy_code"):
            self._send_udp_packet(
                {
                    "protocol": PROTOCOL_VERSION,
                    "type": "cowork",
                    "event": "cancel",
                    "event_id": uuid.uuid4().hex,
                    "from_code": self.state["profile"]["code"],
                    "from_handle": self.state["profile"]["handle"],
                    "from_avatar": self.state["profile"]["avatar"],
                    "to_code": cowork["buddy_code"],
                    "timestamp": now_seconds(),
                }
            )
        self.state["cowork"] = self._default_state()["cowork"]
        self.save_state()
        return True, "Co-work session ended"

    def cheer_feed_item(self, item_id):
        item = next(
            (pulse for pulse in self.state.get("world_pulse", []) if pulse["id"] == item_id),
            None,
        )
        if not item:
            return False, "Pulse item not found"
        item["cheers"] += 1
        target = self._find_peer(item.get("peer_code"), require_recent=True)
        if target and self.state["profile"]["privacy"].get("share_lan", True):
            self._send_udp_packet(
                {
                    "protocol": PROTOCOL_VERSION,
                    "type": "cheer",
                    "event_id": uuid.uuid4().hex,
                    "from_code": self.state["profile"]["code"],
                    "from_handle": self.state["profile"]["handle"],
                    "from_avatar": self.state["profile"]["avatar"],
                    "to_code": target["code"],
                    "timestamp": now_seconds(),
                }
            )
        self.save_state()
        return True, f"Sent a cheer to {item.get('user', 'a nearby builder')}"

    def _known_sender(self, code):
        return self._find_peer(code, require_recent=True)

    def handle_packet(self, packet, addr=None):
        """Validate and apply one bounded LAN packet. Returns whether it was used."""
        if not isinstance(packet, dict) or packet.get("protocol") != PROTOCOL_VERSION:
            return False
        sender_code = normalize_code(packet.get("code") or packet.get("from_code"))
        if not is_valid_friend_code(sender_code) or sender_code == self.state["profile"]["code"]:
            return False

        packet_type = packet.get("type")
        if packet_type == "presence":
            peer = self._normalize_peer(
                {
                    **packet,
                    "last_seen": now_seconds(),
                    "source": "lan",
                    "online": True,
                }
            )
            if not peer:
                return False
            self.state.setdefault("lan_peers", {})[sender_code] = peer
            self.save_state()
            return True

        if packet.get("to_code") != self.state["profile"]["code"]:
            return False
        sender = self._known_sender(sender_code)
        if not sender:
            return False
        event_id = trim_text(packet.get("event_id"), 40)
        if not self._remember_event_id(event_id):
            return False

        if packet_type == "interaction":
            action = packet.get("action")
            if action not in INTERACTION_META:
                return False
            if not self._allow_incoming_signal(sender_code):
                return False
            icon, label = INTERACTION_META[action]
            if action == "high-five":
                self.state["stats"]["high_fives_received"] += 1
            self.state["stats"]["signals_received"] += 1
            prompt = trim_text(packet.get("prompt"), 100)
            message = f"{sender['handle']} sent you {label}."
            if action == "hello" and prompt:
                message += f" {prompt}"
            self._append_event(
                action,
                icon,
                sender["handle"],
                sender["avatar"],
                message,
                event_id,
            )
            self._append_pulse(
                sender,
                action,
                f"{sender['handle']} sent you {label}.",
                remote=True,
            )
        elif packet_type == "rice":
            if not self._allow_incoming_signal(sender_code):
                return False
            self.state["stats"]["signals_received"] += 1
            detail = trim_text(packet.get("theme"), 48) or "their current setup"
            self._append_event(
                "rice",
                "🎨",
                sender["handle"],
                sender["avatar"],
                f"{sender['handle']} shared {detail} with you.",
                event_id,
            )
            self._append_pulse(
                sender,
                "rice",
                f"{sender['handle']} shared their setup.",
                remote=True,
            )
        elif packet_type == "cheer":
            if not self._allow_incoming_signal(sender_code):
                return False
            self.state["stats"]["signals_received"] += 1
            self._append_event(
                "cheer",
                "💫",
                sender["handle"],
                sender["avatar"],
                f"{sender['handle']} cheered your local pulse.",
                event_id,
            )
        elif packet_type == "cowork":
            event = packet.get("event")
            if event == "invite":
                if not self._allow_incoming_signal(sender_code):
                    return False
                duration = safe_int(packet.get("duration_mins"), 25, 5, 120)
                ends_at = safe_int(packet.get("ends_at"), now_seconds() + duration * 60)
                if ends_at <= now_seconds():
                    return False
                self.state["cowork_invites"] = self._normalize_invites(
                    self.state.get("cowork_invites", [])
                    + [
                        {
                            "id": event_id,
                            "from_code": sender_code,
                            "from_name": sender["handle"],
                            "from_avatar": sender["avatar"],
                            "duration_mins": duration,
                            "started_at": safe_int(packet.get("started_at"), now_seconds()),
                            "ends_at": ends_at,
                        }
                    ]
                )
                self._append_event(
                    "focus",
                    "🍅",
                    sender["handle"],
                    sender["avatar"],
                    f"{sender['handle']} invited you to co-work for {duration} minutes.",
                    event_id,
                )
                self._append_pulse(
                    sender,
                    "focus",
                    f"{sender['handle']} opened a co-work invite.",
                    remote=True,
                )
            elif event == "cancel":
                if not self._allow_incoming_signal(sender_code):
                    return False
                if self.state.get("cowork", {}).get("buddy_code") == sender_code:
                    self.state["cowork"] = self._default_state()["cowork"]
                self._append_event(
                    "focus",
                    "⏹",
                    sender["handle"],
                    sender["avatar"],
                    f"{sender['handle']} ended the shared session.",
                    event_id,
                )
            else:
                return False
        else:
            return False
        self.save_state()
        return True

    def pop_events(self):
        events = self.state.get("events", [])
        self.state["events"] = []
        self.save_state()
        return events

    def cleanup_lan_peers(self):
        cutoff = now_seconds() - PEER_TTL_SECONDS
        self.state["lan_peers"] = {
            code: peer
            for code, peer in self.state.get("lan_peers", {}).items()
            if safe_int(peer.get("last_seen")) >= cutoff
        }

    def _current_cowork(self):
        cowork = self.state.get("cowork", {})
        if not cowork.get("active"):
            return {
                "active": False,
                "mode": "",
                "remaining_seconds": 0,
                "buddy_code": "",
                "buddy_name": "",
                "buddy_avatar": "",
                "total_seconds": 0,
            }
        remaining = safe_int(cowork.get("ends_at")) - now_seconds()
        if remaining <= 0:
            self.state["stats"]["cowork_completed"] += 1
            self.state["cowork"] = self._default_state()["cowork"]
            return {
                "active": False,
                "mode": "",
                "remaining_seconds": 0,
                "buddy_code": "",
                "buddy_name": "",
                "buddy_avatar": "",
                "total_seconds": 0,
            }
        return {
            "active": True,
            "mode": cowork.get("mode", "solo"),
            "remaining_seconds": remaining,
            "buddy_code": cowork.get("buddy_code", ""),
            "buddy_name": cowork.get("buddy_name", ""),
            "buddy_avatar": cowork.get("buddy_avatar", ""),
            "total_seconds": safe_int(cowork.get("total_seconds"), maximum=7200),
        }

    def get_full_status(self, include_messages=True, persist=True):
        self.cleanup_lan_peers()
        global_peers = self._global_peers()
        global_state = self.state.setdefault("global", {})
        signature_fields = (
            "profile", "friends", "matched_peer", "world_pulse", "cowork", "cowork_invites",
            "stats", "invite_nudge", "invite_nudge_dismissed", "global",
        )
        cache_signature = hashlib.sha256(json.dumps(
            {**{key: self.state.get(key) for key in signature_fields}, "include_messages": bool(include_messages)},
            ensure_ascii=False, sort_keys=True, separators=(",", ":"), default=str,
        ).encode("utf-8")).digest()
        if self._status_cache is not None and self._status_cache_signature == cache_signature:
            return copy.deepcopy(self._status_cache)
        global_pings = list(global_state.get("pings", []))[-GLOBAL_MAX_PINGS:]
        cowork = self._current_cowork()
        global_focus = self._current_global_focus()
        profile = self.state["profile"]
        privacy = profile.get("privacy", {})
        active_app = get_active_window() if privacy.get("share_window", False) else "Hidden"
        active_music = get_active_music() if privacy.get("share_music", False) else ""
        theme = get_current_theme()
        wallpaper = get_current_wallpaper()
        peers = self._available_peers()
        for peer in peers:
            peer["same_room"] = self._same_room(peer)
            peer["common_ground"] = self._common_ground(peer, active_app)
            peer["icebreaker"] = self._icebreaker(peer)
        current_match = self.state.get("matched_peer")
        if current_match and not self._peer_is_recent(current_match):
            current_match = None
            self.state["matched_peer"] = None
        if current_match:
            current_match = dict(current_match)
            current_match["online"] = True
            current_match["same_room"] = self._same_room(current_match)
            current_match["common_ground"] = self._common_ground(current_match, active_app)
            current_match["icebreaker"] = self._icebreaker(current_match)
        for pulse in self.state.get("world_pulse", []):
            pulse["time_ago"] = format_age(pulse.get("timestamp"))

        if persist:
            self.save_state()
        status_info = self._profile_status()
        status = {
            "profile": {
                "handle": profile["handle"],
                "avatar": profile["avatar"],
                "code": profile["code"],
                "public_key": self._global_identity()["public_key"],
                "global_visible": bool(privacy.get("share_global", False)),
                "status": profile.get("status", "coding"),
                "status_name": status_info["name"],
                "status_emoji": status_info["emoji"],
                "status_desc": status_info["desc"],
                "activity": active_app,
                "music": active_music,
                "theme": theme,
                "wallpaper": wallpaper,
                "focus_mins": self.get_focus_minutes(),
                "project_name": profile.get("project_name", ""),
                "project_desc": profile.get("project_desc", ""),
                "project_url": profile.get("project_url", ""),
                "interests": list(profile.get("interests", [])),
                "room": normalize_room(profile.get("room")),
                "privacy": privacy,
            },
            "matched_peer": current_match,
            "friends": [
                dict(friend, online=bool(self.state.get("lan_peers", {}).get(friend["code"])
                                         and self._peer_is_recent(self.state["lan_peers"][friend["code"]])))
                for friend in self.state.get("friends", [])
            ],
            "lan_peers": peers,
            "global_peers": global_peers,
            "global_pings": global_pings,
            "global_friendships": global_state.get("friendships", {}),
            "global_private_history_cursors": global_state.get("private_history_cursors", {}),
            "global_private_history_relays": list(NIP17_DM_RELAYS),
            "global_messages": [
                {key: value for key, value in normalized.items() if key not in {"retry_actions", "pending_actions"}}
                | {"retryable": normalized["retryable"], "retryable_actions": normalized["retryable_actions"]}
                for item in global_state.get("messages", [])
                if (normalized := self._normalize_global_message(item))
            ] if include_messages else [],
            "global_unread_counts": self._global_unread_counts(),
            "global_pinned_conversations": list(global_state.get("pinned_conversations", [])),
            "global_muted_conversations": list(global_state.get("muted_conversations", [])),
            "global_groups": list(global_state.get("groups", {}).values()),
            "global_community": global_state.get("community", []),
            "global_memory": global_state.get("memory", {}),
            "global_blocked_pubkeys": list(global_state.get("blocked_pubkeys", [])),
            "update": {
                "available": bool(global_state.get("update_available", False)),
                "current": PLUGIN_VERSION,
                "latest": trim_text(global_state.get("latest_version") or PLUGIN_VERSION, 16),
            },
            "invite_nudge": bool(self.state.get("invite_nudge", False) and not self.state.get("invite_nudge_dismissed", False)),
            "world_event": self._world_event(),
            "global_status": {
                "visible": bool(privacy.get("share_global", False)),
                "online_count": len(global_peers),
                "last_sync": safe_int(global_state.get("last_sync")),
                "last_sync_age": format_age(global_state.get("last_sync")) if global_state.get("last_sync") else "never",
                "last_publish": safe_int(global_state.get("last_publish")),
                "last_error": trim_text(global_state.get("last_error"), 180),
                "blossom_server": trim_text(global_state.get("blossom_server"), 512),
                "relays": global_state.get("relays", {}),
                "relay_count": sum(
                    1
                    for item in global_state.get("relays", {}).values()
                    if isinstance(item, dict) and item.get("online")
                ),
                "relay_total": len(GLOBAL_RELAYS),
            },
            "world_prompt": self._world_prompt(),
            "world_pulse": self.state.get("world_pulse", []),
            "global_focus": global_focus,
            "cowork": cowork,
            "cowork_invites": self._normalize_invites(self.state.get("cowork_invites")),
            "online_count": len(peers) + len(global_peers),
            "stats": self.state.get("stats", {}),
            "available_statuses": list(AVAILABLE_STATUSES.values()),
            "available_avatars": AVAILABLE_AVATARS,
            "available_interests": AVAILABLE_INTERESTS,
            "available": bool(peers),
            "transport": {
                "mode": "federated-global+local-lan",
                "port": BROADCAST_PORT,
                "ttl_seconds": PEER_TTL_SECONDS,
                "global_ttl_seconds": GLOBAL_PEER_TTL_SECONDS,
                "relays": list(GLOBAL_RELAYS),
            },
        }
        self._status_cache_signature = cache_signature
        self._status_cache = copy.deepcopy(status)
        return status

    def get_ui_status(self):
        """Return compact UI status without hydrating the whole message journal."""
        status = self.get_full_status(include_messages=False, persist=False)
        own_key = trim_text(status.get("profile", {}).get("public_key"), 64).lower()
        latest = {}
        counts = {}
        indexed_records = self._journal_conversation_summaries()
        seen_ids = set()
        candidates = []
        for descriptor, count, normalized in indexed_records:
            kind, identifier = descriptor
            key = kind + ":" + identifier
            item = {field: value for field, value in normalized.items() if field not in {"retry_actions", "pending_actions"}}
            candidates.append((key, item))
            counts[key] = count
            if item.get("id"):
                seen_ids.add(str(item["id"]))
        # Inline messages are retained for pre-journal legacy state and for
        # callers/tests that construct an engine with an in-memory transcript.
        if not indexed_records:
            for raw in self.state.get("global", {}).get("messages", []):
                if not isinstance(raw, dict) or str(raw.get("id") or "") in seen_ids:
                    continue
                descriptor = self._message_conversation_descriptor(raw, own_key)
                if not descriptor:
                    continue
                normalized = self._normalize_global_message(raw, own_key)
                if normalized:
                    if descriptor[0] == "unlinked":
                        normalized["legacy_unlinked"] = True
                    key = descriptor[0] + ":" + descriptor[1]
                    item = {field: value for field, value in normalized.items() if field not in {"retry_actions", "pending_actions"}}
                    candidates.append((key, item))
                    counts[key] = counts.get(key, 0) + 1
        # Preserve the full-status behavior for mocked providers and encrypted
        # state migrations that still embed messages directly in state JSON.
        for item in status.get("global_messages", []):
            if not isinstance(item, dict):
                continue
            group_id = trim_text(item.get("group_id"), 40).lower()
            if group_id:
                key = "group:" + group_id
            else:
                peer_key = trim_text(item.get("conversation_key"), 64).lower()
                if not peer_key:
                    peer_key = trim_text(item.get("public_key"), 64).lower()
                if not is_valid_public_key(peer_key) or peer_key == own_key:
                    continue
                key = "friend:" + peer_key
            counts[key] = counts.get(key, 0) + 1
            candidates.append((key, item))
            previous = latest.get(key)
            rank = (safe_int(item.get("timestamp")), safe_int(item.get("received_at_ms")))
            previous_rank = (safe_int(previous.get("timestamp")), safe_int(previous.get("received_at_ms"))) if previous else None
            if previous is None or rank >= previous_rank:
                latest[key] = item
        for key, item in candidates:
            previous = latest.get(key)
            rank = (safe_int(item.get("timestamp")), safe_int(item.get("received_at_ms")))
            previous_rank = (safe_int(previous.get("timestamp")), safe_int(previous.get("received_at_ms"))) if previous else None
            if previous is None or rank >= previous_rank:
                latest[key] = item
        status["global_messages"] = sorted(
            latest.values(),
            key=lambda item: (safe_int(item.get("timestamp")), safe_int(item.get("received_at_ms"))),
        )
        status["global_message_counts"] = counts
        return status

    def search_messages(self, query):
        """Search local message history; return the latest match per thread."""
        query = trim_text(query, 128).casefold()
        if not query:
            return {"ok": True, "query": "", "messages": []}
        own_key = self._global_identity()["public_key"]
        source_messages = self._journal_all_messages() if self.message_journal_file.exists() else list(self.state.get("global", {}).get("messages", []))
        source_messages.extend(self.state.get("global", {}).get("messages", []))
        unique_messages = {}
        for message in source_messages:
            if isinstance(message, dict) and message.get("id"):
                unique_messages[str(message["id"])] = message
        conversations = {}
        for raw in unique_messages.values():
            if raw.get("deleted"):
                continue
            item = self._normalize_global_message(raw, own_key)
            if not item:
                continue
            group_id = trim_text(item.get("group_id"), 40).lower()
            if group_id:
                key = "group:" + group_id
            else:
                peer_key = trim_text(item.get("conversation_key"), 64).lower()
                if not peer_key:
                    peer_key = trim_text(item.get("public_key"), 64).lower()
                if not is_valid_public_key(peer_key) or peer_key == own_key:
                    continue
                key = "friend:" + peer_key
            conversations.setdefault(key, []).append(item)

        matches = []
        for rows in conversations.values():
            rows.sort(key=lambda item: (
                safe_int(item.get("timestamp")),
                safe_int(item.get("received_at_ms")),
                trim_text(item.get("id"), 64),
            ))
            for index in range(len(rows) - 1, -1, -1):
                item = rows[index]
                parts = [item.get("text", "")]
                reply = item.get("reply_to")
                if isinstance(reply, dict):
                    parts.append(reply.get("text", ""))
                parts.extend(media.get("url", "") for media in item.get("media", []) if isinstance(media, dict))
                parts.extend(attachment.get("name", "") for attachment in item.get("attachments", []) if isinstance(attachment, dict))
                if query not in " ".join(str(part) for part in parts).casefold():
                    continue
                result = dict(item)
                result["history_offset"] = len(rows) - index - 1
                matches.append(result)
                break
        matches.sort(key=lambda item: (
            safe_int(item.get("timestamp")),
            safe_int(item.get("received_at_ms")),
            trim_text(item.get("id"), 64),
        ), reverse=True)
        return {"ok": True, "query": query, "messages": matches[:100]}

    def _background_global_sync(self):
        """One relay sync on a worker thread so slow relays never stall LAN traffic."""
        try:
            worker = FriendsEngine(state_dir=self.state_dir)
            worker.sync_global()
        except Exception:
            pass

    def run_daemon(self):
        """Keep local UDP presence and the global relay presence alive."""
        shell_parent = self._quickshell_parent_snapshot()
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
        except (AttributeError, OSError):
            pass
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        try:
            sock.bind(("", BROADCAST_PORT))
        except OSError as error:
            sys.stderr.write(f"Omarchy Friends: could not bind UDP {BROADCAST_PORT}: {error}\n")
            sock.close()
            return
        sock.setblocking(False)
        last_broadcast = 0
        last_reload = 0
        last_global_sync = 0
        global_sync_lock = threading.Lock()
        try:
            while True:
                if not self._quickshell_parent_alive(shell_parent):
                    return
                current = time.time()
                if current - last_reload >= LAN_DAEMON_STATE_REFRESH_SECONDS:
                    self.state = self.load_state()
                    last_reload = current
                if (
                    current - last_global_sync >= GLOBAL_SYNC_INTERVAL_SECONDS
                ):
                    # Relay syncs can take longer than their interval when a
                    # relay is slow. Never accumulate unbounded workers: one
                    # single-flight sync owns the shared state writer at a time.
                    if global_sync_lock.acquire(blocking=False):
                        def sync_and_release():
                            try:
                                self._background_global_sync()
                            finally:
                                global_sync_lock.release()
                        sync_thread = threading.Thread(target=sync_and_release, daemon=True)
                        sync_thread.start()
                        last_global_sync = current
                if (
                    current - last_broadcast >= 15
                    and self.state["profile"]["privacy"].get("share_lan", True)
                ):
                    payload = json.dumps(
                        self.get_public_payload(), separators=(",", ":")
                    ).encode("utf-8")
                    if len(payload) <= MAX_PACKET_BYTES:
                        try:
                            sock.sendto(payload, ("255.255.255.255", BROADCAST_PORT))
                        except OSError:
                            pass
                    last_broadcast = current
                next_wakeup = min(
                    LAN_DAEMON_STATE_REFRESH_SECONDS - (current - last_reload),
                    GLOBAL_SYNC_INTERVAL_SECONDS - (current - last_global_sync),
                    15 - (current - last_broadcast),
                )
                readable, _, _ = select.select([sock], [], [], max(0.05, next_wakeup))
                if not readable:
                    continue
                try:
                    raw, addr = sock.recvfrom(MAX_PACKET_BYTES)
                    if len(raw) > MAX_PACKET_BYTES:
                        continue
                    packet = json.loads(raw.decode("utf-8"))
                    self.handle_packet(packet, addr)
                except (OSError, UnicodeDecodeError, TypeError, ValueError):
                    continue
        finally:
            sock.close()


def print_result(ok, message, **extra):
    result = {"ok": bool(ok)}
    if message:
        result["message"] = message
    result.update(extra)
    print(json.dumps(result))


def pick_attachment_from_portal(folder_mode=False):
    """Open the desktop file chooser portal and return a selected local path.

    Friends is a Wayland layer-shell surface. Qt's parentless dialogs can be
    hidden behind that overlay on some compositors; the desktop portal owns a
    normal, foreground chooser window and supports both files and directories.
    """
    try:
        import dbus
        from dbus.mainloop.glib import DBusGMainLoop
        from gi.repository import GLib

        DBusGMainLoop(set_as_default=True)
        bus = dbus.SessionBus()
        portal_path = "/org/freedesktop/portal/desktop"
        portal_name = "org.freedesktop.portal.Desktop"
        chooser = dbus.Interface(
            bus.get_object(portal_name, portal_path),
            "org.freedesktop.portal.FileChooser",
        )
        loop = GLib.MainLoop()
        result = {"response": None, "uris": [], "handle": ""}

        def on_response(response, values, signal_path=None):
            if signal_path != result["handle"]:
                return
            result["response"] = int(response)
            result["uris"] = list(values.get("uris", []))
            if loop.is_running():
                loop.quit()

        bus.add_signal_receiver(
            on_response,
            signal_name="Response",
            dbus_interface="org.freedesktop.portal.Request",
            path_keyword="signal_path",
        )
        token = "omarchy_friends_" + uuid.uuid4().hex
        options = dbus.Dictionary({
            "handle_token": dbus.String(token),
            "modal": dbus.Boolean(True),
            "directory": dbus.Boolean(folder_mode),
            "current_folder": dbus.ByteArray(os.fsencode(str(Path.home())) + b"\0"),
        }, signature="sv")
        handle = chooser.OpenFile(
            "", "Choose a folder to share" if folder_mode else "Choose a file to share",
            options,
        )
        result["handle"] = str(handle)

        # Responses are asynchronous; keep the chooser in this short-lived
        # action process while GLib dispatches the portal's Request.Response.
        if result["response"] is None:
            timed_out = {"value": False}
            def stop_on_timeout():
                timed_out["value"] = True
                loop.quit()
                return GLib.SOURCE_REMOVE
            timeout = GLib.timeout_add_seconds(600, stop_on_timeout)
            loop.run()
            if not timed_out["value"]:
                GLib.source_remove(timeout)

        if result["response"] is None:
            return {"ok": False, "message": "The file chooser timed out"}
        if result["response"] != 0:
            return {"ok": True, "path": ""}  # user cancelled
        if not result["uris"]:
            return {"ok": False, "message": "The chooser returned no selection"}
        selected = str(result["uris"][0])
        if not selected.startswith("file://"):
            return {"ok": False, "message": "The chooser returned a non-local path"}
        from urllib.parse import unquote, urlparse
        parsed = urlparse(selected)
        if parsed.netloc not in ("", "localhost"):
            return {"ok": False, "message": "The chooser returned a remote path"}
        return {"ok": True, "path": unquote(parsed.path)}
    except Exception as error:
        return {"ok": False, "message": "Could not open the desktop file chooser: " + str(error)}


def main():
    command = sys.argv[1] if len(sys.argv) >= 2 else "status"
    # Launch the portal chooser without initializing or touching Friends state.
    if command == "pick-attachment":
        print(json.dumps(pick_attachment_from_portal(
            len(sys.argv) >= 3 and sys.argv[2] == "folder"
        )))
        return
    read_only_message_commands = {"status-ui", "conversation-history", "search-messages"}
    engine = FriendsEngine(load_message_journal=command not in read_only_message_commands)
    if len(sys.argv) < 2 or sys.argv[1] == "status":
        print(json.dumps(engine.get_full_status()))
        return

    if command == "conversation-history" and len(sys.argv) >= 4:
        offset = safe_int(sys.argv[4], 0, 0, MAX_CONVERSATION_HISTORY_OFFSET) if len(sys.argv) >= 5 else 0
        limit = safe_int(sys.argv[5], 80, 1, MAX_CONVERSATION_HISTORY_PAGE_SIZE) if len(sys.argv) >= 6 else 80
        print(json.dumps(engine.conversation_history_page(sys.argv[2], sys.argv[3], offset, limit)))
    elif command == "search-messages":
        print(json.dumps(engine.search_messages(" ".join(sys.argv[2:])), ensure_ascii=False))
    elif command == "status-ui":
        print(json.dumps(engine.get_ui_status(), ensure_ascii=False))
    elif command == "safety-code" and len(sys.argv) >= 3:
        try:
            identity = engine._global_identity()
            code = derive_private_safety_code(identity["public_key"], sys.argv[2])
            print(json.dumps({"ok": True, "safety_code": code}))
        except (KeyError, TypeError, ValueError) as error:
            print(json.dumps({"ok": False, "message": str(error) or "Could not derive the safety code"}))
    elif command == "set-status" and len(sys.argv) >= 3:
        print_result(engine.set_status(sys.argv[2]), "Status updated")
    elif command == "set-handle" and len(sys.argv) >= 3:
        print_result(engine.set_handle(" ".join(sys.argv[2:])), "Handle updated")
    elif command == "set-avatar" and len(sys.argv) >= 3:
        print_result(engine.set_avatar(sys.argv[2]), "Avatar updated")
    elif command == "set-project" and len(sys.argv) >= 3:
        name = sys.argv[2]
        desc = sys.argv[3] if len(sys.argv) >= 4 else ""
        url = sys.argv[4] if len(sys.argv) >= 5 else ""
        print_result(engine.set_project(name, desc, url), "Beacon updated")
    elif command == "set-profile":
        ok = engine.set_profile(
            sys.argv[2] if len(sys.argv) >= 3 else "",
            sys.argv[3] if len(sys.argv) >= 4 else "",
            sys.argv[4] if len(sys.argv) >= 5 else "",
            sys.argv[5] if len(sys.argv) >= 6 else "",
        )
        print_result(ok, "Profile saved")
    elif command == "set-interests":
        print_result(engine.set_interests(sys.argv[2:]), "Interests updated")
    elif command == "set-room":
        ok, message = engine.set_room(" ".join(sys.argv[2:]))
        print_result(ok, message)
    elif command == "match-next":
        peer = engine.match_next()
        print(json.dumps({"ok": bool(peer), "peer": peer}))
    elif command == "add-matched":
        ok, message = engine.add_matched_friend()
        print_result(ok, message)
    elif command == "share-rice":
        ok, message = engine.share_rice(sys.argv[2] if len(sys.argv) >= 3 else None)
        print_result(ok, message)
    elif command == "start-cowork":
        minutes = int(sys.argv[2]) if len(sys.argv) >= 3 and sys.argv[2].isdigit() and len(sys.argv[2]) <= 3 else 25
        target = sys.argv[3] if len(sys.argv) >= 4 else None
        ok, message = engine.start_cowork(minutes, target)
        print_result(ok, message)
    elif command == "accept-cowork" and len(sys.argv) >= 3:
        ok, message = engine.accept_cowork(sys.argv[2])
        print_result(ok, message)
    elif command == "dismiss-cowork" and len(sys.argv) >= 3:
        ok, message = engine.dismiss_cowork(sys.argv[2])
        print_result(ok, message)
    elif command == "cancel-cowork":
        ok, message = engine.cancel_cowork()
        print_result(ok, message)
    elif command == "cheer-feed" and len(sys.argv) >= 3:
        ok, message = engine.cheer_feed_item(sys.argv[2])
        print_result(ok, message)
    elif command == "toggle-privacy" and len(sys.argv) >= 3:
        value = engine.toggle_privacy(sys.argv[2])
        print(json.dumps({"ok": value is not None, "value": value}))
    elif command == "add-friend" and len(sys.argv) >= 3:
        handle = sys.argv[3] if len(sys.argv) >= 4 else None
        ok, message = engine.add_friend(sys.argv[2], handle)
        print_result(ok, message)
    elif command == "remove-friend" and len(sys.argv) >= 3:
        ok, message = engine.remove_friend(sys.argv[2])
        print_result(ok, message)
    elif command == "interact" and len(sys.argv) >= 3:
        action = sys.argv[3] if len(sys.argv) >= 4 else "high-five"
        ok, message = engine.interact(sys.argv[2], action)
        print_result(ok, message)
    elif command == "global-refresh":
        ok, message = engine.sync_global()
        print_result(ok, message, global_status=engine.get_full_status().get("global_status", {}))
    elif command == "sync-private-history":
        ok, message, restored, checked, completed = engine.sync_private_history()
        print_result(ok, message, restored_messages=restored, checked_relays=checked, completed_relays=completed)
    elif command == "global-spark":
        ok, message = engine.global_spark()
        print_result(ok, message)
    elif command == "global-focus":
        target = sys.argv[2] if len(sys.argv) >= 3 else None
        ok, message = engine.global_focus_invite(target)
        print_result(ok, message)
    elif command == "accept-global-focus" and len(sys.argv) >= 3:
        ok, message = engine.global_focus_accept(sys.argv[2])
        print_result(ok, message)
    elif command == "cancel-global-focus":
        ok, message = engine.global_focus_cancel()
        print_result(ok, message)
    elif command == "global-ping" and len(sys.argv) >= 3:
        action = sys.argv[3] if len(sys.argv) >= 4 else "hello"
        ok, message = engine.global_ping(sys.argv[2], action)
        print_result(ok, message)
    elif command == "request-friend" and len(sys.argv) >= 3:
        ok, message = engine.request_friend(sys.argv[2])
        print_result(ok, message)
    elif command == "request-friend-direct" and len(sys.argv) >= 3:
        ok, message = engine.request_friend_direct(sys.argv[2])
        print_result(ok, message)
    elif command == "decline-friend" and len(sys.argv) >= 3:
        ok, message = engine.decline_friend_request(sys.argv[2])
        print_result(ok, message)
    elif command == "cancel-friend" and len(sys.argv) >= 3:
        ok, message = engine.cancel_friend_request(sys.argv[2])
        print_result(ok, message)
    elif command == "accept-friend" and len(sys.argv) >= 3:
        ok, message = engine.accept_friend_request(sys.argv[2])
        print_result(ok, message)
    elif command == "send-dm" and len(sys.argv) >= 4:
        raw_message = " ".join(sys.argv[3:])
        message_text = raw_message
        media_url = ""
        message_payload = None
        if len(sys.argv) == 4:
            try:
                message_payload = json.loads(sys.argv[3])
            except (TypeError, ValueError):
                message_payload = None
            if isinstance(message_payload, dict) and ("text" in message_payload or "media_url" in message_payload or "media" in message_payload or "attachment_path" in message_payload or "reply_to" in message_payload):
                message_text = message_payload.get("text", "")
                media_url = message_payload.get("media_url", message_payload.get("media", ""))
        attachment_path = message_payload.get("attachment_path", "") if isinstance(message_payload, dict) else ""
        attachment_is_folder = message_payload.get("attachment_is_folder") is True if isinstance(message_payload, dict) else False
        reply_to = message_payload.get("reply_to") if isinstance(message_payload, dict) else None
        ok, message = engine.send_dm(sys.argv[2], message_text, media_url, attachment_path, attachment_is_folder, reply_to)
        # Use the exact event ID from this invocation. Looking up the most
        # recent outgoing row can return another message when sends overlap.
        message_id = engine.last_sent_message_id
        message_state = next((
            item.get("sendState", "") for item in engine.state.get("global", {}).get("messages", [])
            if item.get("id") == message_id
        ), "") if message_id else ""
        print_result(ok, message, message_id=message_id, send_state=message_state)
    elif command == "create-group" and len(sys.argv) >= 3:
        try:
            payload = json.loads(" ".join(sys.argv[2:]))
        except (TypeError, ValueError):
            payload = {}
        if not isinstance(payload, dict):
            payload = {}
        ok, message = engine.create_group(payload.get("name", ""), payload.get("members", []))
        print_result(ok, message)
    elif command == "send-group" and len(sys.argv) >= 4:
        raw_message = " ".join(sys.argv[3:])
        message_text = raw_message
        media_url = ""
        message_payload = None
        if len(sys.argv) == 4:
            try:
                message_payload = json.loads(sys.argv[3])
            except (TypeError, ValueError):
                message_payload = None
            if isinstance(message_payload, dict):
                message_text = message_payload.get("text", "")
                media_url = message_payload.get("media_url", message_payload.get("media", ""))
        attachment_path = message_payload.get("attachment_path", "") if isinstance(message_payload, dict) else ""
        attachment_is_folder = message_payload.get("attachment_is_folder") is True if isinstance(message_payload, dict) else False
        reply_to = message_payload.get("reply_to") if isinstance(message_payload, dict) else None
        ok, message = engine.send_group_message(sys.argv[2], message_text, media_url, attachment_path, attachment_is_folder, reply_to)
        message_id = engine.last_sent_message_id
        message_state = next((
            item.get("sendState", "") for item in engine.state.get("global", {}).get("messages", [])
            if item.get("id") == message_id
        ), "") if message_id else ""
        print_result(ok, message, message_id=message_id, send_state=message_state)
    elif command == "save-attachment" and len(sys.argv) >= 3:
        index = sys.argv[3] if len(sys.argv) >= 4 else 0
        ok, message = engine.save_attachment(sys.argv[2], index)
        print_result(ok, message)
    elif command == "react-message" and len(sys.argv) >= 6:
        ok, message = engine.react_to_message(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
        print_result(ok, message)
    elif command == "delete-message" and len(sys.argv) >= 3:
        ok, message = engine.delete_message(sys.argv[2])
        print_result(ok, message)
    elif command == "delete-message-for-me" and len(sys.argv) >= 3:
        ok, message = engine.delete_message_for_me(sys.argv[2])
        print_result(ok, message)
    elif command == "retry-message" and len(sys.argv) >= 3:
        ok, message = engine.retry_private_message(sys.argv[2])
        print_result(ok, message)
    elif command == "retry-pending-messages":
        attempted, delivered = engine.retry_pending_private_messages()
        retry_receipts = getattr(engine, "retry_pending_read_receipts", None)
        read_receipts_attempted, read_receipts_published = retry_receipts() if callable(retry_receipts) else (0, 0)
        message = "No private message retries are due" if not attempted and not read_receipts_attempted else f"Retried {attempted} message(s) and {read_receipts_attempted} read receipt conversation(s)"
        print_result(True, message, attempted=attempted, delivered=delivered, read_receipts_attempted=read_receipts_attempted, read_receipts_published=read_receipts_published)
    elif command == "retry-message-action" and len(sys.argv) >= 3:
        ok, message = engine.retry_message_action(sys.argv[2])
        print_result(ok, message)
    elif command == "edit-message" and len(sys.argv) >= 4:
        ok, message = engine.edit_message(sys.argv[2], sys.argv[3])
        print_result(ok, message)
    elif command == "mark-read" and len(sys.argv) >= 4:
        ok, message = engine.mark_conversation_read(sys.argv[2], sys.argv[3])
        print_result(ok, message)
    elif command == "pin-conversation" and len(sys.argv) >= 5:
        ok, message = engine.set_conversation_pinned(
            sys.argv[2], sys.argv[3], sys.argv[4].strip().lower() == "true"
        )
        print_result(ok, message)
    elif command == "mute-conversation" and len(sys.argv) >= 5:
        ok, message = engine.set_conversation_muted(
            sys.argv[2], sys.argv[3], sys.argv[4].strip().lower() == "true"
        )
        print_result(ok, message)
    elif command == "set-blossom-server" and len(sys.argv) >= 3:
        ok, message = engine.set_blossom_server(" ".join(sys.argv[2:]))
        print_result(ok, message)
    elif command == "send-community" and len(sys.argv) >= 3:
        ok, message = engine.send_community_message(" ".join(sys.argv[2:]))
        print_result(ok, message)
    elif command == "block-global" and len(sys.argv) >= 3:
        ok, message = engine.block_global(sys.argv[2])
        print_result(ok, message)
    elif command == "unblock-global" and len(sys.argv) >= 3:
        ok, message = engine.unblock_global(sys.argv[2])
        print_result(ok, message)
    elif command == "poll-events":
        print(json.dumps({"events": engine.pop_events()}))
    elif command == "daemon":
        engine.run_daemon()
    elif command == "dismiss-nudge":
        print_result(engine.dismiss_nudge(), "Noted — enjoy your chats")
    elif command == "listen-global":
        engine.listen_global()
    else:
        print(f"Unknown command: {command}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
