        "wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band",
    ).split(",")
    if item.strip()
)
STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    / "omarchy-friends"
)

