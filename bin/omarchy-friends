        "status_text": "Vibe Coding",
        "status_emoji": "🎧",
        "activity": "Zed (main.go)",
        "music": "Nujabes - Feather",
        "location": "Tokyo",
        "focus_mins": 38,
        "is_ambient": True
    },
    {
        "code": "OMAR-2045-COF",
        "handle": "Marco",
